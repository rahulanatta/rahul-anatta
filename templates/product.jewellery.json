    "faq": {
      "type": "faq-section",
      "blocks": {
        "faq_1": {
          "type": "faq-item",
          "settings": {
            "question": "What materials are your jewellery pieces made from?",
            "answer": "<p>Our jewellery is crafted from ethically sourced 925 sterling silver, 14k and 18k gold, and conflict-free gemstones. Each piece undergoes rigorous quality checks to ensure lasting beauty and durability.</p>",
            "open_by_default": true
          }
        },
        "faq_2": {
          "type": "faq-item",
          "settings": {
            "question": "How should I care for my jewellery?",
            "answer": "<p>Store your pieces in the provided jewellery box when not wearing them. Avoid contact with perfumes, lotions, and harsh chemicals. Clean gently with a soft, lint-free cloth. Remove jewellery before swimming, exercising, or sleeping.</p>",
            "open_by_default": false
          }
        },
        "faq_3": {
          "type": "faq-item",
