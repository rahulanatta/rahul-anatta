<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style brand-directory"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --bd-columns: {{ section.settings.columns_desktop }};
    --bd-columns-mobile: {{ section.settings.columns_mobile }};
    --bd-gap: {{ section.settings.gap }}px;
    --bd-card-radius: {{ section.settings.card_border_radius }}px;
    --bd-margin-block-start: {{ section.settings.margin-block-start }}px;
    --bd-margin-block-end: {{ section.settings.margin-block-end }}px;
  "
>
  {% if section.settings.heading != blank %}
    <{{ section.settings.heading_tag }} class="brand-directory__heading">
      {{ section.settings.heading | escape }}
    </{{ section.settings.heading_tag }}>
  {% endif %}

  <div class="brand-directory__grid">
    {% for block in section.blocks %}
      {% if block.type == 'brand-card' %}
        <{% if block.settings.url != blank %}a href="{{ block.settings.url }}"{% else %}div{% endif %}
          class="brand-directory__card"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            {%- assign sizes_val = '(min-width: 1024px) 25vw, 50vw' -%}
            {{
              block.settings.image
              | image_url: width: block.settings.image.width
              | image_tag:
                widths: '375,550,750',
                sizes: sizes_val,
                loading: 'lazy',
                class: 'brand-directory__card-image',
                alt: block.settings.title
            }}
          {% else %}
            <div class="brand-directory__card-image brand-directory__card-image--placeholder">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <div class="brand-directory__overlay"></div>

          <div class="brand-directory__content">
            {% if block.settings.logo != blank %}
              <img
                src="{{ block.settings.logo | image_url: width: 280 }}"
                alt="{{ block.settings.title | escape }}"
                class="brand-directory__logo"
                loading="lazy"
                width="140"
              >
            {% elsif block.settings.title != blank %}
              <span class="brand-directory__title">{{ block.settings.title | escape }}</span>
            {% endif %}
          </div>
        </{% if block.settings.url != blank %}a{% else %}div{% endif %}>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .brand-directory {
    margin-block-start: var(--bd-margin-block-start, 0px);
    margin-block-end: var(--bd-margin-block-end, 0px);
  }

  .brand-directory__heading {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 32px;
    line-height: 1.1;
    margin: 0 0 24px;
    color: var(--color-foreground);

    @media screen and (min-width: 1024px) {
      font-size: 48px;
      line-height: 53px;
      margin-bottom: 40px;
    }
  }

  .brand-directory__grid {
    display: grid;
    grid-template-columns: repeat(var(--bd-columns-mobile, 2), 1fr);
    gap: var(--bd-gap, 10px);

    @media screen and (min-width: 1024px) {
      grid-template-columns: repeat(var(--bd-columns, 4), 1fr);
    }
  }

  .brand-directory__card {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: var(--bd-card-radius, 14px);
    border: 1px solid #000000;
    overflow: hidden;
    text-decoration: none;
    background-color: #F8F8F8;
    cursor: pointer;
  }

  .brand-directory__card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .brand-directory__card:hover .brand-directory__card-image {
    transform: scale(1.05);
  }

  .brand-directory__card-image--placeholder {
    background: #F8F8F8;
    display: flex;
    align-items: center;
    justify-content: center;

    & svg {
      width: 40%;
      height: 40%;
      opacity: 0.3;
    }
  }

  .brand-directory__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.6) 100%);
    pointer-events: none;
    z-index: 1;
  }

  .brand-directory__content {
    position: absolute;
    bottom: 16px;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-inline: 16px;
  }

  .brand-directory__logo {
    display: block;
    max-width: 140px;
    height: auto;
    filter: brightness(0) invert(1);
  }

  .brand-directory__title {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 1.3;
    color: #FFFFFF;
    text-align: center;

    @media screen and (min-width: 1024px) {
      font-size: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand directory",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Brands"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Margin"
    },
    {
      "type": "range",
      "id": "margin-block-start",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin-block-end",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "brand-card",
      "name": "Brand card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Brand Name"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand directory"
    }
  ]
}
{% endschema %}
