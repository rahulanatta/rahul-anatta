<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style image-table-content"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --itc-min-height: {{ section.settings.min_height }}px;
    --itc-content-max-width: {{ section.settings.content_max_width }}px;
    --itc-heading-font-size: {{ section.settings.heading_font_size }}px;
    --itc-subtitle-font-size: {{ section.settings.subtitle_font_size }}px;
    --itc-table-font-size: {{ section.settings.table_font_size }}px;
    --itc-row-height: {{ section.settings.row_height }}px;
    --itc-heading-to-table-gap: {{ section.settings.heading_to_table_gap }}px;
    --itc-heading-subtitle-gap: {{ section.settings.heading_subtitle_gap }}px;
    --itc-row-border-radius: {{ section.settings.row_border_radius }}px;
  "
>
  <div class="image-table-content__grid{% if section.settings.image_position == 'left' %} image-table-content__grid--image-left{% endif %}">
    <div class="image-table-content__content">
      <div class="image-table-content__content-inner">
        {% if section.settings.heading != blank or section.settings.subtitle != blank %}
          <div class="image-table-content__heading-group">
            {% if section.settings.heading != blank %}
              <h2 class="image-table-content__heading">{{ section.settings.heading | escape }}</h2>
            {% endif %}
            {% if section.settings.subtitle != blank %}
              <p class="image-table-content__subtitle">{{ section.settings.subtitle | escape }}</p>
            {% endif %}
          </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="image-table-content__table">
            {% for block in section.blocks %}
              <div class="image-table-content__row" {{ block.shopify_attributes }}>
                <div class="image-table-content__cell image-table-content__cell--label">
                  {{ block.settings.label | escape }}
                </div>
                <div class="image-table-content__cell image-table-content__cell--value">
                  {{ block.settings.value | escape }}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="image-table-content__image-wrapper">
      {% if section.settings.image != blank %}
        {%- liquid
          assign sizes_val = '(min-width: 1024px) 50vw, 100vw'
        -%}
        {{
          section.settings.image
          | image_url: width: section.settings.image.width
          | image_tag:
            sizes: sizes_val,
            widths: '375,550,750,1100,1500',
            loading: 'lazy',
            class: 'image-table-content__image',
            alt: section.settings.image.alt
        }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'image-table-content__placeholder' }}
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .image-table-content {
    overflow: hidden;
  }

  .image-table-content__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: var(--itc-min-height, 576px);
  }

  .image-table-content__grid--image-left {
    .image-table-content__content {
      order: 2;
    }

    .image-table-content__image-wrapper {
      order: 1;
    }
  }

  .image-table-content__content {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
  }

  .image-table-content__content-inner {
    display: flex;
    flex-direction: column;
    gap: var(--itc-heading-to-table-gap, 48px);
    width: 100%;
    max-width: var(--itc-content-max-width, 577px);
  }

  .image-table-content__heading-group {
    display: flex;
    flex-direction: column;
    gap: var(--itc-heading-subtitle-gap, 12px);
    text-align: center;
    width: 100%;
  }

  .image-table-content__heading {
    font-family: var(--font-body--family);
    font-size: var(--itc-heading-font-size, 32px);
    font-weight: 400;
    line-height: normal;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  .image-table-content__subtitle {
    font-family: var(--font-body--family);
    font-size: var(--itc-subtitle-font-size, 16px);
    font-weight: 400;
    line-height: normal;
    color: var(--color-foreground);
    margin: 0;
  }

  .image-table-content__table {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .image-table-content__row {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: var(--itc-row-height, 48px);

    &:nth-child(odd) {
      background-color: #ffffff;
      border-radius: var(--itc-row-border-radius, 8px);
    }
  }

  .image-table-content__cell {
    font-family: var(--font-body--family);
    font-size: var(--itc-table-font-size, 16px);
    font-weight: 400;
    line-height: 24px;
    letter-spacing: 0.16px;
    color: var(--color-foreground-heading);
  }

  .image-table-content__cell--label {
    flex: 0 0 45%;
    padding-block: 8px;
    padding-inline-start: 16px;
    padding-inline-end: 12px;
  }

  .image-table-content__cell--value {
    flex: 1 1 55%;
    padding-block: 8px;
    padding-inline: 12px;
  }

  .image-table-content__image-wrapper {
    position: relative;
    overflow: hidden;
    min-height: var(--itc-min-height, 576px);
  }

  .image-table-content__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .image-table-content__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  @media screen and (max-width: 1024px) {
    .image-table-content__grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .image-table-content__grid--image-left {
      .image-table-content__content {
        order: 2;
      }

      .image-table-content__image-wrapper {
        order: 1;
      }
    }

    .image-table-content__content {
      order: 2;
      padding: 32px 20px;
    }

    .image-table-content__image-wrapper {
      order: 1;
      position: relative;
      min-height: auto;
      aspect-ratio: 4 / 3;
    }

    .image-table-content__content-inner {
      gap: calc(var(--itc-heading-to-table-gap, 48px) * 0.75);
    }

    .image-table-content__heading {
      font-size: calc(var(--itc-heading-font-size, 32px) * 0.8);
    }

    .image-table-content__cell--label {
      flex: 0 0 40%;
    }

    .image-table-content__cell--value {
      flex: 1 1 60%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image + Table content",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Natural Firming Facial Serum"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A concentrated, plant-based formula designed to support skin"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "number",
      "id": "heading_font_size",
      "label": "Heading font size",
      "default": 32
    },
    {
      "type": "number",
      "id": "subtitle_font_size",
      "label": "Subtitle font size",
      "default": 16
    },
    {
      "type": "number",
      "id": "table_font_size",
      "label": "Table font size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "number",
      "id": "content_max_width",
      "label": "Content max width",
      "default": 577
    },
    {
      "type": "number",
      "id": "min_height",
      "label": "Min height",
      "default": 576
    },
    {
      "type": "number",
      "id": "row_height",
      "label": "Row height",
      "default": 48
    },
    {
      "type": "number",
      "id": "heading_to_table_gap",
      "label": "Heading to table gap",
      "default": 48
    },
    {
      "type": "number",
      "id": "heading_subtitle_gap",
      "label": "Heading subtitle gap",
      "default": 12
    },
    {
      "type": "number",
      "id": "row_border_radius",
      "label": "Row border radius",
      "default": 8
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-8"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Left padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Right padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "table-row",
      "name": "Table row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image + Table content",
      "blocks": [
        {
          "type": "table-row",
          "settings": {
            "label": "Skin benefits:",
            "value": "Firming, smoothin, regenerating"
          }
        },
        {
          "type": "table-row",
          "settings": {
            "label": "Skin type:",
            "value": "Norma, dry, mature"
          }
        },
        {
          "type": "table-row",
          "settings": {
            "label": "Texture:",
            "value": "Lighweight, oil based"
          }
        },
        {
          "type": "table-row",
          "settings": {
            "label": "Scent",
            "value": "Subtle, natural"
          }
        },
        {
          "type": "table-row",
          "settings": {
            "label": "When to use:",
            "value": "Morning and evening"
          }
        }
      ]
    }
  ]
}
{% endschema %}
