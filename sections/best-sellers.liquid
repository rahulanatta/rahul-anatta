{% liquid
  assign collection = section.settings.collection
  assign heading = section.settings.heading
  assign shop_all_label = section.settings.shop_all_label
  assign shop_all_url = section.settings.shop_all_url
  assign max_products = section.settings.max_products | default: 8
%}

<div
  id="section-{{ section.id }}"
  class="best-sellers color-{{ section.settings.color_scheme }}"
  style="
    --bs-padding-top: {{ section.settings.padding-block-start }}px;
    --bs-padding-bottom: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="best-sellers__container page-width">
    <div class="best-sellers__header">
      <h2 class="best-sellers__heading">{{ heading }}</h2>
      {% if shop_all_url != blank %}
        <a href="{{ shop_all_url }}" class="best-sellers__shop-all">
          {{ shop_all_label }}
        </a>
      {% elsif collection %}
        <a href="{{ collection.url }}" class="best-sellers__shop-all">
          {{ shop_all_label }}
        </a>
      {% endif %}
    </div>

    {% if collection and collection.products.size > 0 %}
      <best-sellers-carousel class="best-sellers__carousel-wrapper">
        <div class="best-sellers__track" ref="track">
          {% for product in collection.products limit: max_products %}
            {% render 'best-sellers-card',
              product: product,
              section_id: section.id,
              show_vendor: section.settings.show_vendor,
              show_reviews: section.settings.show_reviews,
              show_cashback: section.settings.show_cashback,
              show_subscribe_button: section.settings.show_subscribe_button,
              subscribe_label: section.settings.subscribe_label,
              subscribe_icon: section.settings.subscribe_icon,
              subscribe_url: product.url
            %}
          {% endfor %}
        </div>

        <div class="best-sellers__nav">
          <button
            type="button"
            class="best-sellers__nav-btn best-sellers__nav-btn--prev"
            ref="prevButton"
            aria-label="{{ 'accessibility.slideshow_previous' | t }}"
            on:click="/handlePrev"
            disabled
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="best-sellers__nav-btn best-sellers__nav-btn--next"
            ref="nextButton"
            aria-label="{{ 'accessibility.slideshow_next' | t }}"
            on:click="/handleNext"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </best-sellers-carousel>
    {% else %}
      <p class="best-sellers__empty">{{ 'content.no_products_found' | t }}</p>
    {% endif %}
  </div>
</div>

<script src="{{ 'best-sellers.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .best-sellers {
    padding-block-start: var(--bs-padding-top, 48px);
    padding-block-end: var(--bs-padding-bottom, 48px);
  }

  .best-sellers__container {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .best-sellers__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-inline: 4px;
  }

  .best-sellers__heading {
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xl);
    font-weight: 400;
    line-height: 26px;
    letter-spacing: 0;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  .best-sellers__shop-all {
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    font-weight: 300;
    line-height: 18px;
    text-decoration: underline;
    color: rgb(var(--color-foreground));
  }

  .best-sellers__shop-all:hover {
    opacity: 0.7;
  }

  /* Carousel */
  .best-sellers__carousel-wrapper {
    position: relative;
    display: block;
  }

  .best-sellers__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-block-end: 16px;
  }

  .best-sellers__track::-webkit-scrollbar {
    display: none;
  }

  .best-sellers__nav {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .best-sellers__nav {
      display: flex;
      gap: 8px;
      position: absolute;
      inset-block-start: -44px;
      inset-inline-end: 60px;
    }
  }

  .best-sellers__nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-foreground) / 0.15);
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .best-sellers__nav-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .best-sellers__nav-btn:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  .best-sellers__empty {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground));
  }

  /* Product Card */
  .bs-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 161px;
    max-width: 161px;
    border-radius: 16px;
    border: 1px solid #E6E6E6;
    background-color: rgb(var(--color-background));
    scroll-snap-align: start;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .bs-card {
      min-width: 237px;
      max-width: 237px;
    }
  }

  .bs-card__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Image */
  .bs-card__image-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 36px;
    border-radius: 16px 16px 0 0;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .bs-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .bs-card__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bs-card__placeholder-svg {
    width: 100%;
    height: auto;
  }

  /* Content area */
  .bs-card__content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    padding: 16px 16px 20px 11px;
  }

  @media screen and (min-width: 750px) {
    .bs-card__content {
      padding: 17px 16px 20px 16px;
    }
  }

  .bs-card__info {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Vendor */
  .bs-card__vendor {
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xs);
    font-weight: 400;
    line-height: 16px;
    color: #141414;
    margin: 0;
    display: none;
  }

  @media screen and (min-width: 750px) {
    .bs-card__vendor {
      display: block;
    }
  }

  /* Title */
  .bs-card__title {
    margin: 0;
  }

  .bs-card__title-link {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    font-weight: 500;
    line-height: 18px;
    color: #141414;
    text-decoration: none;
    position: relative;
    z-index: 2;
  }

  .bs-card__title-link:hover {
    text-decoration: underline;
  }

  @media screen and (min-width: 750px) {
    .bs-card__title-link {
      font-size: var(--font-size--xl);
      font-weight: 400;
      line-height: 26px;
    }
  }

  /* Reviews */
  .bs-card__reviews {
    display: none;
    align-items: center;
    gap: 4px;
  }

  @media screen and (min-width: 750px) {
    .bs-card__reviews {
      display: flex;
    }
  }

  .bs-card__stars {
    display: block;
    width: 68px;
    height: 12px;
  }

  .bs-card__reviews-text {
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xs);
    font-weight: 400;
    line-height: 16px;
    color: #141414;
  }

  /* Variant picker — mobile only */
  .bs-card__variants {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  @media screen and (min-width: 750px) {
    .bs-card__variants {
      display: none;
    }
  }

  .bs-card__variants-label {
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 400;
    line-height: 16px;
    color: #141414;
    margin: 0;
  }

  .bs-card__variants-list {
    display: flex;
    gap: 6px;
    position: relative;
    z-index: 2;
  }

  .bs-card__size-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border-radius: 12px;
    border: 1px solid #D3D3D3;
    background: transparent;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    font-weight: 400;
    line-height: 18px;
    color: #000000;
    cursor: pointer;
    position: relative;
    z-index: 2;
    min-width: 40px;
  }

  .bs-card__size-btn--selected {
    border-color: #000000;
  }

  .bs-card__size-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .bs-card__size-btn:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  /* Price */
  .bs-card__price-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .bs-card__price-wrapper {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .bs-card__price {
    font-family: var(--font-body--family);
    font-size: var(--font-size--lg);
    font-weight: 500;
    line-height: 23px;
    color: #000000;
  }

  .bs-card__compare-price {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    font-weight: 300;
    line-height: 16px;
    text-decoration: line-through;
    color: #6C6C6C;
  }

  /* Cashback */
  .bs-card__cashback {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .bs-card__cashback-percent {
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xs);
    font-weight: 400;
    line-height: 16px;
    color: #141414;
  }

  .bs-card__cashback-icon {
    width: 12px;
    height: 12px;
  }

  .bs-card__cashback-label {
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xs);
    font-weight: 400;
    line-height: 16px;
    color: #141414;
  }

  /* Actions */
  .bs-card__actions {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-block-start: 7px;
    position: relative;
    z-index: 2;
  }

  .bs-card__add-form {
    display: contents;
  }

  .bs-card__add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border-radius: 12px;
    border: 1px solid #D3D3D3;
    background: transparent;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    font-weight: 400;
    line-height: 18px;
    color: #000000;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }

  /* Mobile: full-width add button with smaller border-radius */
  @media screen and (max-width: 749px) {
    .bs-card__actions {
      justify-content: center;
      padding: 7px 0;
    }

    .bs-card__add-btn {
      width: 100%;
      max-width: 147px;
      border-radius: 9px;
      padding: 5px 24px;
      text-align: center;
    }
  }

  .bs-card__add-btn:hover {
    background-color: #f5f5f5;
  }

  .bs-card__add-btn:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  .bs-card__add-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .bs-card__subscribe-btn {
    display: none;
    align-items: center;
    gap: 4px;
    padding: 12px 8px 12px 5px;
    border-radius: 12px;
    border: 1px solid #D3D3D3;
    background: transparent;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    font-weight: 400;
    line-height: 18px;
    color: #000000;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  @media screen and (min-width: 750px) {
    .bs-card__subscribe-btn {
      display: flex;
    }
  }

  .bs-card__subscribe-btn:hover {
    background-color: #f5f5f5;
  }

  .bs-card__subscribe-btn:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  .bs-card__subscribe-icon {
    width: 20px;
    height: 19px;
  }

  @media (prefers-reduced-motion: reduce) {
    .best-sellers__track {
      scroll-behavior: auto;
    }

    .bs-card__add-btn,
    .bs-card__subscribe-btn,
    .best-sellers__nav-btn {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.best_sellers",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop all label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "shop_all_url",
      "label": "Shop all link"
    },
    {
      "type": "header",
      "content": "Card options"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show reviews",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cashback",
      "label": "Show cashback",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_subscribe_button",
      "label": "Show subscribe button",
      "default": true
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Subscribe label",
      "default": "Subscribe"
    },
    {
      "type": "image_picker",
      "id": "subscribe_icon",
      "label": "Subscribe icon"
    },
    {
      "type": "number",
      "id": "max_products",
      "label": "Max products",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:names.best_sellers"
    }
  ]
}
{% endschema %}
