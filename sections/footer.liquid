<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
>
  <div
    class="footer-content spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .footer-content {
    contain: content;
    content-visibility: auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: stretch;
  }

  /* Nav column headings — uppercase bold per design */
  .footer-content .menu__heading__default {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 14px;
    line-height: 1.3;
    color: var(--color-foreground);
  }

  /* Social icons — 40×40 rounded squares with light bg */
  .footer-content .social-icons__icon-wrapper {
    width: 40px;
    height: 40px;
    background-color: #f7f7f7;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .footer-content .social-icons__icon-wrapper a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--color-foreground);
  }

  .footer-content .social-icons__icon {
    width: 16px;
    height: 16px;
  }

  .footer-content .social-icons__wrapper {
    gap: 12px;
    justify-content: flex-start;
    flex-wrap: nowrap;
  }

  /* Email signup styling */
  .footer-content .email-signup__input-group {
    border-color: rgba(33, 30, 36, 0.15) !important;
    background-color: #fff;
  }

  /* Logo — hidden on desktop, visible on mobile inside connect group */
  .footer-connect-logo {
    display: none;
    justify-content: center;
    width: 100%;
    padding-block-end: 8px;
  }

  /* CONNECT heading — visible on desktop only */
  .footer-connect-heading {
    display: block;
  }

  @media screen and (max-width: 749px) {
    /* Mobile: stack nav group then connect group */
    .footer-content {
      gap: 24px;
    }

    /* Connect group: center-aligned on mobile */
    .footer-content > .group-block:last-child .group-block-content {
      align-items: center;
      text-align: center;
    }

    .footer-content > .group-block:last-child .social-icons__wrapper {
      justify-content: center;
    }

    /* Show logo on mobile */
    .footer-connect-logo {
      display: flex;
    }

    /* Hide CONNECT heading on mobile */
    .footer-connect-heading {
      display: none;
    }

    /* Email input centered on mobile */
    .footer-content > .group-block:last-child .email-signup-block {
      width: 100%;
    }
  }

  @media screen and (min-width: 750px) {
    .footer-content {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 60px;
    }

    /* Nav group — takes all available space */
    .footer-content > .group-block:first-child {
      flex: 1;
      min-width: 0;
    }

    /* Connect group — right side, fixed width */
    .footer-content > .group-block:last-child {
      flex-shrink: 0;
      width: 295px;
    }

    /* Nav group: menus side-by-side */
    .footer-content > .group-block:first-child .layout-panel-flex--row {
      gap: 40px;
      flex-wrap: wrap;
    }

    /* Each menu column at equal width */
    .footer-content > .group-block:first-child .menu {
      min-width: 100px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    { "type": "_divider" },
    { "type": "@app" },
    { "type": "button" },
    { "type": "follow-on-shop" },
    { "type": "group" },
    { "type": "icon" },
    { "type": "image" },
    { "type": "menu" },
    { "type": "payment-icons" },
    { "type": "text" },
    { "type": "logo" },
    { "type": "jumbo-text" },
    { "type": "social-links" },
    { "type": "email-signup" }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
