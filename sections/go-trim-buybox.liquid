<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign compare_at_price = current_variant.compare_at_price
  assign price = current_variant.price

  assign has_selling_plans = false
  if product.selling_plan_groups.size > 0
    assign has_selling_plans = true
    assign first_group = product.selling_plan_groups[0]
    assign first_plan = first_group.selling_plans[0]
    assign first_allocation = current_variant.selling_plan_allocations | where: 'selling_plan_id', first_plan.id | first
  endif
%}

<go-trim-buybox-component>
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style go-trim-buybox"
    style="{%- render 'spacing-style', settings: section.settings -%} --buybox-gap: {{ section.settings.gap }}px; --media-gap: {{ section.settings.media_gap }}px; --media-radius: {{ section.settings.media_border_radius }}px;"
  >

    {%- comment -%} Left column: Product media grid {%- endcomment -%}
    <div class="go-trim-buybox__media">
      {% assign zoom_image_index = 0 %}
      {% for media in product.media %}
        <div class="go-trim-buybox__media-item"
          {% if media.media_type == 'image' %}data-media-index="{{ zoom_image_index }}"{% endif %}
          {%- for variant in product.variants -%}
            {%- if variant.featured_media.id == media.id -%}
              {{ ' ' }}data-variant-id="{{ variant.id }}"
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        >
          {% if media.media_type == 'image' %}
            {%- assign sizes_val = '(min-width: 750px) 400px, calc(50vw - 20px)' -%}
            {{
              media
              | image_url: width: media.width
              | image_tag:
                sizes: sizes_val,
                widths: '200,300,400,500,600,800',
                loading: 'lazy',
                class: 'go-trim-buybox__media-img',
                alt: media.alt
            }}
          {% endif %}
        </div>
        {% if media.media_type == 'image' %}
          {% assign zoom_image_index = zoom_image_index | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>

    {%- comment -%} Right column: Buy box details {%- endcomment -%}
    <div class="go-trim-buybox__details">

      {%- comment -%} Product title {%- endcomment -%}
      <h1 class="go-trim-buybox__title">{{ product.title | escape }}</h1>

      {%- comment -%} Star reviews {%- endcomment -%}
      {% if section.settings.show_reviews %}
        <div class="go-trim-buybox__reviews">
          <img
            src="{{ 'stars.svg' | asset_url }}"
            alt="Star rating"
            width="78"
            height="14"
            loading="lazy"
          >
          <span class="go-trim-buybox__reviews-text">{{ section.settings.reviews_text }}</span>
        </div>
      {% endif %}

      {%- comment -%} Price row {%- endcomment -%}
      <div class="go-trim-buybox__price-row">
        <div class="go-trim-buybox__price-info">
          <div class="go-trim-buybox__price-main">
            <span class="go-trim-buybox__price" data-active-price>{{ price | money }}</span>
            <span class="go-trim-buybox__compare-price" data-compare-price{% unless compare_at_price > price %} style="display: none;"{% endunless %}>
              <s>{% if compare_at_price %}{{ compare_at_price | money }}{% endif %}</s>
            </span>
          </div>

          {%- comment -%} Installments {%- endcomment -%}
          {% if section.settings.show_installments %}
            <div class="go-trim-buybox__installments">
              {% liquid
                assign installment_price = price | divided_by: 4
              %}
              <span>or 4 payments of {{ installment_price | money }} with</span>
              <img
                src="{{ 'image-82-desktop-120115871.png' | asset_url }}"
                alt="Afterpay"
                width="59"
                height="15"
                loading="lazy"
                class="go-trim-buybox__afterpay-logo"
              >
              <span class="go-trim-buybox__info-icon">
                {{ 'info-circle.svg' | inline_asset_content }}
              </span>
            </div>
          {% endif %}
        </div>

        {% if section.settings.show_wishlist %}
          <button type="button" class="go-trim-buybox__wishlist" aria-label="Add to wishlist">
            {{ 'heart.svg' | inline_asset_content }}
          </button>
        {% endif %}
      </div>

      {%- comment -%} Subtitle {%- endcomment -%}
      {%- assign buybox_subtitle = product.metafields.custom.product_short_description.value | default: section.settings.subtitle -%}
      {% if buybox_subtitle != blank %}
        <p class="go-trim-buybox__subtitle">{{ buybox_subtitle }}</p>
      {% endif %}

      {%- comment -%} Variant picker {%- endcomment -%}
      {% if product.variants.size > 1 %}
        <div class="go-trim-buybox__variants">
          {% for variant in product.variants %}
            {%- assign variant_image = variant.featured_image | default: product.featured_image -%}
            <button type="button"
              class="go-trim-buybox__variant-card{% if variant.id == current_variant.id %} is-selected{% endif %}"
              data-variant-id="{{ variant.id }}"
            >
              {% if variant_image %}
                <img
                  src="{{ variant_image | image_url: width: 160 }}"
                  alt="{{ variant.title | escape }}"
                  width="72"
                  height="72"
                  loading="lazy"
                  class="go-trim-buybox__variant-img"
                >
              {% endif %}
              <span class="go-trim-buybox__variant-name">{{ variant.title | escape }}</span>
            </button>
          {% endfor %}
        </div>
      {% endif %}

      {%- comment -%} Purchase options + form {%- endcomment -%}
      <product-form-component
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
      >
        <form method="post" action="/cart/add" accept-charset="UTF-8" enctype="multipart/form-data">
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" value="{{ current_variant.id }}" ref="variantId">
          {% if has_selling_plans %}
            <input type="hidden" name="selling_plan" value="{{ first_plan.id }}">

            <div class="go-trim-buybox__purchase-options">
              {%- comment -%} One-time purchase card {%- endcomment -%}
              <label class="go-trim-buybox__option-card" data-option="onetime">
                <input
                  type="radio"
                  name="purchase_option"
                  value="onetime"
                  class="go-trim-buybox__radio-input"
                >
                <span class="go-trim-buybox__option-header">
                  <span class="go-trim-buybox__option-title">One-time purchase</span>
                  <span class="go-trim-buybox__option-price">{{ price | money }}</span>
                </span>
              </label>

              {%- comment -%} Subscription card {%- endcomment -%}
              <label class="go-trim-buybox__option-card go-trim-buybox__option-card--subscription is-selected" data-option="subscription">
                <input
                  type="radio"
                  name="purchase_option"
                  value="subscription"
                  checked
                  class="go-trim-buybox__radio-input"
                >
                <span class="go-trim-buybox__option-header">
                  <span class="go-trim-buybox__option-title-wrap">
                    <span class="go-trim-buybox__option-title">Monthly Delivery</span>
                    <span class="go-trim-buybox__best-value-badge">Best value</span>
                  </span>
                  {% if first_allocation %}
                    <span class="go-trim-buybox__option-price">{{ first_allocation.per_delivery_price | money }}</span>
                  {% endif %}
                </span>
              </label>
            </div>
          {% endif %}

          {%- comment -%} Quantity + CTA row {%- endcomment -%}
          <div class="go-trim-buybox__actions">
            <div class="go-trim-buybox__quantity">
              <button type="button" class="go-trim-buybox__qty-btn" data-action="quantity-minus" aria-label="Decrease quantity">-</button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                data-quantity-input
                class="go-trim-buybox__qty-input"
                aria-label="Quantity"
              >
              <button type="button" class="go-trim-buybox__qty-btn" data-action="quantity-plus" aria-label="Increase quantity">+</button>
            </div>

            <button type="submit" class="go-trim-buybox__cta-btn">
              <span data-cta-text>{% if has_selling_plans %}Subscribe{% else %}Add to Cart{% endif %}</span>
            </button>
          </div>

          <div ref="liveRegion" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
        </form>
      </product-form-component>

      {%- comment -%} Accordion section {%- endcomment -%}
      {% assign accordion_blocks = section.blocks | where: 'type', 'accordion-item' %}
      {% if accordion_blocks.size > 0 %}
        <div class="go-trim-buybox__accordions">
          {% for block in accordion_blocks %}
            <details
              class="go-trim-buybox__accordion"
              {{ block.shopify_attributes }}
              {% if block.settings.open_by_default %}open{% endif %}
            >
              <summary class="go-trim-buybox__accordion-summary">
                <span class="go-trim-buybox__accordion-title">{{ block.settings.title }}</span>
                <span class="go-trim-buybox__accordion-icon go-trim-buybox__accordion-icon--open">
                  {{ 'chevron-up.svg' | inline_asset_content }}
                </span>
                <span class="go-trim-buybox__accordion-icon go-trim-buybox__accordion-icon--closed">
                  {{ 'chevron-down.svg' | inline_asset_content }}
                </span>
              </summary>
              <div class="go-trim-buybox__accordion-content">
                {%- if block.settings.metafield_key != blank -%}
                  {%- assign mf_parts = block.settings.metafield_key | split: '.' -%}
                  {%- assign mf_ns = mf_parts[0] -%}
                  {%- assign mf_key = mf_parts[1] -%}
                  {%- assign mf = product.metafields[mf_ns][mf_key] -%}
                  {%- if mf != blank -%}
                    {{ mf | metafield_tag }}
                  {%- else -%}
                    {{ block.settings.content }}
                  {%- endif -%}
                {%- else -%}
                  {{ block.settings.content }}
                {%- endif -%}
              </div>
            </details>
          {% endfor %}
        </div>
      {% endif %}

      {%- comment -%} Subscription benefits box {%- endcomment -%}
      {% assign benefit_blocks = section.blocks | where: 'type', 'benefit-item' %}
      {% if has_selling_plans and section.settings.show_subscription_benefits and benefit_blocks.size > 0 %}
        <div class="go-trim-buybox__benefits-box">
          {% if section.settings.subscription_benefits_heading != blank %}
            <h3 class="go-trim-buybox__benefits-heading">{{ section.settings.subscription_benefits_heading }}</h3>
          {% endif %}
          <div class="go-trim-buybox__benefits-list">
            {% for block in benefit_blocks %}
              <div class="go-trim-buybox__benefit-row" {{ block.shopify_attributes }}>
                {% if block.settings.icon != blank %}
                  <img
                    src="{{ block.settings.icon | image_url: width: 40 }}"
                    alt=""
                    width="20"
                    height="20"
                    loading="lazy"
                    class="go-trim-buybox__benefit-icon"
                  >
                {% endif %}
                <span class="go-trim-buybox__benefit-text">{{ block.settings.text }}</span>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {%- comment -%} Supplement label button (opens drawer) {%- endcomment -%}
      {% if section.settings.supplement_label_text != blank %}
        <button
          type="button"
          data-action="open-supplement-drawer"
          class="go-trim-buybox__supplement-link"
        >
          {{ section.settings.supplement_label_text }}
        </button>
      {% endif %}

      {%- comment -%} Supplement facts drawer {%- endcomment -%}
      <dialog class="go-trim-buybox__supplement-drawer" aria-labelledby="supplement-drawer-title-{{ section.id }}">
        <div class="go-trim-buybox__supplement-drawer-header">
          <h2 id="supplement-drawer-title-{{ section.id }}" class="go-trim-buybox__supplement-drawer-title">Supplement Facts</h2>
          <button type="button" data-action="close-supplement-drawer" class="go-trim-buybox__supplement-drawer-close" aria-label="Close">
            {{ 'x.svg' | inline_asset_content }}
          </button>
        </div>
        <div class="go-trim-buybox__supplement-drawer-content">
          {%- if product.metafields.custom.supplement_facts.value != blank -%}
            {{
              product.metafields.custom.supplement_facts.value
              | image_url: width: 664
              | image_tag:
                class: 'go-trim-buybox__supplement-image',
                alt: product.title,
                loading: 'lazy'
            }}
          {%- else -%}
            <p class="go-trim-buybox__supplement-empty">No supplement facts available.</p>
          {%- endif -%}
        </div>
      </dialog>

    </div>
  </div>

  {%- comment -%} Zoom image dialog {%- endcomment -%}
  <dialog class="go-trim-buybox__zoom-dialog" aria-label="Image zoom">
    <div class="go-trim-buybox__zoom-content">
      <button type="button" data-action="close-zoom-dialog" class="go-trim-buybox__zoom-close" aria-label="Close zoom">
        {{ 'x.svg' | inline_asset_content }}
      </button>
      <div class="go-trim-buybox__zoom-main">
        <button type="button" data-action="zoom-prev" class="go-trim-buybox__zoom-arrow go-trim-buybox__zoom-arrow--prev" aria-label="Previous image">
          {{ 'frame-1618873316.svg' | inline_asset_content }}
        </button>
        <div class="go-trim-buybox__zoom-image-container">
          <img src="" alt="" class="go-trim-buybox__zoom-image" data-zoom-image>
        </div>
        <button type="button" data-action="zoom-next" class="go-trim-buybox__zoom-arrow go-trim-buybox__zoom-arrow--next" aria-label="Next image">
          {{ 'frame-1618873317.svg' | inline_asset_content }}
        </button>
      </div>
      <div class="go-trim-buybox__zoom-thumbnails">
        {% assign zoom_thumb_index = 0 %}
        {% for media in product.media %}
          {% if media.media_type == 'image' %}
            <button type="button"
              class="go-trim-buybox__zoom-thumb"
              data-action="select-zoom-thumb"
              data-zoom-index="{{ zoom_thumb_index }}"
              aria-label="View image {{ zoom_thumb_index | plus: 1 }}"
            >
              <img
                src="{{ media | image_url: width: 160 }}"
                alt="{{ media.alt | escape }}"
                width="80"
                height="80"
                loading="lazy"
                class="go-trim-buybox__zoom-thumb-img"
              >
            </button>
            {% assign zoom_thumb_index = zoom_thumb_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </dialog>

  {%- comment -%} Variant data for JS {%- endcomment -%}
  <script type="application/json" data-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "title": {{ variant.title | json }},
          "available": {{ variant.available }},
          "price_formatted": {{ variant.price | money | strip_html | json }},
          "price_raw": {{ variant.price }},
          "compare_at_price_formatted": {% if variant.compare_at_price %}{{ variant.compare_at_price | money | strip_html | json }}{% else %}null{% endif %},
          "compare_at_price_raw": {{ variant.compare_at_price | default: 0 }},
          "featured_image": {
            "src": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 800 | json }}{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %},
            "alt": {% if variant.featured_image %}{{ variant.featured_image.alt | default: '' | json }}{% else %}{{ product.featured_image.alt | default: '' | json }}{% endif %}
          },
          "featured_media_id": {% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}null{% endif %},
          "selling_plan_allocations": [
            {%- for alloc in variant.selling_plan_allocations -%}
              {
                "selling_plan_id": {{ alloc.selling_plan_id }},
                "per_delivery_price_formatted": {{ alloc.per_delivery_price | money | strip_html | json }},
                "per_delivery_price_raw": {{ alloc.per_delivery_price }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>

  {%- comment -%} Selling plan data for JS {%- endcomment -%}
  {% if has_selling_plans %}
    <script type="application/json" data-selling-plans>
      {
        "default_plan_id": "{{ first_plan.id }}",
        "onetime_price_formatted": "{{ price | money | strip_html }}",
        "subscription_price_formatted": "{% if first_allocation %}{{ first_allocation.per_delivery_price | money | strip_html }}{% else %}{{ price | money | strip_html }}{% endif %}",
        "plans": [
          {%- for plan in first_group.selling_plans -%}
            {
              "id": "{{ plan.id }}",
              "name": "{{ plan.name | escape }}"
              {%- assign alloc = current_variant.selling_plan_allocations | where: 'selling_plan_id', plan.id | first -%}
              {%- if alloc -%}
                ,"price_formatted": "{{ alloc.per_delivery_price | money | strip_html }}"
              {%- endif -%}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {% endif %}
</go-trim-buybox-component>

<script src="{{ 'go-trim-buybox.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .go-trim-buybox {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--buybox-gap, 64px);
    align-items: start;

    @media screen and (min-width: 750px) {
      grid-template-columns: 1.42fr 1fr;
    }
  }

  /* Media grid — grid-column:auto overrides .section--page-width > * { grid-column: 2 } */
  .go-trim-buybox__media {
    grid-column: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--media-gap, 8px);

    @media screen and (min-width: 750px) {
      position: sticky;
      top: var(--sticky-header-offset, 0);
      align-self: start;
      max-height: 100vh;
      overflow-y: auto;
      scroll-behavior: smooth;
      -ms-overflow-style: none;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }
    }
  }

  .go-trim-buybox__media-item {
    overflow: hidden;
    border-radius: var(--media-radius, 16px);
  }

  .go-trim-buybox__media-item[data-media-index] {
    cursor: pointer;
  }

  .go-trim-buybox__media-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  /* Details column — grid-column:auto overrides .section--page-width > * { grid-column: 2 } */
  .go-trim-buybox__details {
    grid-column: auto;
    display: flex;
    flex-direction: column;
    gap: 35px;
  }

  /* Title */
  .go-trim-buybox__title {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 32px;
    line-height: 48px;
    margin: 0;
    color: var(--color-foreground);
  }

  /* Reviews */
  .go-trim-buybox__reviews {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .go-trim-buybox__reviews img {
    width: 78px;
    height: 14px;
    flex-shrink: 0;
  }

  .go-trim-buybox__reviews-text {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 16px;
    color: var(--color-foreground);
  }

  /* Price row */
  .go-trim-buybox__price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .go-trim-buybox__price-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .go-trim-buybox__price-main {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .go-trim-buybox__price {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 24px;
    line-height: 31px;
    color: var(--color-foreground);
  }

  .go-trim-buybox__compare-price {
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 16px;
    line-height: 16px;
    color: #6C6C6C;

    s {
      text-decoration: line-through;
    }
  }

  /* Installments */
  .go-trim-buybox__installments {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 14px;
    line-height: 19px;
    color: var(--color-foreground);
  }

  .go-trim-buybox__afterpay-logo {
    display: inline-block;
    vertical-align: middle;
  }

  .go-trim-buybox__info-icon {
    display: inline-flex;
    align-items: center;
    width: 16px;
    height: 16px;

    svg {
      width: 16px;
      height: 16px;
    }
  }

  /* Wishlist button */
  .go-trim-buybox__wishlist {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    background: none;
    padding: 0;
    cursor: pointer;
    border-radius: 50%;
    flex-shrink: 0;

    svg {
      width: 32px;
      height: 32px;
    }

    &:focus-visible {
      outline: 2px solid var(--color-foreground);
      outline-offset: 2px;
    }
  }

  /* Subtitle */
  .go-trim-buybox__subtitle {
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 16px;
    line-height: 19px;
    color: #000000;
    margin: 0;
  }

  /* Variant picker */
  .go-trim-buybox__variants {
    display: flex;
    flex-direction: row;
    gap: 12px;
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .go-trim-buybox__variant-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    border: 1px solid #C8C8C8;
    border-radius: 12px;
    padding: 8px;
    cursor: pointer;
    flex-shrink: 0;
    min-width: 90px;
    background: none;
    transition: border-color 0.15s ease;

    &.is-selected {
      border-color: #616161;
    }

    &:focus-visible {
      outline: 2px solid var(--color-foreground);
      outline-offset: 2px;
    }
  }

  .go-trim-buybox__variant-img {
    width: 72px;
    height: 72px;
    border-radius: 8px;
    object-fit: cover;
  }

  .go-trim-buybox__variant-name {
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 17px;
    text-align: center;
    color: var(--color-foreground);
  }

  /* Purchase options */
  .go-trim-buybox__purchase-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-block: 24px;
  }

  .go-trim-buybox__option-card {
    display: block;
    position: relative;
    border: 1px solid #C8C8C8;
    border-radius: 20px;
    padding: 16px 20px;
    cursor: pointer;
    transition: border-color 0.15s ease;

    &.is-selected {
      border-color: #616161;
    }
  }

  .go-trim-buybox__radio-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .go-trim-buybox__option-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .go-trim-buybox__option-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .go-trim-buybox__option-title {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 18px;
    line-height: 29px;
    color: #000000;
  }

  .go-trim-buybox__option-price {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 20px;
    line-height: 29px;
    text-align: end;
    color: #000000;
  }

  /* Best value badge */
  .go-trim-buybox__best-value-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #E3FCB8;
    border-radius: 4px;
    padding: 2px 10px;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 13px;
    line-height: 17px;
    color: #000000;
  }

  /* Actions row */
  .go-trim-buybox__actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .go-trim-buybox__quantity {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border: 1px solid #ACACAC;
    border-radius: 12px;
    padding: 6px 16px;
    height: 46px;
    flex-shrink: 0;
    min-width: 110px;
  }

  .go-trim-buybox__qty-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 24px;
    line-height: 1;
    color: #141414;
    cursor: pointer;

    &:focus-visible {
      outline: 2px solid var(--color-foreground);
      outline-offset: 2px;
    }
  }

  .go-trim-buybox__qty-input {
    width: 30px;
    text-align: center;
    border: none;
    background: none;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 18px;
    line-height: 23px;
    color: #141414;
    -moz-appearance: textfield;
    appearance: textfield;

    &::-webkit-outer-spin-button,
    &::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
  }

  .go-trim-buybox__cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    height: 45px;
    border-radius: 12px;
    background-color: #141414;
    color: #ffffff;
    border: none;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 18px;
    line-height: 23px;
    cursor: pointer;
    transition: background-color 0.15s ease;

    &:hover {
      background-color: #333333;
    }

    &:focus-visible {
      outline: 2px solid var(--color-foreground);
      outline-offset: 2px;
    }
  }

  /* Accordions */
  .go-trim-buybox__accordions {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .go-trim-buybox__accordion {
    border-bottom: 1px solid #DFDFDF;
    padding-block-end: 20px;

    &[open] {
      padding-block-start: 20px;
    }

    &[open] .go-trim-buybox__accordion-icon--open {
      display: inline-flex;
    }

    &[open] .go-trim-buybox__accordion-icon--closed {
      display: none;
    }
  }

  .go-trim-buybox__accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    gap: 16px;

    &::-webkit-details-marker {
      display: none;
    }

    &::marker {
      display: none;
      content: '';
    }
  }

  .go-trim-buybox__accordion-title {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 18px;
    line-height: 23px;
    color: var(--color-foreground);
  }

  .go-trim-buybox__accordion-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;

    svg {
      width: 24px;
      height: 24px;
    }
  }

  .go-trim-buybox__accordion-icon--open {
    display: none;
  }

  .go-trim-buybox__accordion-icon--closed {
    display: inline-flex;
  }

  .go-trim-buybox__accordion-content {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    color: var(--color-foreground);
    padding-block-start: 16px;
  }

  /* Subscription benefits box */
  .go-trim-buybox__benefits-box {
    background-color: #F9F9F9;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .go-trim-buybox__benefits-heading {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 16px;
    line-height: 21px;
    color: var(--color-foreground);
    margin: 0;
  }

  .go-trim-buybox__benefits-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .go-trim-buybox__benefit-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .go-trim-buybox__benefit-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .go-trim-buybox__benefit-text {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 18px;
    color: var(--color-foreground);
  }

  /* Supplement label button — fit-content so only the text is clickable */
  .go-trim-buybox__supplement-link {
    display: block;
    width: fit-content;
    margin-inline: auto;
    text-align: center;
    text-decoration: underline;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    color: var(--color-foreground);
    background: none;
    border: none;
    padding: 4px 8px;
    cursor: pointer;

    &:hover {
      opacity: 0.8;
    }

    &:focus-visible {
      outline: 2px solid var(--color-foreground);
      outline-offset: 2px;
    }
  }

  /* Supplement facts drawer — custom slide-from-right animation, no base-theme dialog classes */
  .go-trim-buybox__supplement-drawer {
    /* Closed: off-screen to the right — browser default display:none is fine, JS uses showModal() */
  }

  .go-trim-buybox__supplement-drawer[open] {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    right: 0;
    left: auto;
    bottom: 0;
    width: 480px;
    max-width: 100vw;
    height: 100dvh;
    margin: 0;
    padding: 0;
    border: none;
    background: #FFFFFF;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.12);

    /* Start off-screen; JS adds .is-open to slide in */
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);

    @media screen and (max-width: 749px) {
      width: 100vw;
    }
  }

  .go-trim-buybox__supplement-drawer[open].is-open {
    transform: translateX(0);
  }

  .go-trim-buybox__supplement-drawer::backdrop {
    background: rgba(0, 0, 0, 0.4);
  }

  .go-trim-buybox__supplement-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    border-bottom: 1px solid #D3D3D3;
    flex-shrink: 0;
  }

  .go-trim-buybox__supplement-drawer-title {
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 18px;
    line-height: 23px;
    color: #141414;
    margin: 0;
  }

  .go-trim-buybox__supplement-drawer-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;

    svg {
      width: 24px;
      height: 24px;
    }

    &:focus-visible {
      outline: 2px solid var(--color-foreground);
      outline-offset: 2px;
    }
  }

  .go-trim-buybox__supplement-drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .go-trim-buybox__supplement-image {
    max-width: 100%;
    height: auto;
  }

  .go-trim-buybox__supplement-empty {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    color: #6C6C6C;
    margin: 0;
    text-align: center;
  }

  /* Zoom dialog */
  .go-trim-buybox__zoom-dialog[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .go-trim-buybox__zoom-dialog[open].is-open {
    opacity: 1;
  }

  .go-trim-buybox__zoom-dialog::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }

  .go-trim-buybox__zoom-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 25px;
    max-width: 1240px;
    width: 100%;
    padding: 20px;
  }

  .go-trim-buybox__zoom-close {
    position: absolute;
    top: 0;
    inset-inline-end: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    z-index: 1;

    svg {
      width: 24px;
      height: 24px;
    }

    svg path {
      stroke: #FFFFFF;
    }

    &:focus-visible {
      outline: 2px solid #FFFFFF;
      outline-offset: 2px;
    }
  }

  .go-trim-buybox__zoom-main {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 15vw, 240px);
    width: 100%;
  }

  .go-trim-buybox__zoom-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    padding: 0;
    cursor: pointer;

    svg {
      width: 48px;
      height: 48px;
    }

    &:focus-visible {
      outline: 2px solid #FFFFFF;
      outline-offset: 4px;
    }
  }

  .go-trim-buybox__zoom-image-container {
    width: 664px;
    max-width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 36px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .go-trim-buybox__zoom-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .go-trim-buybox__zoom-thumbnails {
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: center;
    overflow-x: auto;
    max-width: 100%;
    -ms-overflow-style: none;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .go-trim-buybox__zoom-thumb {
    display: block;
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    padding: 0;
    border: 2px solid transparent;
    background: none;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.15s ease, border-color 0.15s ease;

    &.is-active {
      opacity: 1;
      border-color: #FFFFFF;
    }

    &:hover {
      opacity: 0.85;
    }

    &:focus-visible {
      outline: 2px solid #FFFFFF;
      outline-offset: 2px;
    }
  }

  .go-trim-buybox__zoom-thumb-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .go-trim-buybox__zoom-main {
      position: relative;
      gap: 0;
    }

    .go-trim-buybox__zoom-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
      background: rgba(0, 0, 0, 0.3);
    }

    .go-trim-buybox__zoom-arrow--prev {
      inset-inline-start: 8px;
    }

    .go-trim-buybox__zoom-arrow--next {
      inset-inline-end: 8px;
    }

    .go-trim-buybox__zoom-image-container {
      width: 100%;
      border-radius: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .go-trim-buybox__zoom-dialog[open] {
      transition: none;
    }
  }

  /* Mobile stacking */
  @media screen and (max-width: 749px) {
    .go-trim-buybox__variant-card {
      min-width: 80px;
    }

    .go-trim-buybox__title {
      font-size: 24px;
      line-height: 36px;
    }

    .go-trim-buybox__details {
      gap: 24px;
    }

    .go-trim-buybox__actions {
      flex-direction: column;
    }

    .go-trim-buybox__quantity {
      width: 100%;
    }

    .go-trim-buybox__cta-btn {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Go Trim Buybox",
  "tag": "section",
  "blocks": [
    {
      "type": "accordion-item",
      "name": "Accordion item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Accordion title"
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "Metafield source",
          "info": "e.g. custom.benefits — reads from the product metafield. Overrides static content below when set."
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content (fallback)",
          "default": "<p>Accordion content goes here.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "benefit-item",
      "name": "Benefit item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Benefit text"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "International Weight Loss Bestseller"
    },
    {
      "type": "text",
      "id": "reviews_text",
      "label": "Reviews text",
      "default": "4.5 (346 Reviews)"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show reviews",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_installments",
      "label": "Show installments",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_subscription_benefits",
      "label": "Show benefits box",
      "default": true
    },
    {
      "type": "text",
      "id": "subscription_benefits_heading",
      "label": "Benefits heading",
      "default": "Your subscription includes:"
    },
    {
      "type": "text",
      "id": "supplement_label_text",
      "label": "Supplement link text",
      "default": "View Supplement Label & Facts"
    },
    {
      "type": "url",
      "id": "supplement_label_url",
      "label": "Supplement link URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "number",
      "id": "gap",
      "label": "Column gap (px)",
      "default": 64
    },
    {
      "type": "number",
      "id": "media_gap",
      "label": "Media gap (px)",
      "default": 8
    },
    {
      "type": "number",
      "id": "media_border_radius",
      "label": "Media border radius (px)",
      "default": 16
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 64,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Go Trim Buybox",
      "category": "Product"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
