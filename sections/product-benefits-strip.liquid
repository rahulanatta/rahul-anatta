<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style product-benefits-strip"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --pbs-pill-border-color: {{ section.settings.pill_border_color }};
    --pbs-pill-border-radius: {{ section.settings.pill_border_radius }}px;
    --pbs-gap: {{ section.settings.gap }}px;
    --pbs-row-gap: {{ section.settings.row_gap }}px;
    --pbs-text-transform: {{ section.settings.text_transform }};
    --pbs-separator-size: {{ section.settings.separator_size }}px;
  "
>
  <div class="product-benefits-strip__items">
    {% for block in section.blocks %}
      {% if block.settings.url != blank %}
        <a href="{{ block.settings.url }}" class="product-benefits-strip__pill" {{ block.shopify_attributes }}>
          <span class="product-benefits-strip__pill-text">{{ block.settings.text | escape }}</span>
        </a>
      {% else %}
        <div class="product-benefits-strip__pill" {{ block.shopify_attributes }}>
          <span class="product-benefits-strip__pill-text">{{ block.settings.text | escape }}</span>
        </div>
      {% endif %}

      {% unless forloop.last %}
        <span class="product-benefits-strip__separator" aria-hidden="true">{{ section.settings.separator_icon }}</span>
      {% endunless %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .product-benefits-strip__items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--pbs-row-gap) var(--pbs-gap);
  }

  .product-benefits-strip__pill {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px 40px;
    border: 1px solid var(--pbs-pill-border-color);
    border-radius: var(--pbs-pill-border-radius);
    text-decoration: none;
    color: var(--color-foreground);
    transition: border-color var(--animation-speed-slow) ease;
  }

  a.product-benefits-strip__pill:hover {
    border-color: var(--color-foreground);
  }

  .product-benefits-strip__pill-text {
    font-family: var(--font-body--family);
    font-size: 21px;
    line-height: 28px;
    text-transform: var(--pbs-text-transform);
    color: var(--color-foreground);
  }

  .product-benefits-strip__separator {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body--family);
    font-size: var(--pbs-separator-size);
    line-height: 1;
    color: var(--color-foreground);
    flex-shrink: 0;
    user-select: none;
  }

  @media screen and (max-width: 749px) {
    .product-benefits-strip__items {
      gap: 12px 10px;
    }

    .product-benefits-strip__pill {
      padding: 16px 24px;
    }

    .product-benefits-strip__pill-text {
      font-size: 16px;
      line-height: 22px;
    }

    .product-benefits-strip__separator {
      font-size: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
