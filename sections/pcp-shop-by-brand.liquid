{% liquid
  assign max_products = section.settings.max_products | default: 4
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign card_image_sizes = '(min-width: 1024px) 30vw, calc(100vw - 32px)'
%}

<div
  id="section-{{ section.id }}"
  class="sbb color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} sbb--hide-mobile{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --sbb-margin-top: {{ section.settings.margin-block-start }}px;
    --sbb-margin-bottom: {{ section.settings.margin-block-end }}px;
  "
>
  <pcp-shop-by-brand class="sbb__container {% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
    <div class="sbb__sidebar">
      {% if eyebrow != blank or heading != blank %}
        <div class="sbb__header">
          {% if eyebrow != blank %}
            <span class="sbb__eyebrow">{{ eyebrow }}</span>
          {% endif %}
          {% if heading != blank %}
            <h2 class="sbb__heading">{{ heading }}</h2>
          {% endif %}
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="sbb__tablist" role="tablist" aria-label="{{ heading | default: 'Brand tabs' | escape }}">
          {% for block in section.blocks %}
            <button
              type="button"
              role="tab"
              class="sbb__tab{% if forloop.first %} sbb__tab--active{% endif %}"
              id="sbb-tab-{{ section.id }}-{{ forloop.index0 }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="sbb-panel-{{ section.id }}-{{ forloop.index0 }}"
              data-index="{{ forloop.index0 }}"
              on:click="/handleTabClick"
              {{ block.shopify_attributes }}
            >
              <span class="sbb__tab-title">{{ block.settings.title }}</span>
              {% if block.settings.description != blank %}
                <span class="sbb__tab-desc">{{ block.settings.description }}</span>
              {% endif %}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="sbb__panels">
      {% for block in section.blocks %}
        {% assign block_collection = block.settings.collection %}
        <div
          role="tabpanel"
          class="sbb__panel"
          id="sbb-panel-{{ section.id }}-{{ forloop.index0 }}"
          aria-labelledby="sbb-tab-{{ section.id }}-{{ forloop.index0 }}"
          data-panel-index="{{ forloop.index0 }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          {% if block_collection and block_collection.products.size > 0 %}
            {% assign product_count = block_collection.products.size %}
            {% if product_count > max_products %}
              {% assign product_count = max_products %}
            {% endif %}
            {% assign col1_limit = product_count | plus: 1 | divided_by: 2 %}
            {% assign col2_limit = product_count | minus: col1_limit %}

            <div class="sbb__grid">
              <div class="sbb__grid-col">
                {% for product in block_collection.products limit: col1_limit %}
                  <div class="sbb-card">
                    <a href="{{ product.url }}" class="sbb-card__link" aria-label="{{ product.title | escape }}">
                      <span class="visually-hidden">{{ product.title | escape }}</span>
                    </a>
                    <div class="sbb-card__image-wrapper">
                      {% if product.featured_image %}
                        {{
                          product.featured_image
                          | image_url: width: product.featured_image.width
                          | image_tag:
                            sizes: card_image_sizes,
                            widths: '375,450,750,900',
                            loading: 'lazy',
                            class: 'sbb-card__image',
                            alt: product.title
                        }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'sbb-card__image sbb-card__placeholder' }}
                      {% endif %}
                    </div>
                    <div class="sbb-card__info">
                      <div class="sbb-card__thumb">
                        {% if product.featured_image %}
                          <img
                            src="{{ product.featured_image | image_url: width: 132 }}"
                            alt=""
                            width="66"
                            height="66"
                            loading="lazy"
                            class="sbb-card__thumb-img"
                          >
                        {% endif %}
                      </div>
                      <div class="sbb-card__info-content">
                        <h3 class="sbb-card__title">{{ product.title | escape }}</h3>
                        <span class="sbb-card__price">{{ product.price | money }}</span>
                      </div>
                      <form action="/cart/add" method="post" class="sbb-card__form" on:submit="/handleAddToCart">
                        <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit" class="sbb-card__add-btn" aria-label="Add {{ product.title | escape }} to cart">
                          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <path d="M3.125 10H16.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M10 3.125V16.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                      </form>
                    </div>
                  </div>
                {% endfor %}
              </div>

              {% if col2_limit > 0 %}
                <div class="sbb__grid-col sbb__grid-col--offset">
                  {% for product in block_collection.products limit: col2_limit offset: col1_limit %}
                    <div class="sbb-card">
                      <a href="{{ product.url }}" class="sbb-card__link" aria-label="{{ product.title | escape }}">
                        <span class="visually-hidden">{{ product.title | escape }}</span>
                      </a>
                      <div class="sbb-card__image-wrapper">
                        {% if product.featured_image %}
                          {{
                            product.featured_image
                            | image_url: width: product.featured_image.width
                            | image_tag:
                              sizes: card_image_sizes,
                              widths: '375,450,750,900',
                              loading: 'lazy',
                              class: 'sbb-card__image',
                              alt: product.title
                          }}
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'sbb-card__image sbb-card__placeholder' }}
                        {% endif %}
                      </div>
                      <div class="sbb-card__info">
                        <div class="sbb-card__thumb">
                          {% if product.featured_image %}
                            <img
                              src="{{ product.featured_image | image_url: width: 132 }}"
                              alt=""
                              width="66"
                              height="66"
                              loading="lazy"
                              class="sbb-card__thumb-img"
                            >
                          {% endif %}
                        </div>
                        <div class="sbb-card__info-content">
                          <h3 class="sbb-card__title">{{ product.title | escape }}</h3>
                          <span class="sbb-card__price">{{ product.price | money }}</span>
                        </div>
                        <form action="/cart/add" method="post" class="sbb-card__form" on:submit="/handleAddToCart">
                          <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
                          <input type="hidden" name="quantity" value="1">
                          <button type="submit" class="sbb-card__add-btn" aria-label="Add {{ product.title | escape }} to cart">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                              <path d="M3.125 10H16.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                              <path d="M10 3.125V16.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </button>
                        </form>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% else %}
            <p class="sbb__empty">No products found. Please select a collection in the theme editor.</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </pcp-shop-by-brand>
</div>

<script src="{{ 'pcp-shop-by-brand.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  /* =========================================
     Shop By Brand — Section
     ========================================= */
  .sbb {
    padding-block-start: var(--padding-block-start, 100px);
    padding-block-end: var(--padding-block-end, 100px);
    margin-block-start: var(--sbb-margin-top, 0px);
    margin-block-end: var(--sbb-margin-bottom, 0px);
  }

  /* =========================================
     Container — two-column flex layout
     ========================================= */
  .sbb__container {
    display: flex;
    gap: 0;
  }

  /* =========================================
     Sidebar
     ========================================= */
  .sbb__sidebar {
    flex: 0 1 479px;
    max-width: 479px;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
    padding-inline-end: 30px;
  }

  .sbb__header {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sbb__eyebrow {
    font-family: var(--font-body--family);
    font-size: 18px;
    font-weight: 500;
    line-height: 28px;
    text-transform: capitalize;
    color: rgb(var(--color-foreground));
    margin: 0;
  }

  .sbb__heading {
    font-family: var(--font-heading--family);
    font-size: 40px;
    font-weight: 500;
    line-height: 48px;
    letter-spacing: 0;
    color: rgb(var(--color-foreground));
    margin: 0;
  }

  /* =========================================
     Tab list
     ========================================= */
  .sbb__tablist {
    display: flex;
    flex-direction: column;
    gap: 30px;
    border-inline-start: 2px solid rgb(var(--color-foreground));
  }

  .sbb__tab {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 4px 24px;
    border: none;
    background: none;
    cursor: pointer;
    text-align: start;
    border-radius: 24px;
    transition: background-color var(--animation-speed-slow, 0.2s) ease;
  }

  .sbb__tab:hover {
    background-color: rgba(0, 0, 0, 0.03);
  }

  .sbb__tab:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  .sbb__tab-title {
    font-family: var(--font-heading--family);
    font-size: 22px;
    font-weight: 500;
    line-height: 32px;
    letter-spacing: -0.44px;
    color: rgb(var(--color-foreground));
  }

  .sbb__tab-desc {
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 400;
    line-height: 26px;
    color: rgb(var(--color-foreground));
    display: none;
  }

  .sbb__tab--active .sbb__tab-desc {
    display: block;
  }

  /* =========================================
     Panels
     ========================================= */
  .sbb__panels {
    flex: 1 1 0;
    min-width: 0;
  }

  .sbb__panel[hidden] {
    display: none;
  }

  /* =========================================
     Staggered grid
     ========================================= */
  .sbb__grid {
    display: flex;
    gap: 31px;
  }

  .sbb__grid-col {
    display: flex;
    flex-direction: column;
    gap: 31px;
    flex: 1;
    min-width: 0;
  }

  .sbb__grid-col--offset {
    margin-block-start: 130px;
  }

  /* =========================================
     Product card
     ========================================= */
  .sbb-card {
    position: relative;
    border-radius: 30px;
    overflow: hidden;
  }

  .sbb-card__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .sbb-card__image-wrapper {
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .sbb-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sbb-card__placeholder {
    width: 100%;
    height: 100%;
  }

  /* =========================================
     Floating info bar
     ========================================= */
  .sbb-card__info {
    position: absolute;
    bottom: 16px;
    inset-inline-start: 16px;
    inset-inline-end: 16px;
    height: 90px;
    border-radius: 10px;
    background: #ffffff;
    display: flex;
    align-items: center;
    padding: 12px;
    gap: 12px;
    z-index: 2;
  }

  .sbb-card__thumb {
    flex-shrink: 0;
    width: 66px;
    height: 66px;
    border-radius: 6px;
    overflow: hidden;
  }

  .sbb-card__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sbb-card__info-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sbb-card__title {
    font-family: var(--font-body--family);
    font-size: 18px;
    font-weight: 500;
    line-height: 21px;
    letter-spacing: -0.36px;
    color: #000000;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .sbb-card__price {
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    color: #000000;
  }

  .sbb-card__form {
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }

  .sbb-card__add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: #E9E9E9;
    border: 1px solid #E9E9E9;
    cursor: pointer;
    color: #000000;
    transition: opacity var(--animation-speed-slow, 0.2s) ease;
  }

  .sbb-card__add-btn:hover {
    opacity: 0.8;
  }

  .sbb-card__add-btn:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  .sbb-card__add-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* =========================================
     Empty state
     ========================================= */
  .sbb__empty {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground));
    padding: 40px 0;
  }

  /* =========================================
     Mobile — hide section
     ========================================= */
  @media screen and (max-width: 1023px) {
    .sbb--hide-mobile {
      display: none;
    }
  }

  /* =========================================
     Mobile — layout
     ========================================= */
  @media screen and (max-width: 1023px) {
    .sbb__container {
      flex-direction: column;
      gap: 32px;
    }

    .sbb__sidebar {
      flex: none;
      max-width: none;
      min-width: 0;
      padding-inline-end: 0;
      gap: 24px;
    }

    .sbb__heading {
      font-size: 28px;
      line-height: 36px;
    }

    .sbb__tablist {
      flex-direction: row;
      overflow-x: auto;
      border-inline-start: none;
      gap: 12px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding-block-end: 4px;
    }

    .sbb__tablist::-webkit-scrollbar {
      display: none;
    }

    .sbb__tab {
      flex-shrink: 0;
      white-space: nowrap;
      padding: 8px 20px;
      border: 1px solid rgb(var(--color-foreground));
      border-radius: 24px;
      gap: 0;
    }

    .sbb__tab--active {
      background: rgb(var(--color-foreground));
    }

    .sbb__tab--active .sbb__tab-title {
      color: rgb(var(--color-background));
    }

    .sbb__tab-desc {
      display: none !important;
    }

    .sbb__grid {
      flex-direction: column;
    }

    .sbb__grid-col--offset {
      margin-block-start: 0;
    }

    .sbb-card__info {
      height: auto;
      min-height: 70px;
      padding: 10px;
      gap: 10px;
    }

    .sbb-card__thumb {
      width: 50px;
      height: 50px;
    }

    .sbb-card__title {
      font-size: 15px;
      line-height: 18px;
    }

    .sbb-card__price {
      font-size: 14px;
      line-height: 20px;
    }

    .sbb-card__add-btn {
      width: 40px;
      height: 40px;
      border-radius: 20px;
    }
  }

  /* =========================================
     Reduced motion
     ========================================= */
  @media (prefers-reduced-motion: reduce) {
    .sbb__tab,
    .sbb-card__add-btn {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop By Brand",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop By Brand"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate your Everyday Routine"
    },
    {
      "type": "number",
      "id": "max_products",
      "label": "Max products per tab",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin-block-start",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin-block-end",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "brand-tab",
      "name": "Brand tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Brand Name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Brand"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
