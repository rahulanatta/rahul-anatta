{% liquid
  assign collection = collections[section.settings.collection]
  assign max_products = section.settings.max_products | default: 10
  assign container_radius = section.settings.container_border_radius | default: 13
  assign card_radius = section.settings.card_border_radius | default: 13
  assign card_gap = section.settings.card_gap | default: 20
  assign card_padding = section.settings.card_padding | default: 16
  assign image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: image
%}

<div
  id="section-{{ section.id }}"
  class="beauty-carousel color-{{ section.settings.color_scheme }} section--{{ section.settings.section_width }}"
  style="
    --bc-padding-top: {{ section.settings.padding-block-start }}px;
    --bc-padding-bottom: {{ section.settings.padding-block-end }}px;
    --bc-padding-inline-start: {{ section.settings.padding-inline-start }}px;
    --bc-padding-inline-end: {{ section.settings.padding-inline-end }}px;
    --bc-container-radius: {{ container_radius }}px;
    --bc-card-radius: {{ card_radius }}px;
    --bc-card-gap: {{ card_gap }}px;
    --bc-card-padding: {{ card_padding }}px;
  "
>
  <div class="beauty-carousel__container">
    {% if image != blank %}
      <div class="beauty-carousel__image-wrapper beauty-carousel__image-wrapper--desktop">
        {%- assign sizes_val = '(min-width: 1024px) 231px, 100vw' -%}
        {{
          image
          | image_url: width: image.width
          | image_tag:
            sizes: sizes_val,
            widths: '375,440,550,750',
            loading: 'lazy',
            class: 'beauty-carousel__image',
            alt: image.alt
        }}
      </div>
    {% endif %}

    {% if mobile_image != blank %}
      <div class="beauty-carousel__image-wrapper beauty-carousel__image-wrapper--mobile">
        {%- assign mobile_sizes = '100vw' -%}
        {{
          mobile_image
          | image_url: width: mobile_image.width
          | image_tag:
            sizes: mobile_sizes,
            widths: '375,440,550,750',
            loading: 'lazy',
            class: 'beauty-carousel__image',
            alt: mobile_image.alt
        }}
      </div>
    {% endif %}

    {% if collection and collection.products.size > 0 %}
      <div class="beauty-carousel__grid-wrapper">
        <div class="beauty-carousel__grid">
          {% for product in collection.products limit: max_products %}
            <a href="{{ product.url }}" class="bc-card">
              <div class="bc-card__image-wrapper">
                {% if product.featured_image != blank %}
                  {%- assign card_sizes = '(min-width: 1024px) 187px, 140px' -%}
                  {{
                    product.featured_image
                    | image_url: width: product.featured_image.width
                    | image_tag:
                      sizes: card_sizes,
                      widths: '140,187,280,374',
                      loading: 'lazy',
                      class: 'bc-card__image',
                      alt: product.featured_image.alt
                  }}
                {% else %}
                  <div class="bc-card__image-placeholder">
                    {{ 'product-1' | placeholder_svg_tag: 'bc-card__placeholder-svg' }}
                  </div>
                {% endif %}
              </div>
              <div class="bc-card__content">
                <h3 class="bc-card__title">{{ product.title }}</h3>
                <p class="bc-card__price">{{ product.price | money }}</p>
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .beauty-carousel {
    padding-block-start: var(--bc-padding-top, 0px);
    padding-block-end: var(--bc-padding-bottom, 0px);
    padding-inline-start: var(--bc-padding-inline-start, 0px);
    padding-inline-end: var(--bc-padding-inline-end, 0px);
  }

  .beauty-carousel__container {
    display: flex;
    flex-direction: column;
    border-radius: var(--bc-container-radius, 13px);
    overflow: hidden;
  }

  /* Desktop image — hidden on mobile */
  .beauty-carousel__image-wrapper--desktop {
    display: none;
  }

  /* Mobile image — visible on mobile */
  .beauty-carousel__image-wrapper--mobile {
    display: block;
    width: 100%;
    aspect-ratio: 440 / 236;
    overflow: hidden;
  }

  .beauty-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Product grid wrapper */
  .beauty-carousel__grid-wrapper {
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .beauty-carousel__grid-wrapper::-webkit-scrollbar {
    display: none;
  }

  /* Mobile: horizontal scroll strip */
  .beauty-carousel__grid {
    display: flex;
    gap: var(--bc-card-gap, 20px);
    padding: var(--bc-card-gap, 20px);
    scroll-snap-type: x mandatory;
  }

  /* Product card */
  .bc-card {
    display: flex;
    flex-direction: column;
    gap: 11px;
    justify-content: flex-end;
    align-items: center;
    min-width: 170px;
    max-width: 170px;
    border-radius: var(--bc-card-radius, 13px);
    border: 1px solid #E6E6E6;
    background-color: #FFFFFF;
    padding: var(--bc-card-padding, 16px);
    scroll-snap-align: start;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s ease;
  }

  .bc-card:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .bc-card:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  /* Card image */
  .bc-card__image-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    aspect-ratio: 187 / 132;
    overflow: hidden;
  }

  .bc-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .bc-card__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bc-card__placeholder-svg {
    width: 100%;
    height: auto;
  }

  /* Card content */
  .bc-card__content {
    display: flex;
    flex-direction: column;
    gap: 11px;
    align-items: center;
    width: 100%;
  }

  .bc-card__title {
    font-family: var(--font-body--family);
    font-size: 15px;
    font-weight: 400;
    line-height: 20px;
    color: #000000;
    margin: 0;
    text-align: center;
    word-break: break-word;
  }

  .bc-card__price {
    font-family: var(--font-body--family);
    font-size: 18px;
    font-weight: 400;
    line-height: 40px;
    color: #000000;
    margin: 0;
    text-align: center;
  }

  /* ========================================
     Desktop layout: ≥ 1024px
     ======================================== */
  @media screen and (min-width: 1024px) {
    .beauty-carousel__container {
      flex-direction: row;
      align-items: center;
    }

    /* Desktop image visible, mobile image hidden */
    .beauty-carousel__image-wrapper--desktop {
      display: block;
      flex: 0 0 auto;
      width: 231px;
      height: 100%;
      min-height: 578px;
      align-self: stretch;
      overflow: hidden;
    }

    .beauty-carousel__image-wrapper--mobile {
      display: none;
    }

    /* Grid wrapper fills remaining space */
    .beauty-carousel__grid-wrapper {
      flex: 1 1 0;
      min-width: 0;
      overflow: hidden;
    }

    /* Desktop: wrapping grid */
    .beauty-carousel__grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--bc-card-gap, 20px);
      padding: var(--bc-card-gap, 20px);
    }

    .bc-card {
      flex: 0 1 220px;
      min-width: 180px;
      max-width: 220px;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .bc-card {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Beauty carousel",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "number",
      "id": "max_products",
      "label": "Max products",
      "default": 10
    },
    {
      "type": "header",
      "content": "Card options"
    },
    {
      "type": "number",
      "id": "container_border_radius",
      "label": "Container border radius",
      "default": 13
    },
    {
      "type": "number",
      "id": "card_border_radius",
      "label": "Card border radius",
      "default": 13
    },
    {
      "type": "number",
      "id": "card_gap",
      "label": "Card gap",
      "default": 20
    },
    {
      "type": "number",
      "id": "card_padding",
      "label": "Card padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Beauty carousel"
    }
  ]
}
{% endschema %}
