{% liquid
  assign heading = section.settings.heading
%}

<div
  id="section-{{ section.id }}"
  class="pki color-{{ section.settings.color_scheme }}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --pki-margin-top: {{ section.settings.margin-block-start }}px;
    --pki-margin-bottom: {{ section.settings.margin-block-end }}px;
  "
>
  <div class="pki__container {% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
    {% if heading != blank %}
      <span class="pki__eyebrow">{{ heading }}</span>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="pki__cards">
        {% for block in section.blocks %}
          <div class="pki__card" {{ block.shopify_attributes }}>
            <div class="pki__card-image">
              {% if block.settings.image != blank %}
                {%- assign sizes_val = '(min-width: 1024px) 140px, 140px' -%}
                {{
                  block.settings.image
                  | image_url: width: 280
                  | image_tag:
                    sizes: sizes_val,
                    widths: '140,280',
                    loading: 'lazy',
                    class: 'pki__img',
                    alt: block.settings.image.alt
                }}
              {% else %}
                <div class="pki__img-placeholder">
                  {{ 'image' | placeholder_svg_tag: 'pki__placeholder-svg' }}
                </div>
              {% endif %}
            </div>
            <div class="pki__card-text">
              {% if block.settings.title != blank %}
                <h3 class="pki__card-title">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="pki__card-desc">{{ block.settings.description | escape }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .pki {
    padding-block-start: var(--padding-block-start, 48px);
    padding-block-end: var(--padding-block-end, 48px);
    margin-block-start: var(--pki-margin-top, 0px);
    margin-block-end: var(--pki-margin-bottom, 0px);
  }

  .pki__container {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .pki__eyebrow {
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    text-transform: uppercase;
    color: rgb(var(--color-foreground));
  }

  .pki__cards {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media screen and (min-width: 1024px) {
    .pki__cards {
      flex-direction: row;
      gap: 32px;
      flex-wrap: wrap;
    }

    .pki__card {
      flex: 1 1 calc(33.333% - 22px);
      min-width: 300px;
    }
  }

  .pki__card {
    display: flex;
    flex-direction: row;
    gap: 24px;
    align-items: center;
  }

  .pki__card-image {
    width: 140px;
    height: 140px;
    border-radius: 100px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .pki__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pki__img-placeholder {
    width: 100%;
    height: 100%;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pki__placeholder-svg {
    width: 60%;
    height: 60%;
  }

  .pki__card-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pki__card-title {
    font-family: var(--font-body--family);
    font-size: 20px;
    line-height: 20px;
    font-weight: 500;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  .pki__card-desc {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 19px;
    font-weight: 400;
    opacity: 0.5;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  @media (prefers-reduced-motion: reduce) {
    .pki * {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Key Ingredients",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Key ingredients"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin-block-start",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin-block-end",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ingredient"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Key Ingredients"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
