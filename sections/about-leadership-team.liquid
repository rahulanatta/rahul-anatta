{% liquid
  assign section_width = section.settings.section_width
  assign color_scheme = section.settings.color_scheme
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile
  assign gap = section.settings.gap
  assign card_image_radius = section.settings.card_image_radius
%}

<div
  class="section section--{{ section_width }} color-{{ color_scheme }} spacing-style about-leadership-team"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --alt-columns-desktop: {{ columns_desktop }};
    --alt-columns-mobile: {{ columns_mobile }};
    --alt-gap: {{ gap }}px;
    --alt-card-radius: {{ card_image_radius }}px;
  "
>
  {% if section.settings.heading != blank %}
    <{{ section.settings.heading_tag }} class="about-leadership-team__heading">
      {{ section.settings.heading | escape }}
    </{{ section.settings.heading_tag }}>
  {% endif %}

  <div class="about-leadership-team__grid">
    {% for block in section.blocks %}
      <div
        class="about-leadership-team__card"
        style="--alt-card-rotation: {{ block.settings.image_rotation }}deg;"
        {{ block.shopify_attributes }}
      >
        <div class="about-leadership-team__card-image-wrapper">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: block.settings.image.width
              | image_tag:
                sizes: '(min-width: 750px) 25vw, 50vw',
                widths: '180,250,328,375,500',
                loading: 'lazy',
                class: 'about-leadership-team__card-image',
                alt: block.settings.name
            }}
          {% else %}
            <div class="about-leadership-team__card-placeholder">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}
        </div>

        <div class="about-leadership-team__card-info">
          {% if block.settings.name != blank %}
            <p class="about-leadership-team__card-name">{{ block.settings.name | escape }}</p>
          {% endif %}
          {% if block.settings.title != blank %}
            <p class="about-leadership-team__card-title">{{ block.settings.title | escape }}</p>
          {% endif %}
          {% if block.settings.bio_url != blank %}
            <a href="{{ block.settings.bio_url }}" class="about-leadership-team__card-link">
              View Bio →
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .about-leadership-team__heading {
    font-family: var(--font-heading--family);
    font-size: 36px;
    font-weight: 400;
    line-height: 54px;
    color: #141414;
    text-align: center;
    margin: 0 0 40px;
  }

  .about-leadership-team__grid {
    display: grid;
    grid-template-columns: repeat(var(--alt-columns-desktop, 4), 1fr);
    gap: var(--alt-gap, 32px);
  }

  .about-leadership-team__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .about-leadership-team__card-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 328 / 327;
    overflow: hidden;
    border-radius: var(--alt-card-radius, 104px) 0 0 0;
    transform: rotate(var(--alt-card-rotation, 0deg));
  }

  .about-leadership-team__card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-leadership-team__card-placeholder {
    width: 100%;
    height: 100%;
    background-color: #f0f0f0;
  }

  .about-leadership-team__card-placeholder .placeholder-svg {
    width: 100%;
    height: 100%;
  }

  .about-leadership-team__card-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    text-align: center;
  }

  .about-leadership-team__card-name {
    font-family: var(--font-body--family);
    font-size: 22px;
    font-weight: 600;
    line-height: 30px;
    text-transform: uppercase;
    color: #171717;
    margin: 0;
  }

  .about-leadership-team__card-title {
    font-family: var(--font-body--family);
    font-size: 20px;
    font-weight: 400;
    line-height: 28px;
    color: #525252;
    margin: 0;
  }

  .about-leadership-team__card-link {
    font-family: var(--font-body--family);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    color: #000000;
    text-decoration: none;
    margin-top: 4px;
  }

  .about-leadership-team__card-link:hover {
    text-decoration: underline;
  }

  .about-leadership-team__card-link:focus-visible {
    outline: 2px solid #171717;
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .about-leadership-team__heading {
      font-size: 28px;
      line-height: 36px;
      margin-bottom: 24px;
    }

    .about-leadership-team__grid {
      grid-template-columns: repeat(var(--alt-columns-mobile, 2), 1fr);
      gap: calc(var(--alt-gap, 32px) * 0.75);
    }

    .about-leadership-team__card-name {
      font-size: 16px;
      line-height: 22px;
    }

    .about-leadership-team__card-title {
      font-size: 14px;
      line-height: 20px;
    }

    .about-leadership-team__card-link {
      font-size: 14px;
      line-height: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Leadership team",
  "tag": "section",
  "class": "about-leadership-team-wrapper section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Executive & Leadership Team"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Grid layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "number",
      "id": "card_image_radius",
      "label": "Card image radius",
      "default": 104
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "bio-card",
      "name": "Bio card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Portrait image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Team Member"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Position"
        },
        {
          "type": "url",
          "id": "bio_url",
          "label": "Bio link URL"
        },
        {
          "type": "number",
          "id": "image_rotation",
          "label": "Image rotation (deg)",
          "default": 0
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Leadership team"
    }
  ]
}
{% endschema %}
