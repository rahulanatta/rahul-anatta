{% liquid
  assign collection = section.settings.collection
  assign heading = section.settings.heading
  assign shop_all_label = section.settings.shop_all_label
  assign shop_all_url = section.settings.shop_all_url
  assign max_products = section.settings.max_products | default: 8
  assign card_gap = section.settings.card_gap | default: 12
%}

<div
  id="section-{{ section.id }}"
  class="ppc-carousel color-{{ section.settings.color_scheme }}"
  style="
    --ppc-padding-top: {{ section.settings.padding-block-start }}px;
    --ppc-padding-bottom: {{ section.settings.padding-block-end }}px;
    --ppc-margin-top: {{ section.settings.margin-block-start }}px;
    --ppc-margin-bottom: {{ section.settings.margin-block-end }}px;
    --ppc-card-gap: {{ card_gap }}px;
  "
>
  <div class="ppc-carousel__container {% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
    <div class="ppc-carousel__header">
      <h2 class="ppc-carousel__heading">{{ heading }}</h2>
      {% if shop_all_url != blank %}
        <a href="{{ shop_all_url }}" class="ppc-carousel__shop-all">
          {{ shop_all_label }}
        </a>
      {% elsif collection %}
        <a href="{{ collection.url }}" class="ppc-carousel__shop-all">
          {{ shop_all_label }}
        </a>
      {% endif %}
    </div>

    {% if collection and collection.products.size > 0 %}
      <pcp-product-carousel class="ppc-carousel__wrapper">
        <div class="ppc-carousel__track" ref="track">
          {% for product in collection.products limit: max_products %}
            {% render 'pcp-product-card',
              product: product,
              section_id: section.id,
              show_vendor: section.settings.show_vendor,
              show_reviews: section.settings.show_reviews,
              show_cashback: section.settings.show_cashback,
              show_add_to_cart: section.settings.show_add_to_cart
            %}
          {% endfor %}
        </div>

        <div class="ppc-carousel__nav">
          <button
            type="button"
            class="ppc-carousel__nav-btn ppc-carousel__nav-btn--prev"
            ref="prevButton"
            aria-label="Previous products"
            on:click="/handlePrev"
            disabled
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="ppc-carousel__nav-btn ppc-carousel__nav-btn--next"
            ref="nextButton"
            aria-label="Next products"
            on:click="/handleNext"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </pcp-product-carousel>
    {% else %}
      <p class="ppc-carousel__empty">No products found. Please select a collection in the theme editor.</p>
    {% endif %}
  </div>
</div>

<script src="{{ 'pcp-product-carousel.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .ppc-carousel {
    padding-block-start: var(--ppc-padding-top, 48px);
    padding-block-end: var(--ppc-padding-bottom, 48px);
    margin-block-start: var(--ppc-margin-top, 0px);
    margin-block-end: var(--ppc-margin-bottom, 0px);
  }

  .ppc-carousel__container {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ppc-carousel__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-inline: 4px;
  }

  .ppc-carousel__heading {
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xl);
    font-weight: 400;
    line-height: 26px;
    letter-spacing: 0;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  .ppc-carousel__shop-all {
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    font-weight: 300;
    line-height: 18px;
    text-decoration: underline;
    color: rgb(var(--color-foreground));
  }

  .ppc-carousel__shop-all:hover {
    opacity: 0.7;
  }

  /* Carousel */
  .ppc-carousel__wrapper {
    position: relative;
    display: block;
  }

  .ppc-carousel__track {
    display: flex;
    gap: var(--ppc-card-gap, 12px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-block-end: 16px;
  }

  .ppc-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .ppc-carousel__nav {
    display: none;
  }

  @media screen and (min-width: 1024px) {
    .ppc-carousel__nav {
      display: flex;
      gap: 8px;
      position: absolute;
      inset-block-start: -44px;
      inset-inline-end: 60px;
    }
  }

  .ppc-carousel__nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-foreground) / 0.15);
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .ppc-carousel__nav-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .ppc-carousel__nav-btn:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  .ppc-carousel__empty {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground));
  }

  /* Product Card */
  .ppc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 161px;
    max-width: 161px;
    border-radius: var(--ppc-card-radius, 16px);
    border: 1px solid #E6E6E6;
    background-color: rgb(var(--color-background));
    scroll-snap-align: start;
    overflow: hidden;
  }

  @media screen and (min-width: 1024px) {
    .ppc-card {
      min-width: 237px;
      max-width: 237px;
    }
  }

  .ppc-card__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Image */
  .ppc-card__image-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 36px;
    border-radius: var(--ppc-card-radius, 16px) var(--ppc-card-radius, 16px) 0 0;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .ppc-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ppc-card__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ppc-card__placeholder-svg {
    width: 100%;
    height: auto;
  }

  /* Content area */
  .ppc-card__content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    padding: 16px 16px 20px 11px;
  }

  @media screen and (min-width: 1024px) {
    .ppc-card__content {
      padding: 17px 16px 20px 16px;
    }
  }

  .ppc-card__info {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Vendor */
  .ppc-card__vendor {
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xs);
    font-weight: 400;
    line-height: 16px;
    color: #141414;
    margin: 0;
    display: none;
  }

  @media screen and (min-width: 1024px) {
    .ppc-card__vendor {
      display: block;
    }
  }

  /* Title */
  .ppc-card__title {
    margin: 0;
  }

  .ppc-card__title-link {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    font-weight: 500;
    line-height: 18px;
    color: #141414;
    text-decoration: none;
    position: relative;
    z-index: 2;
  }

  .ppc-card__title-link:hover {
    text-decoration: underline;
  }

  @media screen and (min-width: 1024px) {
    .ppc-card__title-link {
      font-size: var(--font-size--xl);
      font-weight: 400;
      line-height: 26px;
    }
  }

  /* Reviews */
  .ppc-card__reviews {
    display: none;
    align-items: center;
    gap: 4px;
  }

  @media screen and (min-width: 1024px) {
    .ppc-card__reviews {
      display: flex;
    }
  }

  .ppc-card__stars {
    display: block;
    width: 68px;
    height: 12px;
  }

  .ppc-card__reviews-text {
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xs);
    font-weight: 400;
    line-height: 16px;
    color: #141414;
  }

  /* Variant picker — mobile only */
  .ppc-card__variants {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  @media screen and (min-width: 1024px) {
    .ppc-card__variants {
      display: none;
    }
  }

  .ppc-card__variants-label {
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 400;
    line-height: 16px;
    color: #141414;
    margin: 0;
  }

  .ppc-card__variants-list {
    display: flex;
    gap: 6px;
    position: relative;
    z-index: 2;
  }

  .ppc-card__size-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border-radius: 12px;
    border: 1px solid #D3D3D3;
    background: transparent;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    font-weight: 400;
    line-height: 18px;
    color: #000000;
    cursor: pointer;
    position: relative;
    z-index: 2;
    min-width: 40px;
  }

  .ppc-card__size-btn--selected {
    border-color: #000000;
  }

  .ppc-card__size-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .ppc-card__size-btn:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  /* Price */
  .ppc-card__price-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ppc-card__price-wrapper {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ppc-card__price {
    font-family: var(--font-body--family);
    font-size: var(--font-size--lg);
    font-weight: 500;
    line-height: 23px;
    color: #000000;
  }

  .ppc-card__compare-price {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    font-weight: 300;
    line-height: 16px;
    text-decoration: line-through;
    color: #6C6C6C;
  }

  /* Cashback */
  .ppc-card__cashback {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .ppc-card__cashback-percent {
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xs);
    font-weight: 400;
    line-height: 16px;
    color: #141414;
  }

  .ppc-card__cashback-icon {
    width: 12px;
    height: 12px;
  }

  .ppc-card__cashback-label {
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xs);
    font-weight: 400;
    line-height: 16px;
    color: #141414;
  }

  /* Actions */
  .ppc-card__actions {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-block-start: 7px;
    position: relative;
    z-index: 2;
  }

  .ppc-card__add-form {
    display: contents;
  }

  .ppc-card__add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border-radius: 12px;
    border: 1px solid #D3D3D3;
    background: transparent;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    font-weight: 400;
    line-height: 18px;
    color: #000000;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }

  /* Mobile: full-width add button with smaller border-radius */
  @media screen and (max-width: 1023px) {
    .ppc-card__actions {
      justify-content: center;
      padding: 7px 0;
    }

    .ppc-card__add-btn {
      width: 100%;
      max-width: 147px;
      border-radius: 9px;
      padding: 5px 24px;
      text-align: center;
    }
  }

  .ppc-card__add-btn:hover {
    background-color: #f5f5f5;
  }

  .ppc-card__add-btn:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  .ppc-card__add-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    .ppc-carousel__track {
      scroll-behavior: auto;
    }

    .ppc-card__add-btn,
    .ppc-carousel__nav-btn {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Carousel",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Our Products"
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop all label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "shop_all_url",
      "label": "Shop all link"
    },
    {
      "type": "number",
      "id": "max_products",
      "label": "Max products",
      "default": 8
    },
    {
      "type": "header",
      "content": "Card options"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show reviews",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cashback",
      "label": "Show cashback",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "number",
      "id": "card_gap",
      "label": "Card gap",
      "default": 12
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin-block-start",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin-block-end",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Product Carousel"
    }
  ]
}
{% endschema %}
