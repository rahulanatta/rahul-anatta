{% liquid
  assign section_width = section.settings.section_width
  assign heading = section.settings.heading
  assign heading_tag = section.settings.heading_tag
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section_width }} color-{{ section.settings.color_scheme }} spacing-style brand-category-grid"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --bcg-columns-desktop: {{ section.settings.columns_desktop }};
    --bcg-columns-mobile: {{ section.settings.columns_mobile }};
    --bcg-gap: {{ section.settings.gap }}px;
    --bcg-card-radius: {{ section.settings.card_border_radius }}px;
  "
>
  {% if heading != blank or section.blocks.size > 0 %}
    {% if heading != blank %}
      <{{ heading_tag }} class="brand-category-grid__heading">
        {{ heading | escape }}
      </{{ heading_tag }}>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="brand-category-grid__grid">
        {% for block in section.blocks %}
          {% if block.type == 'brand-card' %}
            {% liquid
              assign is_wide = false
              if block.settings.wide
                assign is_wide = true
              endif
            %}
            <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %}
              class="brand-category-grid__card{% if is_wide %} brand-category-grid__card--wide{% endif %}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.image != blank %}
                {%- if is_wide -%}
                  {%- assign sizes_val = '(min-width: 1024px) 50vw, 100vw' -%}
                {%- else -%}
                  {%- assign sizes_val = '(min-width: 1024px) 25vw, 50vw' -%}
                {%- endif -%}
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    widths: '375,550,750,1100',
                    sizes: sizes_val,
                    loading: 'lazy',
                    class: 'brand-category-grid__image',
                    alt: block.settings.title
                }}
              {% else %}
                <div class="brand-category-grid__image brand-category-grid__image--placeholder">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if block.settings.title != blank %}
                <div class="brand-category-grid__overlay"></div>
                <div class="brand-category-grid__content">
                  <span class="brand-category-grid__title">{{ block.settings.title | escape }}</span>
                </div>
              {% endif %}
            </{% if block.settings.link != blank %}a{% else %}div{% endif %}>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</div>

{% stylesheet %}
  .brand-category-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .brand-category-grid__heading {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 34px;
    line-height: 37px;
    letter-spacing: 0;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  .brand-category-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--bcg-columns-mobile, 2), 1fr);
    gap: var(--bcg-gap, 10px);

    @media screen and (min-width: 1024px) {
      grid-template-columns: repeat(var(--bcg-columns-desktop, 4), 1fr);
    }
  }

  .brand-category-grid__card {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: var(--bcg-card-radius, 14px);
    border: 1px solid #000000;
    overflow: hidden;
    text-decoration: none;
    background-color: #f8f8f8;
    cursor: pointer;
  }

  .brand-category-grid__card--wide {
    grid-column: span 2;
    aspect-ratio: 2 / 1;
  }

  .brand-category-grid__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .brand-category-grid__card:hover .brand-category-grid__image {
    transform: scale(1.05);
  }

  .brand-category-grid__image--placeholder {
    background: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;

    & svg {
      width: 40%;
      height: 40%;
      opacity: 0.3;
    }
  }

  .brand-category-grid__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.6) 100%);
    pointer-events: none;
    z-index: 1;
  }

  .brand-category-grid__content {
    position: absolute;
    bottom: 16px;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-inline: 16px;
  }

  .brand-category-grid__title {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 1.3;
    color: #ffffff;
    text-align: center;

    @media screen and (min-width: 1024px) {
      font-size: 18px;
    }
  }

  @media screen and (max-width: 1023px) {
    .brand-category-grid__heading {
      font-size: 24px;
      line-height: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-category-grid__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand category grid",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h3"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 20,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "brand-card",
      "name": "Brand card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Brand image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Brand name",
          "default": "Brand"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "wide",
          "label": "Wide card (span 2 columns)",
          "default": false
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Brand category grid"
    }
  ]
}
{% endschema %}
