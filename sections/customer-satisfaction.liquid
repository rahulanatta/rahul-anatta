{% liquid
  assign section_width = section.settings.section_width
  assign heading_tag = section.settings.heading_tag
%}

<div
  class="customer-satisfaction"
  style="
    background-color: {{ section.settings.background_color }};
    --customer-satisfaction-text-color: {{ section.settings.text_color }};
    --customer-satisfaction-divider-color: {{ section.settings.divider_color }};
    --customer-satisfaction-columns: {{ section.settings.columns }};
    --customer-satisfaction-margin-top: {{ section.settings.margin-block-start }}px;
    --customer-satisfaction-margin-bottom: {{ section.settings.margin-block-end }}px;
  "
>
  <div
    class="customer-satisfaction__inner section section--{{ section_width }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% if section.settings.heading != blank %}
      <{{ heading_tag }} class="customer-satisfaction__heading">
        {{ section.settings.heading | escape }}
      </{{ heading_tag }}>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="customer-satisfaction__grid">
        {% for block in section.blocks %}
          <div class="customer-satisfaction__item" {{ block.shopify_attributes }}>
            {% if block.settings.stat_value != blank %}
              <p class="customer-satisfaction__stat">{{ block.settings.stat_value | escape }}</p>
            {% endif %}
            <div class="customer-satisfaction__item-body">
              {% if block.settings.description != blank %}
                <p class="customer-satisfaction__description">{{ block.settings.description | escape }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .customer-satisfaction {
    margin-top: var(--customer-satisfaction-margin-top, 0px);
    margin-bottom: var(--customer-satisfaction-margin-bottom, 0px);
  }

  .customer-satisfaction__inner {
    display: flex;
    flex-direction: column;
    gap: 64px;
    align-items: center;
  }

  .customer-satisfaction__heading {
    font-family: var(--font-body--family);
    font-size: 32px;
    font-weight: 400;
    line-height: 38px;
    letter-spacing: 0;
    text-align: center;
    color: var(--customer-satisfaction-text-color);
    margin: 0;
    width: 100%;
  }

  .customer-satisfaction__grid {
    display: grid;
    grid-template-columns: repeat(var(--customer-satisfaction-columns, 3), 1fr);
    gap: 32px;
    width: 100%;
  }

  .customer-satisfaction__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .customer-satisfaction__stat {
    font-family: var(--font-body--family);
    font-size: 48px;
    font-weight: 300;
    line-height: 62px;
    text-transform: uppercase;
    color: var(--customer-satisfaction-text-color);
    margin: 0;
  }

  .customer-satisfaction__item-body {
    border-top: 1px solid var(--customer-satisfaction-divider-color);
    padding-top: 8px;
  }

  .customer-satisfaction__description {
    font-family: var(--font-body--family);
    font-size: 17px;
    line-height: 24px;
    font-weight: 400;
    color: var(--customer-satisfaction-text-color);
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .customer-satisfaction__grid {
      grid-template-columns: 1fr;
    }

    .customer-satisfaction__heading {
      font-size: 24px;
      line-height: 30px;
    }

    .customer-satisfaction__stat {
      font-size: 36px;
      line-height: 48px;
    }

    .customer-satisfaction__inner {
      gap: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer Satisfaction",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "stat-item",
      "name": "Stat item",
      "settings": [
        {
          "type": "text",
          "id": "stat_value",
          "label": "Stat value"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Satisfaction"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1BB7C4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Margin"
    },
    {
      "type": "range",
      "id": "margin-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Customer Satisfaction",
      "category": "t:categories.text",
      "blocks": {
        "item_1": {
          "type": "stat-item",
          "settings": {
            "stat_value": "98%",
            "description": "Customer Satisfaction Rate based on verified purchase reviews and post-purchase surveys."
          }
        },
        "item_2": {
          "type": "stat-item",
          "settings": {
            "stat_value": "50K+",
            "description": "Happy Customers Worldwide who trust our products for their daily wellness and health routines."
          }
        },
        "item_3": {
          "type": "stat-item",
          "settings": {
            "stat_value": "4.8/5",
            "description": "Average Customer Rating across all product lines, reflecting consistent quality and effectiveness."
          }
        }
      },
      "block_order": ["item_1", "item_2", "item_3"]
    }
  ]
}
{% endschema %}
