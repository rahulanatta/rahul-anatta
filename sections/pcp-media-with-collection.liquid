{% liquid
  assign collection = section.settings.collection
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign image = section.settings.image
  assign max_products = section.settings.max_products | default: 8
  assign card_gap = section.settings.card_gap | default: 20
  assign show_vendor = section.settings.show_vendor
%}

<div
  id="section-{{ section.id }}"
  class="pmc color-{{ section.settings.color_scheme }}"
  style="
    --pmc-padding-top: {{ section.settings.padding-block-start }}px;
    --pmc-padding-bottom: {{ section.settings.padding-block-end }}px;
    --pmc-margin-top: {{ section.settings.margin-block-start }}px;
    --pmc-margin-bottom: {{ section.settings.margin-block-end }}px;
    --pmc-card-gap: {{ card_gap }}px;
    --pmc-image-radius: {{ section.settings.image_border_radius | default: 30 }}px;
    --pmc-card-radius: {{ section.settings.card_border_radius | default: 20 }}px;
  "
>
  <div class="pmc__container {% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
    <div class="pmc__grid">
      <div class="pmc__media">
        {% if image %}
          {% assign sizes_val = '(min-width: 1024px) 52vw, 100vw' %}
          {{
            image
            | image_url: width: image.width
            | image_tag:
              class: 'pmc__image',
              sizes: sizes_val,
              widths: '375,550,750,1100,1500',
              loading: 'lazy',
              alt: image.alt
          }}
        {% else %}
          <div class="pmc__image-placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'pmc__placeholder-svg' }}
          </div>
        {% endif %}
      </div>

      <div class="pmc__content">
        <div class="pmc__header">
          {% if heading != blank %}
            <h2 class="pmc__heading">{{ heading | escape }}</h2>
          {% endif %}
          {% if subtext != blank %}
            <p class="pmc__subtext">{{ subtext | escape }}</p>
          {% endif %}
        </div>

        {% if collection and collection.products.size > 0 %}
          <pcp-media-carousel class="pmc__carousel">
            <div class="pmc__track" ref="track">
              {% for product in collection.products limit: max_products %}
                <a href="{{ product.url }}" class="pmc__card">
                  <div class="pmc__card-image-wrapper">
                    {% if product.featured_image %}
                      {{ product.featured_image | image_url: width: 690 | image_tag: class: 'pmc__card-image', loading: 'lazy', alt: product.title }}
                    {% else %}
                      <div class="pmc__card-image-placeholder">
                        {{ 'product-1' | placeholder_svg_tag: 'pmc__placeholder-svg' }}
                      </div>
                    {% endif %}
                  </div>
                  <div class="pmc__card-info">
                    {% if show_vendor and product.vendor != blank %}
                      <span class="pmc__card-vendor">{{ product.vendor }}</span>
                    {% endif %}
                    <h3 class="pmc__card-title">{{ product.title | escape }}</h3>
                    <span class="pmc__card-price">{{ product.price | money }}</span>
                  </div>
                </a>
              {% endfor %}
            </div>
            <div class="pmc__dots" ref="dots" aria-label="Carousel pagination"></div>
          </pcp-media-carousel>
        {% else %}
          <p class="pmc__empty">No products found. Please select a collection in the theme editor.</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'pcp-media-with-collection.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .pmc {
    padding-block-start: var(--pmc-padding-top, 80px);
    padding-block-end: var(--pmc-padding-bottom, 80px);
    margin-block-start: var(--pmc-margin-top, 0px);
    margin-block-end: var(--pmc-margin-bottom, 0px);
  }

  .pmc__container {
    display: flex;
    flex-direction: column;
  }

  .pmc__grid {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media screen and (min-width: 1024px) {
    .pmc__grid {
      flex-direction: row;
      align-items: center;
      gap: 40px;
    }
  }

  /* Media / Image */
  .pmc__media {
    width: 100%;
    flex-shrink: 0;
  }

  @media screen and (min-width: 1024px) {
    .pmc__media {
      width: 52%;
    }
  }

  .pmc__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 745 / 676;
    object-fit: cover;
    border-radius: var(--pmc-image-radius, 30px);
  }

  .pmc__image-placeholder {
    width: 100%;
    aspect-ratio: 745 / 676;
    border-radius: var(--pmc-image-radius, 30px);
    overflow: hidden;
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pmc__placeholder-svg {
    width: 100%;
    height: auto;
  }

  /* Content */
  .pmc__content {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media screen and (min-width: 1024px) {
    .pmc__content {
      width: 48%;
    }
  }

  /* Header */
  .pmc__header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: center;
  }

  .pmc__heading {
    font-family: var(--font-heading--family);
    font-size: 40px;
    font-weight: 500;
    line-height: 48px;
    letter-spacing: 1.2px;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  @media screen and (max-width: 1023px) {
    .pmc__heading {
      font-size: 28px;
      line-height: 36px;
      letter-spacing: 0.8px;
    }
  }

  .pmc__subtext {
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 400;
    line-height: 26px;
    letter-spacing: 0;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  @media screen and (max-width: 1023px) {
    .pmc__subtext {
      font-size: 14px;
      line-height: 22px;
    }
  }

  /* Carousel */
  .pmc__carousel {
    display: block;
    position: relative;
  }

  .pmc__track {
    display: flex;
    gap: var(--pmc-card-gap, 20px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .pmc__track::-webkit-scrollbar {
    display: none;
  }

  /* Card */
  .pmc__card {
    flex: 0 0 calc((100% - var(--pmc-card-gap, 20px)) / 2);
    display: flex;
    flex-direction: column;
    background-color: #FFFFFF;
    border-radius: var(--pmc-card-radius, 20px);
    overflow: hidden;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s ease;
  }

  .pmc__card:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 1023px) {
    .pmc__card {
      flex: 0 0 85%;
    }
  }

  /* Card image */
  .pmc__card-image-wrapper {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--pmc-card-radius, 20px) var(--pmc-card-radius, 20px) 0 0;
  }

  .pmc__card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pmc__card-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f0f0f0;
  }

  /* Card info */
  .pmc__card-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 24px 20px;
  }

  .pmc__card-vendor {
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 400;
    line-height: 22px;
    letter-spacing: 0;
    text-transform: capitalize;
    color: #000000;
  }

  .pmc__card-title {
    font-family: var(--font-body--family);
    font-size: 18px;
    font-weight: 500;
    line-height: 28px;
    letter-spacing: -0.36px;
    margin: 0;
    color: #000000;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pmc__card-price {
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: 0;
    color: #000000;
    margin-block-start: 2px;
  }

  /* Pagination dots */
  .pmc__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    padding-block-start: 20px;
  }

  .pmc__dot {
    width: 10px;
    height: 10px;
    border-radius: 10px;
    background-color: #000000;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: width 0.2s ease;
  }

  .pmc__dot:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  .pmc__dot--active {
    width: 50px;
  }

  /* Empty state */
  .pmc__empty {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground));
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .pmc__track {
      scroll-behavior: auto;
    }

    .pmc__dot {
      transition: none;
    }

    .pmc__card {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Media with collection",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop all Skintelligence"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "botanical skin care with natural extracts that soothe skin"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Card options"
    },
    {
      "type": "number",
      "id": "max_products",
      "label": "Max products",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "number",
      "id": "card_gap",
      "label": "Card gap",
      "default": 20
    },
    {
      "type": "number",
      "id": "image_border_radius",
      "label": "Image border radius",
      "default": 30
    },
    {
      "type": "number",
      "id": "card_border_radius",
      "label": "Card border radius",
      "default": 20
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin-block-start",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin-block-end",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Media with collection"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
