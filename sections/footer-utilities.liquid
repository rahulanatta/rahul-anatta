<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  {{ section.shopify_attributes }}
>
  <div
    class="footer-bottom spacing-style"
    style="{% render 'spacing-style', settings: section.settings %} --border-width: {{ section.settings.divider_thickness }}px;"
  >
    <div class="footer-bottom__blocks">
      {% content_for 'blocks' %}
    </div>

    {% if section.settings.show_localization %}
      <div class="footer-bottom__locale">
        {% form 'localization', class: 'footer-bottom__locale-form' %}
          {% if section.settings.show_country %}
            <div class="footer-locale-pill footer-locale-pill--country">
              <span class="footer-locale-pill__flag">
                {{ localization.country | image_url: width: 40 | image_tag: width: 18, height: 18, loading: 'lazy', alt: localization.country.name, class: 'footer-locale-pill__flag-img' }}
              </span>
              <span class="footer-locale-pill__label">
                {{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})
              </span>
              <span class="footer-locale-pill__chevron" aria-hidden="true">
                <svg viewBox="0 0 10 6" width="10" height="6" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <select
                name="country_code"
                class="footer-locale-pill__select"
                aria-label="Select country"
                onchange="this.form.submit()"
              >
                {% for country in localization.available_countries %}
                  <option
                    value="{{ country.iso_code }}"
                    {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
                  >
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endif %}

          {% if section.settings.show_language and localization.available_languages.size > 1 %}
            <div class="footer-locale-pill footer-locale-pill--language">
              <span class="footer-locale-pill__label">
                {{ localization.language.endonym_name | capitalize }}
              </span>
              <span class="footer-locale-pill__chevron" aria-hidden="true">
                <svg viewBox="0 0 10 6" width="10" height="6" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <select
                name="language_code"
                class="footer-locale-pill__select"
                aria-label="Select language"
                onchange="this.form.submit()"
              >
                {% for language in localization.available_languages %}
                  <option
                    value="{{ language.iso_code }}"
                    {% if language.iso_code == localization.language.iso_code %}selected{% endif %}
                  >
                    {{ language.endonym_name | capitalize }}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endif %}
        {% endform %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    border-block-start: var(--border-width) solid var(--color-border);
    color: var(--color-foreground-muted);

    @media screen and (min-width: 750px) {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
    }
  }

  /* Copyright + policy area */
  .footer-bottom__blocks {
    flex: 1;
    min-width: 0;
    font-size: 12px;
    opacity: 0.5;
    text-align: center;
    color: var(--color-foreground);

    @media screen and (min-width: 750px) {
      text-align: start;
    }
  }

  .footer-bottom__blocks a {
    color: currentColor;
    text-decoration: underline;
  }

  /* Override copyright block styles for the smaller layout */
  .footer-bottom__blocks .footer-copyright,
  .footer-bottom__blocks .footer-policy-list {
    font-size: 12px;
    margin: 0;
  }

  /* Locale pills container */
  .footer-bottom__locale {
    flex-shrink: 0;
  }

  .footer-bottom__locale-form {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;

    @media screen and (min-width: 750px) {
      justify-content: flex-end;
    }
  }

  /* Individual pill */
  .footer-locale-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-inline: 10px;
    height: 29px;
    border: 1px solid #e3e3e3;
    border-radius: 30px;
    font-size: 12px;
    color: var(--color-foreground);
    cursor: pointer;
    white-space: nowrap;
    background: transparent;
  }

  .footer-locale-pill__flag-img {
    display: block;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .footer-locale-pill__label {
    font-size: 12px;
    line-height: 1;
  }

  .footer-locale-pill__chevron {
    display: flex;
    align-items: center;
    color: var(--color-foreground);
    flex-shrink: 0;
    opacity: 0.6;
  }

  /* Native select overlaid — invisible overlay triggers native dropdown */
  .footer-locale-pill__select {
    position: absolute;
    inset: 0;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    border: none;
    background: none;
    appearance: none;
  }

  .footer-locale-pill--country {
    min-width: 181px;
  }

  .footer-locale-pill--language {
    min-width: 90px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policies_and_links",
  "tag": "div",
  "class": "footer-utilities",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Country & Language"
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country & language",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "Show country selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    { "type": "footer-copyright" },
    { "type": "footer-policy-list" },
    { "type": "social-links" }
  ],
  "presets": [
    {
      "name": "t:names.policies_and_links",
      "category": "t:categories.footer",
      "blocks": {
        "copyright": { "type": "footer-copyright" },
        "policy_list": { "type": "footer-policy-list" }
      },
      "block_order": ["copyright", "policy_list"]
    }
  ]
}
{% endschema %}
