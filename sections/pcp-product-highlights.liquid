{% liquid
  assign max_products = section.settings.max_products | default: 4
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign card_image_sizes = '(min-width: 1024px) 30vw, 300px'
%}

<div
  id="section-{{ section.id }}"
  class="phl color-{{ section.settings.color_scheme }}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --phl-margin-top: {{ section.settings.margin-block-start }}px;
    --phl-margin-bottom: {{ section.settings.margin-block-end }}px;
    --phl-padding-inline-start: {{ section.settings.padding-inline-start }}px;
    --phl-padding-inline-end: {{ section.settings.padding-inline-end }}px;
  "
>
  <pcp-product-highlights class="phl__container {% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
    <div class="phl__sidebar">
      {% if eyebrow != blank or heading != blank %}
        <div class="phl__header">
          {% if eyebrow != blank %}
            <span class="phl__eyebrow">{{ eyebrow }}</span>
          {% endif %}
          {% if heading != blank %}
            <h2 class="phl__heading">{{ heading }}</h2>
          {% endif %}
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        {%- comment -%} Mobile dropdown {%- endcomment -%}
        <div class="phl__dropdown-wrapper">
          <select class="phl__dropdown" aria-label="{{ heading | default: 'Category' | escape }}">
            {% for block in section.blocks %}
              <option value="{{ forloop.index0 }}"{% if forloop.first %} selected{% endif %}>
                {{ block.settings.title | escape }}
              </option>
            {% endfor %}
          </select>
          <svg class="phl__dropdown-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 7.5L10 12.5L15 7.5" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        {%- comment -%} Desktop tablist {%- endcomment -%}
        <div class="phl__tablist" role="tablist" aria-label="{{ heading | default: 'Category tabs' | escape }}">
          {% for block in section.blocks %}
            <button
              type="button"
              role="tab"
              class="phl__tab{% if forloop.first %} phl__tab--active{% endif %}"
              id="phl-tab-{{ section.id }}-{{ forloop.index0 }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="phl-panel-{{ section.id }}-{{ forloop.index0 }}"
              data-index="{{ forloop.index0 }}"
              data-description="{{ block.settings.description | escape }}"
              on:click="/handleTabClick"
              {{ block.shopify_attributes }}
            >
              <span class="phl__tab-title">{{ block.settings.title }}</span>
              {% if block.settings.description != blank %}
                <span class="phl__tab-desc">{{ block.settings.description }}</span>
              {% endif %}
            </button>
          {% endfor %}
        </div>

        {%- comment -%} Mobile description {%- endcomment -%}
        {% assign first_desc = section.blocks[0].settings.description %}
        {% if first_desc != blank %}
          <p class="phl__mobile-desc">{{ first_desc }}</p>
        {% else %}
          <p class="phl__mobile-desc" hidden></p>
        {% endif %}
      {% endif %}
    </div>

    <div class="phl__panels">
      {% for block in section.blocks %}
        {% assign block_collection = block.settings.collection %}
        <div
          role="tabpanel"
          class="phl__panel"
          id="phl-panel-{{ section.id }}-{{ forloop.index0 }}"
          aria-labelledby="phl-tab-{{ section.id }}-{{ forloop.index0 }}"
          data-panel-index="{{ forloop.index0 }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          {% if block_collection and block_collection.products.size > 0 %}
            {% assign product_count = block_collection.products.size %}
            {% if product_count > max_products %}
              {% assign product_count = max_products %}
            {% endif %}
            {% assign col1_limit = product_count | plus: 1 | divided_by: 2 %}
            {% assign col2_limit = product_count | minus: col1_limit %}

            <div class="phl__grid">
              <div class="phl__grid-col">
                {% for product in block_collection.products limit: col1_limit %}
                  <div class="phl-card">
                    <a href="{{ product.url }}" class="phl-card__link" aria-label="{{ product.title | escape }}">
                      <span class="visually-hidden">{{ product.title | escape }}</span>
                    </a>
                    <div class="phl-card__image-wrapper">
                      {% if product.featured_image %}
                        {{
                          product.featured_image
                          | image_url: width: product.featured_image.width
                          | image_tag:
                            sizes: card_image_sizes,
                            widths: '300,375,450,600,750,900',
                            loading: 'lazy',
                            class: 'phl-card__image',
                            alt: product.title
                        }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'phl-card__image phl-card__placeholder' }}
                      {% endif %}
                    </div>
                    <div class="phl-card__info">
                      <div class="phl-card__thumb">
                        {% if product.featured_image %}
                          <img
                            src="{{ product.featured_image | image_url: width: 132 }}"
                            alt=""
                            width="66"
                            height="66"
                            loading="lazy"
                            class="phl-card__thumb-img"
                          >
                        {% endif %}
                      </div>
                      <div class="phl-card__info-content">
                        <h3 class="phl-card__title">{{ product.title | escape }}</h3>
                        <div class="phl-card__price-wrapper">
                          {% if product.compare_at_price > product.price %}
                            <span class="phl-card__price phl-card__price--sale">{{ product.price | money }}</span>
                            <span class="phl-card__compare-price">{{ product.compare_at_price | money }}</span>
                          {% elsif product.price_varies %}
                            <span class="phl-card__price">From {{ product.price_min | money }}</span>
                          {% else %}
                            <span class="phl-card__price">{{ product.price | money }}</span>
                          {% endif %}
                        </div>
                      </div>
                      <form action="/cart/add" method="post" class="phl-card__form" on:submit="/handleAddToCart">
                        <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit" class="phl-card__add-btn" aria-label="Add {{ product.title | escape }} to cart">
                          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <path d="M3.125 10H16.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M10 3.125V16.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                      </form>
                    </div>
                  </div>
                {% endfor %}
              </div>

              {% if col2_limit > 0 %}
                <div class="phl__grid-col phl__grid-col--offset">
                  {% for product in block_collection.products limit: col2_limit offset: col1_limit %}
                    <div class="phl-card">
                      <a href="{{ product.url }}" class="phl-card__link" aria-label="{{ product.title | escape }}">
                        <span class="visually-hidden">{{ product.title | escape }}</span>
                      </a>
                      <div class="phl-card__image-wrapper">
                        {% if product.featured_image %}
                          {{
                            product.featured_image
                            | image_url: width: product.featured_image.width
                            | image_tag:
                              sizes: card_image_sizes,
                              widths: '300,375,450,600,750,900',
                              loading: 'lazy',
                              class: 'phl-card__image',
                              alt: product.title
                          }}
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'phl-card__image phl-card__placeholder' }}
                        {% endif %}
                      </div>
                      <div class="phl-card__info">
                        <div class="phl-card__thumb">
                          {% if product.featured_image %}
                            <img
                              src="{{ product.featured_image | image_url: width: 132 }}"
                              alt=""
                              width="66"
                              height="66"
                              loading="lazy"
                              class="phl-card__thumb-img"
                            >
                          {% endif %}
                        </div>
                        <div class="phl-card__info-content">
                          <h3 class="phl-card__title">{{ product.title | escape }}</h3>
                          <div class="phl-card__price-wrapper">
                            {% if product.compare_at_price > product.price %}
                              <span class="phl-card__price phl-card__price--sale">{{ product.price | money }}</span>
                              <span class="phl-card__compare-price">{{ product.compare_at_price | money }}</span>
                            {% elsif product.price_varies %}
                              <span class="phl-card__price">From {{ product.price_min | money }}</span>
                            {% else %}
                              <span class="phl-card__price">{{ product.price | money }}</span>
                            {% endif %}
                          </div>
                        </div>
                        <form action="/cart/add" method="post" class="phl-card__form" on:submit="/handleAddToCart">
                          <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
                          <input type="hidden" name="quantity" value="1">
                          <button type="submit" class="phl-card__add-btn" aria-label="Add {{ product.title | escape }} to cart">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                              <path d="M3.125 10H16.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                              <path d="M10 3.125V16.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </button>
                        </form>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% else %}
            <p class="phl__empty">No products found. Please select a collection in the theme editor.</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </pcp-product-highlights>
</div>

<script src="{{ 'pcp-product-highlights.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  /* =========================================
     Product Highlights — Section
     ========================================= */
  .phl {
    padding-block-start: var(--padding-block-start, 64px);
    padding-block-end: var(--padding-block-end, 64px);
    padding-inline-start: var(--phl-padding-inline-start, 0px);
    padding-inline-end: var(--phl-padding-inline-end, 0px);
    margin-block-start: var(--phl-margin-top, 0px);
    margin-block-end: var(--phl-margin-bottom, 0px);
  }

  /* =========================================
     Container — two-column flex layout
     ========================================= */
  .phl__container {
    display: flex;
    gap: 0;
  }

  /* =========================================
     Sidebar
     ========================================= */
  .phl__sidebar {
    flex: 0 1 479px;
    max-width: 479px;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
    padding-inline-end: 30px;
  }

  .phl__header {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .phl__eyebrow {
    font-family: var(--font-body--family);
    font-size: 18px;
    font-weight: 500;
    line-height: 28px;
    text-transform: capitalize;
    color: rgb(var(--color-foreground));
    margin: 0;
  }

  .phl__heading {
    font-family: var(--font-heading--family);
    font-size: 40px;
    font-weight: 500;
    line-height: 48px;
    letter-spacing: -0.8px;
    color: rgb(var(--color-foreground));
    margin: 0;
  }

  /* =========================================
     Tab list (desktop)
     ========================================= */
  .phl__tablist {
    display: flex;
    flex-direction: column;
    gap: 30px;
    border-inline-start: 2px solid rgb(var(--color-foreground));
  }

  .phl__tab {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 4px 24px;
    border: none;
    background: none;
    cursor: pointer;
    text-align: start;
    border-radius: 24px;
    transition: background-color var(--animation-speed-slow, 0.2s) ease;
  }

  .phl__tab:hover {
    background-color: rgba(0, 0, 0, 0.03);
  }

  .phl__tab:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  .phl__tab-title {
    font-family: var(--font-heading--family);
    font-size: 22px;
    font-weight: 500;
    line-height: 32px;
    letter-spacing: -0.44px;
    color: rgb(var(--color-foreground));
  }

  .phl__tab-desc {
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 400;
    line-height: 26px;
    color: rgb(var(--color-foreground));
    display: none;
  }

  .phl__tab--active .phl__tab-desc {
    display: block;
  }

  /* =========================================
     Mobile dropdown (hidden on desktop)
     ========================================= */
  .phl__dropdown-wrapper {
    display: none;
  }

  .phl__mobile-desc {
    display: none;
  }

  /* =========================================
     Panels
     ========================================= */
  .phl__panels {
    flex: 1 1 0;
    min-width: 0;
  }

  .phl__panel[hidden] {
    display: none;
  }

  /* =========================================
     Staggered grid (desktop)
     ========================================= */
  .phl__grid {
    display: flex;
    gap: 31px;
  }

  .phl__grid-col {
    display: flex;
    flex-direction: column;
    gap: 31px;
    flex: 1;
    min-width: 0;
  }

  .phl__grid-col--offset {
    margin-block-start: 130px;
  }

  /* =========================================
     Product card
     ========================================= */
  .phl-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
  }

  .phl-card__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .phl-card__image-wrapper {
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .phl-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .phl-card__placeholder {
    width: 100%;
    height: 100%;
  }

  /* =========================================
     Floating info bar (desktop)
     ========================================= */
  .phl-card__info {
    position: absolute;
    bottom: 16px;
    inset-inline-start: 16px;
    inset-inline-end: 16px;
    height: 90px;
    border-radius: 10px;
    background: #ffffff;
    display: flex;
    align-items: center;
    padding: 12px;
    gap: 12px;
    z-index: 2;
  }

  .phl-card__thumb {
    flex-shrink: 0;
    width: 66px;
    height: 66px;
    border-radius: 6px;
    overflow: hidden;
  }

  .phl-card__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .phl-card__info-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .phl-card__title {
    font-family: var(--font-body--family);
    font-size: 18px;
    font-weight: 700;
    line-height: 28px;
    letter-spacing: -0.36px;
    color: #000000;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }

  .phl-card__price-wrapper {
    display: flex;
    flex-direction: row;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }

  .phl-card__price {
    font-family: var(--font-body--family);
    font-size: 18px;
    font-weight: 400;
    line-height: 24px;
    color: #060606;
  }

  .phl-card__price--sale {
    font-weight: 700;
    color: #D63A2F;
    font-size: 16px;
    line-height: 24px;
  }

  .phl-card__compare-price {
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 400;
    line-height: 26px;
    color: #666666;
    text-decoration: line-through;
  }

  .phl-card__form {
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }

  .phl-card__add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: #E9E9E9;
    border: 1px solid #E9E9E9;
    cursor: pointer;
    color: #000000;
    transition: opacity var(--animation-speed-slow, 0.2s) ease;
  }

  .phl-card__add-btn:hover {
    opacity: 0.8;
  }

  .phl-card__add-btn:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  .phl-card__add-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* =========================================
     Empty state
     ========================================= */
  .phl__empty {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground));
    padding: 40px 0;
  }

  /* =========================================
     Mobile — layout
     ========================================= */
  @media screen and (max-width: 1023px) {
    .phl__container {
      flex-direction: column;
      gap: 0;
    }

    .phl__sidebar {
      flex: none;
      max-width: none;
      min-width: 0;
      padding-inline-end: 0;
      gap: 24px;
      align-items: center;
      text-align: center;
    }

    .phl__header {
      gap: 12px;
      align-items: center;
    }

    .phl__heading {
      font-size: 32px;
      line-height: 38px;
      letter-spacing: -0.64px;
    }

    /* Hide desktop tablist on mobile */
    .phl__tablist {
      display: none;
    }

    /* Show mobile dropdown */
    .phl__dropdown-wrapper {
      display: flex;
      position: relative;
      width: 100%;
      align-items: center;
    }

    .phl__dropdown {
      appearance: none;
      -webkit-appearance: none;
      width: 100%;
      padding: 0 48px 0 16px;
      border: 1px solid #E6E6E6;
      border-radius: 29px;
      background: transparent;
      font-family: var(--font-body--family);
      font-size: 16px;
      font-weight: 500;
      line-height: 56px;
      height: 58px;
      color: #000000;
      cursor: pointer;
    }

    .phl__dropdown:focus-visible {
      outline: 2px solid rgb(var(--color-foreground));
      outline-offset: 2px;
    }

    .phl__dropdown-chevron {
      position: absolute;
      inset-inline-end: 16px;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
    }

    /* Show mobile description */
    .phl__mobile-desc {
      display: block;
      font-family: var(--font-body--family);
      font-size: 16px;
      font-weight: 400;
      line-height: 26px;
      color: rgb(var(--color-foreground));
      margin: 0;
      text-align: start;
    }

    .phl__mobile-desc[hidden] {
      display: none;
    }

    /* Panels area */
    .phl__panels {
      flex: none;
      margin-block-start: 24px;
    }

    /* Horizontal scroll carousel */
    .phl__grid {
      flex-direction: row;
      overflow-x: auto;
      gap: 8px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
    }

    .phl__grid::-webkit-scrollbar {
      display: none;
    }

    .phl__grid-col,
    .phl__grid-col--offset {
      display: contents;
    }

    .phl__grid-col--offset {
      margin-block-start: 0;
    }

    /* Mobile card */
    .phl-card {
      flex: 0 0 300px;
      scroll-snap-align: start;
      border-radius: 0;
      overflow: visible;
    }

    .phl-card__image-wrapper {
      border-radius: 16px;
      overflow: hidden;
      aspect-ratio: 300 / 399;
    }

    .phl-card__info {
      position: static;
      bottom: auto;
      inset-inline-start: auto;
      inset-inline-end: auto;
      height: auto;
      border-radius: 0;
      background: transparent;
      padding: 16px 12px 0 0;
      gap: 12px;
    }

    .phl-card__thumb {
      width: 52px;
      height: 52px;
    }

    .phl-card__title {
      font-size: 17.9px;
      font-weight: 700;
      line-height: 28px;
    }

    .phl-card__price {
      font-size: 16px;
      line-height: 24px;
    }

    /* Hide add-to-cart on mobile */
    .phl-card__form {
      display: none;
    }
  }

  /* =========================================
     Reduced motion
     ========================================= */
  @media (prefers-reduced-motion: reduce) {
    .phl__tab,
    .phl-card__add-btn {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Highlights",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find The Right Piece For You"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create Your Unique Style"
    },
    {
      "type": "number",
      "id": "max_products",
      "label": "Max products per tab",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin-block-start",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
