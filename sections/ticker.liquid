<script
  src="{{ 'marquee.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign gap = section.settings.gap
  assign bg_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign icon_size = section.settings.icon_size
  assign show_gradient = section.settings.show_gradient
  assign gradient_color = section.settings.gradient_color
  assign gradient_direction = section.settings.gradient_direction
  assign speed = section.settings.speed
%}

<div
  class="ticker"
  style="
    --ticker-text-color: {{ text_color }};
    --ticker-icon-size: {{ icon_size }}px;
    --ticker-font-size: 20px;
    {% if show_gradient %}
      background: linear-gradient({{ gradient_direction }}, {{ bg_color }}, {{ gradient_color }});
    {% else %}
      background-color: {{ bg_color }};
    {% endif %}
  "
>
  <marquee-component
    class="ticker__marquee section section--{{ section.settings.section_width }} spacing-style gap-style"
    style="
      {%- render 'spacing-style', settings: section.settings %};
      {% render 'gap-style', value: gap, name: 'ticker-gap' %}
      --marquee-direction: {{ section.settings.movement_direction }};
    "
    data-speed-factor="{{ speed }}"
    data-movement-direction="{{ section.settings.movement_direction }}"
  >
    <div
      class="marquee__wrapper"
      ref="wrapper"
    >
      <div
        class="marquee__content"
        ref="content"
      >
        <div
          class="marquee__repeated-items"
          ref="marqueeItems[]"
        >
          {% for block in section.blocks %}
            <div class="ticker__item" {{ block.shopify_attributes }}>
              <div class="ticker__icon-wrapper">
                {% render 'icon-or-image',
                  icon: block.settings.icon,
                  image_upload: block.settings.custom_icon,
                  width: 16,
                  class_name: 'ticker__icon'
                %}
              </div>
              <span class="ticker__text">{{ block.settings.text }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </marquee-component>
</div>

{% stylesheet %}
  .ticker {
    overflow: hidden;
  }

  .ticker__marquee {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .ticker__marquee .marquee__wrapper {
    display: flex;
    gap: var(--ticker-gap);
    width: fit-content;
    white-space: nowrap;
  }

  .ticker__marquee .marquee__content {
    min-width: max-content;
    display: flex;
    gap: var(--ticker-gap);
  }

  .ticker__marquee .marquee__repeated-items {
    min-width: max-content;
    display: flex;
    gap: var(--ticker-gap);
    align-items: center;
    justify-content: center;
  }

  @keyframes marquee-motion {
    to {
      transform: translate3d(calc(-50% - (var(--ticker-gap) / 2)), 0, 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ticker__marquee:not([data-disabled]) .marquee__wrapper {
      animation: marquee-motion var(--marquee-speed) linear infinite var(--marquee-direction);
    }
  }

  .ticker__item {
    display: flex;
    gap: 12px;
    align-items: center;
    white-space: nowrap;
  }

  .ticker__icon-wrapper {
    width: var(--ticker-icon-size, 32px);
    height: var(--ticker-icon-size, 32px);
    border-radius: 50%;
    border: 2px solid var(--ticker-text-color);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 6px;
  }

  .ticker__icon-wrapper svg {
    color: var(--ticker-text-color);
    fill: var(--ticker-text-color);
  }

  .ticker__icon-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ticker__text {
    font-size: var(--ticker-font-size, 20px);
    line-height: 26px;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--ticker-text-color);
    font-family: var(--font-body--family);
  }
{% endstylesheet %}

