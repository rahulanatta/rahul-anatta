{% liquid
  assign heading_tag = section.settings.heading_tag
  assign heading_size_class = section.settings.heading_size
  assign half_count = section.blocks.size | divided_by: 2.0 | ceil
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style key-ingredients"
  style="{%- render 'spacing-style', settings: section.settings -%}"
>
  <div class="key-ingredients__inner">

    {% if section.settings.heading != blank %}
      <{{ heading_tag }} class="key-ingredients__heading {{ heading_size_class }}">
        {{- section.settings.heading | escape -}}
      </{{ heading_tag }}>
    {% endif %}

    <div class="key-ingredients__layout">

      <div class="key-ingredients__column key-ingredients__column--left">
        {% for block in section.blocks %}
          {% if forloop.index <= half_count %}
            <div class="key-ingredients__item" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h3 class="key-ingredients__item-title">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="key-ingredients__item-description">{{ block.settings.description | escape }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="key-ingredients__center">
        {% if section.settings.center_image != blank %}
          {%- assign sizes_val = '(min-width: 1200px) 480px, (min-width: 1024px) 40vw, 90vw' -%}
          {{
            section.settings.center_image
            | image_url: width: section.settings.center_image.width
            | image_tag:
              sizes: sizes_val,
              widths: '400,600,800,1000',
              loading: 'lazy',
              class: 'key-ingredients__circle-img',
              alt: section.settings.center_image.alt
          }}
        {% else %}
          <div class="key-ingredients__circle-placeholder">
            {{ 'image' | placeholder_svg_tag: 'key-ingredients__placeholder-svg' }}
          </div>
        {% endif %}
      </div>

      <div class="key-ingredients__column key-ingredients__column--right">
        {% for block in section.blocks %}
          {% if forloop.index > half_count %}
            <div class="key-ingredients__item" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h3 class="key-ingredients__item-title">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="key-ingredients__item-description">{{ block.settings.description | escape }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

    </div>
  </div>
</div>

{% stylesheet %}
  .key-ingredients__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .key-ingredients__heading {
    margin: 0;
    text-align: center;
    color: var(--color-foreground-heading);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
  }

  .key-ingredients__layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .key-ingredients__column {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .key-ingredients__center {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .key-ingredients__circle-img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
  }

  .key-ingredients__circle-placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background-color: rgb(0 0 0 / 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .key-ingredients__placeholder-svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .key-ingredients__item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: center;
  }

  .key-ingredients__item-title {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-heading);
  }

  .key-ingredients__item-description {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-foreground);
    text-align: center;
  }

  @media screen and (max-width: 1023px) {
    .key-ingredients__inner {
      gap: 36px;
    }

    .key-ingredients__layout {
      display: flex;
      flex-direction: column;
      gap: 36px;
    }

    .key-ingredients__center {
      order: -1;
      max-width: 280px;
      margin: 0 auto;
      width: 100%;
    }

    .key-ingredients__column {
      gap: 28px;
    }

    .key-ingredients__item-description {
      font-size: 0.8125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Key Ingredients",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Key Ingredients"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Key Ingredients"
    }
  ]
}
{% endschema %}
