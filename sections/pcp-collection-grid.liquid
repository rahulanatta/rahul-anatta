{% liquid
  assign collection = section.settings.collection
  assign heading = section.settings.heading
  assign shop_all_label = section.settings.shop_all_label
  assign shop_all_url = section.settings.shop_all_url
  assign max_products = section.settings.max_products | default: 8
  assign card_gap = section.settings.card_gap | default: 16
%}

<div
  id="section-{{ section.id }}"
  class="pcg-grid color-{{ section.settings.color_scheme }}"
  style="
    --pcg-padding-top: {{ section.settings.padding-block-start }}px;
    --pcg-padding-bottom: {{ section.settings.padding-block-end }}px;
    --pcg-margin-top: {{ section.settings.margin-block-start }}px;
    --pcg-margin-bottom: {{ section.settings.margin-block-end }}px;
    --pcg-card-gap: {{ card_gap }}px;
    --pcg-columns-desktop: {{ section.settings.columns_desktop }};
    --pcg-columns-mobile: {{ section.settings.columns_mobile }};
  "
>
  <div class="pcg-grid__container {% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
    <div class="pcg-grid__header">
      <h2 class="pcg-grid__heading">{{ heading }}</h2>
      {% if shop_all_url != blank %}
        <a href="{{ shop_all_url }}" class="pcg-grid__shop-all">
          {{ shop_all_label }}
        </a>
      {% elsif collection %}
        <a href="{{ collection.url }}" class="pcg-grid__shop-all">
          {{ shop_all_label }}
        </a>
      {% endif %}
    </div>

    {% if collection and collection.products.size > 0 %}
      <div class="pcg-grid__products">
        {% for product in collection.products limit: max_products %}
          {% render 'pcp-product-card',
            product: product,
            section_id: section.id,
            show_vendor: section.settings.show_vendor,
            show_reviews: section.settings.show_reviews,
            show_cashback: section.settings.show_cashback,
            show_add_to_cart: section.settings.show_add_to_cart
          %}
        {% endfor %}
      </div>
    {% else %}
      <p class="pcg-grid__empty">No products found. Please select a collection in the theme editor.</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .pcg-grid {
    padding-block-start: var(--pcg-padding-top, 48px);
    padding-block-end: var(--pcg-padding-bottom, 48px);
    margin-block-start: var(--pcg-margin-top, 0px);
    margin-block-end: var(--pcg-margin-bottom, 0px);
  }

  .pcg-grid__container {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pcg-grid__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-inline: 4px;
  }

  .pcg-grid__heading {
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xl);
    font-weight: 400;
    line-height: 26px;
    letter-spacing: 0;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  .pcg-grid__shop-all {
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    font-weight: 300;
    line-height: 18px;
    text-decoration: underline;
    color: rgb(var(--color-foreground));
  }

  .pcg-grid__shop-all:hover {
    opacity: 0.7;
  }

  /* Product grid */
  .pcg-grid__products {
    display: grid;
    grid-template-columns: repeat(var(--pcg-columns-mobile, 2), 1fr);
    gap: var(--pcg-card-gap, 16px);
  }

  @media screen and (min-width: 1024px) {
    .pcg-grid__products {
      grid-template-columns: repeat(var(--pcg-columns-desktop, 4), 1fr);
    }
  }

  /* Override carousel fixed card widths for grid context */
  .pcg-grid .ppc-card {
    min-width: unset;
    max-width: unset;
    width: 100%;
  }

  .pcg-grid__empty {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground));
  }

  @media (prefers-reduced-motion: reduce) {
    .pcg-grid .ppc-card__add-btn {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Necklaces"
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop all label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "shop_all_url",
      "label": "Shop all link"
    },
    {
      "type": "number",
      "id": "max_products",
      "label": "Max products",
      "default": 8
    },
    {
      "type": "header",
      "content": "Card options"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show reviews",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cashback",
      "label": "Show cashback",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "number",
      "id": "card_gap",
      "label": "Card gap",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin-block-start",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin-block-end",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Collection Grid"
    }
  ]
}
{% endschema %}
