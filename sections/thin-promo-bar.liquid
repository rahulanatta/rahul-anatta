<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style thin-promo-bar"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --tpb-gap: {{ section.settings.gap }}px;
    --tpb-text-alignment: {{ section.settings.text_alignment }};
  "
>
  <div class="thin-promo-bar__container">
    {% if section.settings.heading != blank %}
      <{{ section.settings.heading_tag }} class="thin-promo-bar__heading">
        {{- section.settings.heading | escape -}}
      </{{ section.settings.heading_tag }}>
    {% endif %}

    {% if section.settings.subtext != blank %}
      <p class="thin-promo-bar__subtext">
        {{- section.settings.subtext | escape -}}
      </p>
    {% endif %}

    {% if section.settings.cta_label != blank and section.settings.cta_url != blank %}
      <a href="{{ section.settings.cta_url }}" class="thin-promo-bar__cta">
        {{- section.settings.cta_label | escape -}}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .thin-promo-bar__container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--tpb-gap, 16px);
    text-align: var(--tpb-text-alignment, center);
    flex-wrap: wrap;
  }

  .thin-promo-bar__heading {
    font-family: var(--font-heading--family);
    font-size: 16px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--color-foreground);
    margin: 0;
  }

  .thin-promo-bar__subtext {
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-foreground);
    margin: 0;
  }

  .thin-promo-bar__cta {
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity var(--animation-speed-slow, 0.3s) ease;
  }

  .thin-promo-bar__cta:hover {
    opacity: 0.75;
  }

  @media screen and (max-width: 749px) {
    .thin-promo-bar__container {
      flex-direction: column;
      gap: calc(var(--tpb-gap, 16px) * 0.5);
    }

    .thin-promo-bar__heading {
      font-size: 14px;
    }

    .thin-promo-bar__subtext {
      font-size: 13px;
    }

    .thin-promo-bar__cta {
      font-size: 13px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Thin promo bar",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Limited Time Offer — Shop Now & Save"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Thin promo bar",
      "category": "t:categories.text"
    }
  ]
}
{% endschema %}
