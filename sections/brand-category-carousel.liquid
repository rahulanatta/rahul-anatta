{% liquid
  assign section_width = section.settings.section_width
  assign heading = section.settings.heading
  assign heading_tag = section.settings.heading_tag
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section_width }} color-{{ section.settings.color_scheme }} spacing-style brand-category-carousel"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
  "
>
  {% if heading != blank or section.blocks.size > 0 %}
    <brand-category-carousel>
      <div class="brand-category-carousel__header">
        {% if heading != blank %}
          <{{ heading_tag }} class="brand-category-carousel__heading">
            {{ heading | escape }}
          </{{ heading_tag }}>
        {% endif %}

        <div class="brand-category-carousel__arrows" ref="arrowsWrap">
          <button
            type="button"
            class="brand-category-carousel__arrow brand-category-carousel__arrow--prev"
            ref="prevBtn"
            aria-label="Previous"
            on:click="/handlePrev"
            disabled
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="brand-category-carousel__arrow brand-category-carousel__arrow--next"
            ref="nextBtn"
            aria-label="Next"
            on:click="/handleNext"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>

      {% if section.blocks.size > 0 %}
        <div class="brand-category-carousel__track" ref="track">
          {% for block in section.blocks %}
            {% if block.type == 'brand-card' %}
              <a
                href="{{ block.settings.link | default: '#' }}"
                class="brand-category-carousel__card"
                {{ block.shopify_attributes }}
              >
                <div class="brand-category-carousel__image-wrap">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: block.settings.image.width
                      | image_tag:
                        widths: '160,250,320,500',
                        sizes: '(min-width: 1024px) 250px, 160px',
                        loading: 'lazy',
                        class: 'brand-category-carousel__image',
                        alt: block.settings.title
                    }}
                  {% else %}
                    <div class="brand-category-carousel__placeholder">
                      {{ 'collection-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                {% if block.settings.title != blank %}
                  <span class="brand-category-carousel__title">
                    {{ block.settings.title | escape }}
                  </span>
                {% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </brand-category-carousel>
  {% endif %}
</div>

<script src="{{ 'brand-category-carousel.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .brand-category-carousel {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .brand-category-carousel__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .brand-category-carousel__heading {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 34px;
    line-height: 37px;
    letter-spacing: 0;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  .brand-category-carousel__arrows {
    display: flex;
    gap: 4px;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-category-carousel__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    padding: 0;
    transition: opacity var(--animation-speed, 0.125s) ease;
  }

  .brand-category-carousel__arrow:hover:not(:disabled) {
    opacity: 0.7;
  }

  .brand-category-carousel__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .brand-category-carousel__arrow:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .brand-category-carousel__arrow svg {
    display: block;
    width: 24px;
    height: 24px;
  }

  .brand-category-carousel__track {
    display: flex;
    overflow-x: auto;
    gap: 20px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .brand-category-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .brand-category-carousel__card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex-shrink: 0;
    text-decoration: none;
    color: var(--color-foreground);
    scroll-snap-align: start;
  }

  .brand-category-carousel__image-wrap {
    width: 250px;
    height: 250px;
    border-radius: 14px;
    background-color: #F8F8F8;
    overflow: hidden;
    flex-shrink: 0;
  }

  .brand-category-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .brand-category-carousel__card:hover .brand-category-carousel__image {
    transform: scale(1.05);
  }

  .brand-category-carousel__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground);
    opacity: 0.3;
  }

  .brand-category-carousel__placeholder svg {
    width: 80px;
    height: 80px;
  }

  .brand-category-carousel__title {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 20px;
    line-height: 20px;
    text-transform: capitalize;
    color: var(--color-foreground);
  }

  @media screen and (max-width: 1023px) {
    .brand-category-carousel__heading {
      font-size: 24px;
      line-height: 28px;
    }

    .brand-category-carousel__track {
      gap: 12px;
    }

    .brand-category-carousel__card {
      gap: 12px;
    }

    .brand-category-carousel__image-wrap {
      width: 160px;
      height: 160px;
    }

    .brand-category-carousel__title {
      font-size: 16px;
      line-height: 18px;
    }

    .brand-category-carousel__arrow {
      width: 36px;
      height: 36px;
    }

    .brand-category-carousel__arrow svg {
      width: 20px;
      height: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-category-carousel__image {
      transition: none;
    }

    .brand-category-carousel__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand category carousel",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "brand-card",
      "name": "Brand card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Brand image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Brand name",
          "default": "Brand"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Brand category carousel"
    }
  ]
}
{% endschema %}
