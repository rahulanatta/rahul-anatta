{% liquid
  assign heading_tag = section.settings.heading_tag | default: 'h2'
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style what-people-are-saying"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --wpas-margin-top: {{ section.settings.margin-block-start }}px;
    --wpas-margin-bottom: {{ section.settings.margin-block-end }}px;
    --wpas-columns: {{ section.settings.columns_desktop }};
    --wpas-gap: {{ section.settings.gap }}px;
    --wpas-card-radius: {{ section.settings.card_corner_radius }}px;
    --wpas-image-radius: {{ section.settings.image_border_radius }}px;
  "
>
  {% if section.settings.heading != blank %}
    <{{ heading_tag }} class="what-people-are-saying__heading">
      {{- section.settings.heading | escape -}}
    </{{ heading_tag }}>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <what-people-are-saying class="what-people-are-saying__wrapper">
      <div class="what-people-are-saying__grid" ref="track">
        {% for block in section.blocks %}
          <div class="what-people-are-saying__card{% if section.settings.show_card_border %} what-people-are-saying__card--bordered{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img
                class="what-people-are-saying__card-image"
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.image.alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {% endif %}

            <div class="what-people-are-saying__stars">
              {% assign star_count = block.settings.star_count | default: 5 %}
              {% for i in (1..5) %}
                {% if i <= star_count %}
                  <svg class="what-people-are-saying__star what-people-are-saying__star--filled" width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M10 1.25L12.47 7.025L18.75 7.6125L13.9625 11.725L15.4375 17.8625L10 14.5125L4.5625 17.8625L6.0375 11.725L1.25 7.6125L7.53 7.025L10 1.25Z" fill="currentColor"/>
                  </svg>
                {% else %}
                  <svg class="what-people-are-saying__star what-people-are-saying__star--empty" width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M10 1.25L12.47 7.025L18.75 7.6125L13.9625 11.725L15.4375 17.8625L10 14.5125L4.5625 17.8625L6.0375 11.725L1.25 7.6125L7.53 7.025L10 1.25Z" stroke="currentColor" stroke-width="1"/>
                  </svg>
                {% endif %}
              {% endfor %}
            </div>

            {% if block.settings.review_text != blank %}
              <p class="what-people-are-saying__text">{{ block.settings.review_text | escape }}</p>
            {% endif %}

            <div class="what-people-are-saying__reviewer">
              {% if block.settings.reviewer_image != blank %}
                <img
                  class="what-people-are-saying__reviewer-image"
                  src="{{ block.settings.reviewer_image | image_url: width: 96 }}"
                  alt="{{ block.settings.reviewer_name | escape }}"
                  width="48"
                  height="48"
                  loading="lazy"
                >
              {% endif %}
              {% if block.settings.reviewer_name != blank %}
                <span class="what-people-are-saying__reviewer-name">{{ block.settings.reviewer_name | escape }}</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      {% if section.blocks.size > 1 %}
        <div class="what-people-are-saying__nav">
          <button
            type="button"
            class="what-people-are-saying__nav-btn what-people-are-saying__nav-btn--prev"
            ref="prevButton"
            aria-label="Previous review"
            on:click="/handlePrev"
            disabled
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="what-people-are-saying__dots">
            {% for block in section.blocks %}
              <span
                class="what-people-are-saying__dot{% if forloop.first %} what-people-are-saying__dot--active{% endif %}"
                aria-hidden="true"
              ></span>
            {% endfor %}
          </div>

          <button
            type="button"
            class="what-people-are-saying__nav-btn what-people-are-saying__nav-btn--next"
            ref="nextButton"
            aria-label="Next review"
            on:click="/handleNext"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </what-people-are-saying>
  {% endif %}
</div>

<script src="{{ 'what-people-are-saying.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .what-people-are-saying {
    margin-block-start: var(--wpas-margin-top, 0px);
    margin-block-end: var(--wpas-margin-bottom, 0px);
  }

  .what-people-are-saying__heading {
    margin: 0 0 32px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 500);
    font-size: 32px;
    line-height: 42px;
    letter-spacing: -0.8px;
    color: var(--color-foreground-heading);
    text-align: center;
  }

  .what-people-are-saying__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .what-people-are-saying__grid {
    display: grid;
    grid-template-columns: repeat(var(--wpas-columns, 3), 1fr);
    gap: var(--wpas-gap, 24px);
    width: 100%;
  }

  .what-people-are-saying__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 32px 24px;
    border-radius: var(--wpas-card-radius, 16px);
    background-color: var(--color-background);
  }

  .what-people-are-saying__card-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--wpas-image-radius, 8px);
  }

  .what-people-are-saying__card--bordered {
    border: 1px solid var(--color-border);
  }

  .what-people-are-saying__stars {
    display: flex;
    justify-content: center;
    gap: 2px;
    color: #141414;
  }

  .what-people-are-saying__star--empty {
    color: rgb(var(--color-foreground-rgb) / 0.25);
  }

  .what-people-are-saying__text {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-size--lg);
    font-weight: 500;
    line-height: 26px;
    text-align: center;
    color: #141414;
  }

  .what-people-are-saying__reviewer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .what-people-are-saying__reviewer-image {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .what-people-are-saying__reviewer-name {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    font-weight: 500;
    line-height: 21px;
    text-align: center;
    color: #141414;
  }

  /* ---- Navigation (mobile only) ---- */

  .what-people-are-saying__nav {
    display: none;
    align-items: center;
    gap: 32px;
  }

  .what-people-are-saying__nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 50%;
    background: transparent;
    color: #141414;
    cursor: pointer;
    transition: opacity var(--animation-speed) ease;
    border: 1px solid #141414;
  }

  .what-people-are-saying__nav-btn--prev {
    border-color: #828282;
    color: #828282;
  }

  .what-people-are-saying__nav-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .what-people-are-saying__nav-btn:focus-visible {
    outline: 2px solid #141414;
    outline-offset: 2px;
  }

  .what-people-are-saying__dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .what-people-are-saying__dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #c9c9c9;
    transition: background-color var(--animation-speed) ease;
  }

  .what-people-are-saying__dot--active {
    background-color: #000000;
  }

  /* ---- Mobile ---- */

  @media screen and (max-width: 749px) {
    .what-people-are-saying__heading {
      font-size: 24px;
      line-height: 31px;
    }

    .what-people-are-saying__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .what-people-are-saying__grid::-webkit-scrollbar {
      display: none;
    }

    .what-people-are-saying__card {
      min-width: 85%;
      scroll-snap-align: start;
      flex-shrink: 0;
    }

    .what-people-are-saying__nav {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .what-people-are-saying__grid {
      scroll-behavior: auto;
    }

    .what-people-are-saying__nav-btn,
    .what-people-are-saying__dot {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "What people are saying",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What people are saying"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_card_border",
      "label": "Show card border",
      "default": false
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Margin"
    },
    {
      "type": "range",
      "id": "margin-block-start",
      "label": "Top margin",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin-block-end",
      "label": "Bottom margin",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "review-card",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "star_count",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "This product is amazing! Highly recommended."
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer name",
          "default": "-Customer"
        },
        {
          "type": "image_picker",
          "id": "reviewer_image",
          "label": "Reviewer image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "What people are saying",
      "category": "t:categories.text",
      "blocks": [
        {
          "type": "review-card",
          "settings": {
            "star_count": 5,
            "review_text": "Love the colors. Creamy, moisturizing and the color stays. Especially love the lid. It's magnetic.",
            "reviewer_name": "-Nancy W"
          }
        },
        {
          "type": "review-card",
          "settings": {
            "star_count": 5,
            "review_text": "Great quality and fast shipping. I've been using this for a month and love the results! Highly recommend.",
            "reviewer_name": "-Sarah M"
          }
        },
        {
          "type": "review-card",
          "settings": {
            "star_count": 5,
            "review_text": "Exceeded my expectations. The texture is perfect and it works wonders. Will definitely buy again.",
            "reviewer_name": "-James K"
          }
        }
      ]
    }
  ]
}
{% endschema %}
