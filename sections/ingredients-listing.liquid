{% liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign show_breadcrumb = section.settings.show_breadcrumb
  assign breadcrumb_parent_1_text = section.settings.breadcrumb_parent_1_text
  assign breadcrumb_parent_2_text = section.settings.breadcrumb_parent_2_text
%}

<ingredient-drawer-component>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style ingredients-listing"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --il-heading-font-size: {{ section.settings.heading_font_size }}px;
    --il-heading-line-height: {{ section.settings.heading_line_height }}px;
    --il-heading-font-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
    --il-heading-line-height-mobile: {{ section.settings.heading_line_height_mobile }}px;
    --il-desc-font-size: {{ section.settings.description_font_size }}px;
    --il-desc-line-height: {{ section.settings.description_line_height }}px;
    --il-desc-font-size-mobile: {{ section.settings.description_font_size_mobile }}px;
    --il-desc-line-height-mobile: {{ section.settings.description_line_height_mobile }}px;
    --il-grid-gap: {{ section.settings.grid_gap }}px;
    --il-grid-row-gap: {{ section.settings.grid_row_gap }}px;
    --il-card-border-radius: {{ section.settings.card_border_radius }}px;
    --il-ingredient-title-font-size: {{ section.settings.ingredient_title_font_size }}px;
    --il-card-gap: {{ section.settings.card_gap }}px;
    --il-breadcrumb-font-size: {{ section.settings.breadcrumb_font_size }}px;
    --il-heading-text-transform: {{ section.settings.heading_text_transform }};
    --il-heading-text-align: {{ section.settings.heading_text_alignment }};
  "
>
  {% if show_breadcrumb %}
    <nav class="ingredients-listing__breadcrumb" aria-label="Breadcrumb">
      <ol class="ingredients-listing__breadcrumb-list">
        {% if breadcrumb_parent_1_text != blank %}
          <li class="ingredients-listing__breadcrumb-item">
            <a href="{{ section.settings.breadcrumb_parent_1_url }}" class="ingredients-listing__breadcrumb-link">{{ breadcrumb_parent_1_text }}</a>
          </li>
          <li class="ingredients-listing__breadcrumb-separator" aria-hidden="true">/</li>
        {% endif %}
        {% if breadcrumb_parent_2_text != blank %}
          <li class="ingredients-listing__breadcrumb-item">
            <a href="{{ section.settings.breadcrumb_parent_2_url }}" class="ingredients-listing__breadcrumb-link">{{ breadcrumb_parent_2_text }}</a>
          </li>
          <li class="ingredients-listing__breadcrumb-separator" aria-hidden="true">/</li>
        {% endif %}
        <li class="ingredients-listing__breadcrumb-item ingredients-listing__breadcrumb-item--current" aria-current="page">
          {{ page.title }}
        </li>
      </ol>
    </nav>
  {% endif %}

  {% if heading != blank %}
    <{{ section.settings.heading_tag }} class="ingredients-listing__heading">{{ heading }}</{{ section.settings.heading_tag }}>
  {% endif %}

  {% if description != blank %}
    <p class="ingredients-listing__description">{{ description }}</p>
  {% endif %}

  {% liquid
    assign filter_blocks = section.blocks | where: 'type', 'category-filter'
    assign card_blocks = section.blocks | where: 'type', 'ingredient-card'
  %}

  {% if filter_blocks.size > 0 %}
    <div class="ingredients-listing__filters" role="tablist" aria-label="Filter ingredients by category">
      {% for block in filter_blocks %}
        <button
          class="ingredients-listing__filter-pill{% if forloop.first %} is-active{% endif %}"
          data-filter-value="{{ block.settings.filter_value | handleize }}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label }}
        </button>
      {% endfor %}
    </div>
  {% endif %}

  {% if card_blocks.size > 0 %}
    <div class="ingredients-listing__grid">
      {% for block in card_blocks %}
        {% liquid
          assign card_category = block.settings.category | handleize
        %}
        <div
          class="ingredients-listing__card"
          data-category="{{ card_category }}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.ingredient_handle != blank %}
            <button type="button" data-ingredient-drawer="{{ block.id }}" class="ingredients-listing__card-link ingredients-listing__card-link--drawer">
          {% elsif block.settings.url != blank %}
            <a href="{{ block.settings.url }}" class="ingredients-listing__card-link">
          {% endif %}

          {% if block.settings.image != blank %}
            {%- assign sizes_val = '(min-width: 1024px) 210px, calc(50vw - 24px)' -%}
            {{
              block.settings.image
              | image_url: width: block.settings.image.width
              | image_tag:
                widths: '210,420,630',
                sizes: sizes_val,
                loading: 'lazy',
                class: 'ingredients-listing__card-image',
                alt: block.settings.title
            }}
          {% else %}
            <div class="ingredients-listing__card-image ingredients-listing__card-image--placeholder">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <span class="ingredients-listing__card-title">{{ block.settings.title }} &rarr;</span>

          {% if block.settings.ingredient_handle != blank %}
            </button>
          {% elsif block.settings.url != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% comment %} Drawer templates: content pulled from the `ingredient` metaobject (title, description, image) {% endcomment %}
{% for block in card_blocks %}
  {%- if block.settings.ingredient_handle != blank -%}
    {%- assign ingredient_mo = shop.metaobjects.ingredient[block.settings.ingredient_handle] -%}
    {%- if ingredient_mo -%}
      <template data-ingredient="{{ block.id }}" data-title="{{ ingredient_mo.title.value | default: block.settings.title | escape }}">
        <div class="ingredient-drawer__content">

          {%- if ingredient_mo.image.value != blank -%}
            <img
              src="{{ ingredient_mo.image.value | image_url: width: 1080 }}"
              alt="{{ ingredient_mo.title.value | escape }}"
              class="ingredient-drawer__main-image"
              loading="lazy"
              width="540"
              height="297"
            >
          {%- elsif block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 1080 }}"
              alt="{{ ingredient_mo.title.value | escape }}"
              class="ingredient-drawer__main-image"
              loading="lazy"
              width="540"
              height="297"
            >
          {%- endif -%}

          {%- if ingredient_mo.title.value != blank -%}
            <h2 class="ingredient-drawer__name">{{ ingredient_mo.title.value | escape }}</h2>
          {%- endif -%}

          {%- if ingredient_mo.description.value != blank -%}
            <p class="ingredient-drawer__description">{{ ingredient_mo.description.value | escape }}</p>
          {%- endif -%}

        </div>
      </template>
    {%- endif -%}
  {%- endif -%}
{% endfor %}

{% render 'ingredient-drawer' %}

<script src="{{ 'ingredient-drawer.js' | asset_url }}" type="module"></script>
</ingredient-drawer-component>

<script>
  (function() {
    const section = document.querySelector('.ingredients-listing');
    if (!section) return;

    const filters = section.querySelectorAll('.ingredients-listing__filter-pill');
    const cards = section.querySelectorAll('.ingredients-listing__card');

    if (!filters.length || !cards.length) return;

    for (const pill of filters) {
      pill.addEventListener('click', function() {
        const activeFilter = section.querySelector('.ingredients-listing__filter-pill.is-active');

        if (activeFilter) {
          activeFilter.classList.remove('is-active');
          activeFilter.setAttribute('aria-selected', 'false');
        }

        this.classList.add('is-active');
        this.setAttribute('aria-selected', 'true');

        const filterValue = this.dataset.filterValue;

        for (const card of cards) {
          if (filterValue === 'view-all' || filterValue === '') {
            card.style.display = '';
          } else if (card.dataset.category === filterValue) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        }
      });
    }
  })();
</script>

{% stylesheet %}
  .ingredients-listing {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ingredients-listing__breadcrumb {
    width: 100%;
  }

  .ingredients-listing__breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .ingredients-listing__breadcrumb-link {
    font-family: var(--font-body--family);
    font-size: var(--il-breadcrumb-font-size, 14px);
    line-height: 16px;
    color: var(--color-foreground);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }

  .ingredients-listing__breadcrumb-separator {
    font-family: var(--font-body--family);
    font-size: calc(var(--il-breadcrumb-font-size, 14px) - 2px);
    line-height: 16px;
    color: var(--color-foreground);
  }

  .ingredients-listing__breadcrumb-item--current {
    font-family: var(--font-body--family);
    font-size: var(--il-breadcrumb-font-size, 14px);
    line-height: 16px;
    color: var(--color-foreground);
  }

  .ingredients-listing__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 400);
    font-size: var(--il-heading-font-size-mobile, 36px);
    line-height: var(--il-heading-line-height-mobile, 44px);
    text-transform: var(--il-heading-text-transform, none);
    text-align: var(--il-heading-text-align, left);
    color: var(--color-foreground-heading);
    margin: 0;

    @media screen and (min-width: 1024px) {
      font-size: var(--il-heading-font-size, 50px);
      line-height: var(--il-heading-line-height, 65px);
    }
  }

  .ingredients-listing__description {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: var(--il-desc-font-size-mobile, 18px);
    line-height: var(--il-desc-line-height-mobile, 26px);
    color: var(--color-foreground);
    margin: 0;
    max-width: 585px;

    @media screen and (min-width: 1024px) {
      font-size: var(--il-desc-font-size, 24px);
      line-height: var(--il-desc-line-height, 31px);
    }
  }

  .ingredients-listing__filters {
    display: flex;
    gap: 8px;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: thin;
    padding-block: 4px;
    -webkit-overflow-scrolling: touch;

    &::-webkit-scrollbar {
      height: 4px;
    }

    &::-webkit-scrollbar-thumb {
      background: var(--color-border);
      border-radius: 2px;
    }
  }

  .ingredients-listing__filter-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    border-radius: 12px;
    border: 1px solid #ACACAC;
    background: transparent;
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 16px;
    line-height: 21px;
    color: var(--color-foreground);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: border-color var(--animation-speed, 0.125s) ease;

    &:hover {
      border-color: var(--color-foreground);
    }

    &.is-active {
      border-color: var(--color-foreground);
    }
  }

  .ingredients-listing__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--il-grid-row-gap, 33px) var(--il-grid-gap, 33px);

    @media screen and (min-width: 600px) {
      grid-template-columns: repeat(3, 1fr);
    }

    @media screen and (min-width: 1024px) {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .ingredients-listing__card {
    display: flex;
    flex-direction: column;
    gap: var(--il-card-gap, 13px);
  }

  .ingredients-listing__card-link {
    display: flex;
    flex-direction: column;
    gap: var(--il-card-gap, 13px);
    text-decoration: none;
    color: inherit;
  }

  .ingredients-listing__card-image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--il-card-border-radius, 30px);
    display: block;
  }

  .ingredients-listing__card-image--placeholder {
    background: var(--color-border);
    border-radius: var(--il-card-border-radius, 30px);
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;

    & svg {
      width: 60%;
      height: 60%;
    }
  }

  .ingredients-listing__card-title {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: var(--il-ingredient-title-font-size, 22px);
    line-height: 29px;
    color: var(--color-foreground);
  }

  .ingredients-listing__card-link--drawer {
    appearance: none;
    background: none;
    text-align: start;
    cursor: pointer;
    padding: 0;
    border: none;
    color: inherit;
    font: inherit;
    width: 100%;
  }

  /* Ingredient Drawer Styles */
  .ingredient-drawer__dialog {
    width: 602px;
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: none;
    background: #FFFFFF;
  }

  .ingredient-drawer__dialog[open] {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .ingredient-drawer__dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  .ingredient-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    border-bottom: 1px solid #D3D3D3;
    position: sticky;
    top: 0;
    background: #FFFFFF;
    z-index: 1;
    flex-shrink: 0;
  }

  .ingredient-drawer__title {
    font-family: var(--font-body--family);
    font-size: 18px;
    line-height: 23px;
    color: #141414;
  }

  .ingredient-drawer__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ingredient-drawer__body {
    overflow-y: auto;
    flex: 1;
  }

  .ingredient-drawer__content {
    display: flex;
    flex-direction: column;
    gap: 34px;
    padding: 34px 30px 14px;
  }

  .ingredient-drawer__main-image {
    width: 100%;
    aspect-ratio: 540 / 297;
    object-fit: cover;
    border-radius: 22px;
    display: block;
  }

  .ingredient-drawer__products {
    display: flex;
    flex-direction: column;
    gap: 15px;
    overflow: hidden;
  }

  .ingredient-drawer__products-heading {
    font-family: var(--font-body--family);
    font-size: 24px;
    line-height: 31px;
    color: #141414;
    margin: 0;
  }

  .ingredient-drawer__products-grid {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .ingredient-drawer__product-card {
    flex: 0 0 138px;
    width: 138px;
    height: 138px;
    border-radius: 20px;
    border: 1px solid #E1E1E1;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .ingredient-drawer__product-image {
    max-width: 70%;
    max-height: 80%;
    object-fit: contain;
    border-radius: 16px;
  }

  .ingredient-drawer__tagline {
    font-family: var(--font-body--family);
    font-size: 24px;
    line-height: 31px;
    color: #141414;
    margin: 0;
  }

  .ingredient-drawer__benefits-heading {
    font-family: var(--font-body--family);
    font-size: 24px;
    line-height: 31px;
    color: #141414;
    margin: 0;
  }

  .ingredient-drawer__gallery {
    display: flex;
    gap: 16px;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .ingredient-drawer__gallery-thumb {
    flex: 0 0 80px;
    width: 80px;
    height: 80px;
    border-radius: 20px;
    object-fit: cover;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.2s;

    &.is-active {
      border-color: #000000;
    }
  }

  .ingredient-drawer__gallery-next {
    flex: 0 0 33px;
    width: 33px;
    height: 33px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid #535353;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }

  .ingredient-drawer__name {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 400);
    font-size: 28px;
    line-height: 36px;
    color: #141414;
    margin: 0;
  }

  .ingredient-drawer__description {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 21px;
    color: #141414;
    margin: 0;
    white-space: pre-line;
  }

  .ingredient-drawer__benefits-text {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 21px;
    color: #141414;
    margin: 0;
    white-space: pre-line;
  }

  .ingredient-drawer__banner {
    width: calc(100% + 60px);
    margin-inline: -30px;
    display: block;
    border-radius: 0;
  }

  @media screen and (max-width: 1023px) {
    .ingredient-drawer__dialog {
      width: 100%;
    }

    .ingredient-drawer__content {
      padding: 24px 16px 14px;
      gap: 24px;
    }

    .ingredient-drawer__main-image {
      aspect-ratio: 358 / 215;
    }

    .ingredient-drawer__product-card {
      flex: 0 0 107px;
      width: 107px;
      height: 107px;
      border-radius: 16px;
    }

    .ingredient-drawer__product-image {
      border-radius: 12px;
    }

    .ingredient-drawer__gallery-thumb {
      flex: 0 0 51px;
      width: 51px;
      height: 51px;
      border-radius: 12px;
    }

    .ingredient-drawer__gallery-next {
      flex: 0 0 21px;
      width: 21px;
      height: 21px;
    }

    .ingredient-drawer__gallery-thumb.is-active {
      border-width: 1px;
    }

    .ingredient-drawer__gallery {
      gap: 10px;
    }

    .ingredient-drawer__banner {
      width: calc(100% + 32px);
      margin-inline: -16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredients Listing",
  "tag": "section",
  "class": "ingredients-listing-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Advanced ingredients delivering real results"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Premium ingredients, optimized for impact. We source the highest quality compounds for maximum purity, delivering them through advanced liquid absorption so you never waste a drop of nutrition.*"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_parent_1_text",
      "label": "Parent 1 text",
      "default": "Home"
    },
    {
      "type": "url",
      "id": "breadcrumb_parent_1_url",
      "label": "Parent 1 link"
    },
    {
      "type": "text",
      "id": "breadcrumb_parent_2_text",
      "label": "Parent 2 text",
      "default": "Nutrition & Health"
    },
    {
      "type": "url",
      "id": "breadcrumb_parent_2_url",
      "label": "Parent 2 link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading line height",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 65
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size (mobile)",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_line_height_mobile",
      "label": "Heading line height (mobile)",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "select",
      "id": "heading_text_transform",
      "label": "Heading text transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "heading_text_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "Description size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "description_line_height",
      "label": "Description line height",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 31
    },
