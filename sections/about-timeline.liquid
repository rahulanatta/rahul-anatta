{% liquid
  assign section_width = section.settings.section_width
  assign color_scheme = section.settings.color_scheme
  assign image_border_radius = section.settings.image_border_radius
%}

<about-timeline-component
  class="section section--{{ section_width }} color-{{ color_scheme }} spacing-style about-timeline"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --at-image-radius: {{ image_border_radius }}px;
    --at-fill-width: 0%;
  "
>
  {%- comment -%} Layer 1: Media — stacked image slides with crossfade {%- endcomment -%}
  <div class="about-timeline__media">
    {% for block in section.blocks %}
      <div
        class="about-timeline__image-slide{% if forloop.first %} about-timeline__image-slide--active{% endif %}"
        data-index="{{ forloop.index0 }}"
      >
        {% if block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: block.settings.image.width
            | image_tag:
              sizes: '(min-width: 1200px) 1041px, 100vw',
              widths: '375,550,750,1041,1500',
              loading: 'lazy',
              class: 'about-timeline__image',
              alt: block.settings.image.alt
          }}
        {% else %}
          <div class="about-timeline__placeholder">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>
    {% endfor %}

    {% if section.blocks.size > 1 %}
      <button type="button" class="about-timeline__arrow about-timeline__arrow--prev" on:click="/handlePrev" aria-label="Previous year">
        <svg width="8" height="16" viewBox="0 0 8 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 1L1 8L7 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button type="button" class="about-timeline__arrow about-timeline__arrow--next" on:click="/handleNext" aria-label="Next year">
        <svg width="8" height="16" viewBox="0 0 8 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L7 8L1 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    {% endif %}
  </div>

  {% if section.blocks.size > 1 %}
    {%- comment -%} Layer 2: Controls — track with animated fill + year buttons {%- endcomment -%}
    <div class="about-timeline__controls">
      <div class="about-timeline__track">
        <div class="about-timeline__track-fill"></div>
      </div>

      <div class="about-timeline__year-buttons">
        {% for block in section.blocks %}
          <button
            type="button"
            class="about-timeline__year-btn{% if forloop.first %} about-timeline__year-btn--active{% endif %}"
            data-index="{{ forloop.index0 }}"
            on:click="/handleYearClick"
            aria-label="View {{ block.settings.year }}"
          >
            <span class="about-timeline__dot{% if forloop.first %} about-timeline__dot--active{% endif %}"></span>
            <span class="about-timeline__year-label">{{ block.settings.year | escape }}</span>
          </button>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {%- comment -%} Layer 3: Content — crossfade year / heading / description {%- endcomment -%}
  <div class="about-timeline__content">
    {% for block in section.blocks %}
      <div
        class="about-timeline__content-slide{% if forloop.first %} about-timeline__content-slide--active{% endif %}"
        data-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        <div class="about-timeline__year-display">
          <span class="about-timeline__year-large">{{ block.settings.year | escape }}</span>
        </div>
        <div class="about-timeline__text-content">
          {% if block.settings.heading != blank %}
            <h3 class="about-timeline__heading">{{ block.settings.heading | escape }}</h3>
          {% endif %}
          {% if block.settings.description != blank %}
            <div class="about-timeline__description">{{ block.settings.description }}</div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</about-timeline-component>

<script src="{{ 'about-timeline.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .about-timeline {
    position: relative;
  }

  /* ── Layer 1: Media — stacked image slides ── */
  .about-timeline__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--at-image-radius, 20px);
    aspect-ratio: 1041 / 468;
    cursor: grab;
  }

  .about-timeline__image-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .about-timeline__image-slide--active {
    opacity: 1;
    pointer-events: auto;
  }

  .about-timeline__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-timeline__placeholder {
    width: 100%;
    height: 100%;
    background-color: #f0f0f0;
  }

  .about-timeline__placeholder .placeholder-svg {
    width: 100%;
    height: 100%;
  }

  /* Arrows — inside media for correct vertical centering */
  .about-timeline__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background-color: #FFFFFF;
    border: 1.5px solid #333333;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0.3;
    color: #000000;
    transition: opacity 0.2s ease;
  }

  .about-timeline__arrow:hover {
    opacity: 0.6;
  }

  .about-timeline__arrow--prev {
    left: 12px;
  }

  .about-timeline__arrow--next {
    right: 12px;
  }

  .about-timeline__arrow:focus-visible {
    outline: 2px solid #171717;
    outline-offset: 2px;
    opacity: 0.6;
  }

  /* ── Layer 2: Controls — track + year buttons ── */
  .about-timeline__controls {
    position: relative;
    margin-top: 7px;
  }

  .about-timeline__track {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    height: 1px;
    background-color: #D4D4D4;
  }

  .about-timeline__track-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background-color: #171717;
    width: var(--at-fill-width, 0%);
    transition: width 0.4s ease;
  }

  .about-timeline__year-buttons {
    display: flex;
    justify-content: space-between;
    position: relative;
  }

  .about-timeline__year-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .about-timeline__dot {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: #FFFFFF;
    border: 1.67px solid #D4D4D4;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .about-timeline__dot--active {
    width: 20px;
    height: 20px;
    background-color: #171717;
    border-color: #171717;
  }

  .about-timeline__year-label {
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: 0.2px;
    text-align: center;
    color: #A1A1A1;
  }

  .about-timeline__year-btn--active .about-timeline__year-label {
    color: #171717;
  }

  /* ── Layer 3: Content — crossfade year / heading / description ── */
  .about-timeline__content {
    position: relative;
    margin-top: 22px;
  }

  .about-timeline__content-slide {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 38px;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s ease;
    pointer-events: none;
  }

  .about-timeline__content-slide--active {
    position: relative;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .about-timeline__year-display {
    flex-shrink: 0;
  }

  .about-timeline__year-large {
    font-family: var(--font-heading--family);
    font-size: 128px;
    font-weight: 700;
    line-height: 128px;
    color: #56AFD9;
  }

  .about-timeline__text-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-content: center;
  }

  .about-timeline__heading {
    font-family: var(--font-heading--family);
    font-size: 30px;
    font-weight: 500;
    line-height: 36px;
    letter-spacing: -0.35px;
    color: #171717;
    margin: 0;
  }

  .about-timeline__description {
    font-family: var(--font-body--family);
    font-size: 18px;
    font-weight: 400;
    line-height: 29px;
    letter-spacing: -0.44px;
    color: #525252;
  }

  .about-timeline__description p {
    margin: 0;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 749px) {
    .about-timeline__media {
      aspect-ratio: 358 / 200;
    }

    .about-timeline__content-slide {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }

    .about-timeline__year-large {
      font-size: 48px;
      line-height: 48px;
    }

    .about-timeline__heading {
      font-size: 22px;
      line-height: 28px;
    }

    .about-timeline__description {
      font-size: 15px;
      line-height: 24px;
    }

    .about-timeline__arrow {
      display: none;
    }

    .about-timeline__year-label {
      font-size: 12px;
      line-height: 16px;
    }

    .about-timeline__dot {
      width: 12px;
      height: 12px;
    }

    .about-timeline__dot--active {
      width: 16px;
      height: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-timeline__image-slide,
    .about-timeline__content-slide,
    .about-timeline__track-fill,
    .about-timeline__dot,
    .about-timeline__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About timeline",
  "tag": "section",
  "class": "about-timeline-wrapper section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "timeline-entry",
      "name": "Timeline entry",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "1992"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Founded"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Market America begins its journey.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "About timeline"
    }
  ]
}
{% endschema %}
