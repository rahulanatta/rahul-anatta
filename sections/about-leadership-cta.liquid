{% liquid
  assign section_width = section.settings.section_width
  assign color_scheme = section.settings.color_scheme
  assign background_color = section.settings.background_color
  assign gradient_opacity = section.settings.gradient_opacity
  assign container_border_radius = section.settings.container_border_radius
  assign gradient_opacity_decimal = gradient_opacity | times: 1.0 | divided_by: 100
%}

<div
  class="section section--{{ section_width }} color-{{ color_scheme }} spacing-style about-leadership-cta"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --alc-bg-color: {{ background_color }};
    --alc-radius: {{ container_border_radius }}px;
    --alc-gradient-opacity: {{ gradient_opacity_decimal }};
  "
>
  <div class="about-leadership-cta__container">
    {% if section.settings.background_image != blank %}
      <div class="about-leadership-cta__bg-image">
        {{
          section.settings.background_image
          | image_url: width: section.settings.background_image.width
          | image_tag:
            sizes: '(min-width: 1200px) 1200px, 100vw',
            widths: '375,550,750,1100,1500',
            loading: 'lazy',
            class: 'about-leadership-cta__bg-img',
            alt: ''
        }}
      </div>
    {% endif %}
    <div class="about-leadership-cta__overlay"></div>

    <div class="about-leadership-cta__content">
      {% if section.settings.heading != blank %}
        <{{ section.settings.heading_tag }} class="about-leadership-cta__heading">
          {{ section.settings.heading | escape }}
        </{{ section.settings.heading_tag }}>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_url | default: '#' }}"
          class="about-leadership-cta__button"
        >
          {{ section.settings.button_text | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .about-leadership-cta__container {
    position: relative;
    overflow: hidden;
    border-radius: var(--alc-radius, 20px);
    background-color: var(--alc-bg-color, #E5F0F5);
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-leadership-cta__bg-image {
    position: absolute;
    inset: 0;
  }

  .about-leadership-cta__bg-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-leadership-cta__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 38, 56, calc(0.11 * var(--alc-gradient-opacity, 0.5) / 0.5)) 0%,
      rgba(2, 60, 71, calc(0.07 * var(--alc-gradient-opacity, 0.5) / 0.5)) 100%
    );
    pointer-events: none;
  }

  .about-leadership-cta__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 60px 24px;
    text-align: center;
  }

  .about-leadership-cta__heading {
    font-family: var(--font-heading--family);
    font-size: 36px;
    font-weight: 300;
    line-height: 54px;
    color: #FFFFFF;
    margin: 0;
  }

  .about-leadership-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 32px;
    background-color: #FFFFFF;
    color: #122A37;
    font-family: var(--font-body--family);
    font-size: 15px;
    font-weight: 500;
    line-height: 22px;
    text-decoration: none;
    border-radius: 60px;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .about-leadership-cta__button:hover {
    opacity: 0.85;
  }

  .about-leadership-cta__button:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .about-leadership-cta__container {
      min-height: 220px;
    }

    .about-leadership-cta__content {
      padding: 40px 20px;
      gap: 20px;
    }

    .about-leadership-cta__heading {
      font-size: 24px;
      line-height: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-leadership-cta__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Leadership CTA",
  "tag": "section",
  "class": "about-leadership-cta-wrapper section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Connect with Our Leadership"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#E5F0F5"
    },
    {
      "type": "range",
      "id": "gradient_opacity",
      "label": "Gradient opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "container_border_radius",
      "label": "Container border radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Leadership CTA"
    }
  ]
}
{% endschema %}
