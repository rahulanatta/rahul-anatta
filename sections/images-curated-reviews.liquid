{% liquid
  assign heading_tag = section.settings.heading_tag | default: 'h2'
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style images-curated-reviews"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --icr-margin-block-start: {{ section.settings.margin_block_start }}px;
    --icr-margin-block-end: {{ section.settings.margin_block_end }}px;
    --icr-card-radius: {{ section.settings.card_corner_radius }}px;
    --icr-image-radius: {{ section.settings.image_corner_radius }}px;
  "
>
  {% if section.settings.heading != blank %}
    <{{ heading_tag }} class="images-curated-reviews__heading">
      {{- section.settings.heading | escape -}}
    </{{ heading_tag }}>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <images-curated-reviews class="images-curated-reviews__wrapper">
      <div class="images-curated-reviews__content">
        <div class="images-curated-reviews__track" ref="track">
          {% for block in section.blocks %}
            <div class="images-curated-reviews__slide" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {%- assign img_alt = block.settings.image_alt | default: block.settings.reviewer_name -%}
                {%- assign sizes_val = '(min-width: 750px) 500px, 90vw' -%}
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    widths: '300,400,500,600,800,1000',
                    sizes: sizes_val,
                    loading: 'lazy',
                    class: 'images-curated-reviews__image',
                    alt: img_alt
                }}
              {% endif %}

              <div class="images-curated-reviews__stars">
                {% if block.settings.stars_image != blank %}
                  <img
                    src="{{ block.settings.stars_image | image_url: width: 232 }}"
                    alt="Star rating"
                    width="116"
                    height="20"
                    loading="lazy"
                  >
                {% else %}
                  {% assign star_count = block.settings.star_count | default: 5 %}
                  {% for i in (1..5) %}
                    {% if i <= star_count %}
                      <svg class="images-curated-reviews__star images-curated-reviews__star--filled" width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M10 1.25L12.47 7.025L18.75 7.6125L13.9625 11.725L15.4375 17.8625L10 14.5125L4.5625 17.8625L6.0375 11.725L1.25 7.6125L7.53 7.025L10 1.25Z" fill="currentColor"/>
                      </svg>
                    {% else %}
                      <svg class="images-curated-reviews__star images-curated-reviews__star--empty" width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M10 1.25L12.47 7.025L18.75 7.6125L13.9625 11.725L15.4375 17.8625L10 14.5125L4.5625 17.8625L6.0375 11.725L1.25 7.6125L7.53 7.025L10 1.25Z" stroke="currentColor" stroke-width="1"/>
                      </svg>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              </div>

              {% if block.settings.review_text != blank %}
                <p class="images-curated-reviews__text">{{ block.settings.review_text | escape }}</p>
              {% endif %}

              <div class="images-curated-reviews__reviewer">
                {% if block.settings.reviewer_image != blank %}
                  <img
                    class="images-curated-reviews__reviewer-image"
                    src="{{ block.settings.reviewer_image | image_url: width: 96 }}"
                    alt="{{ block.settings.reviewer_name | escape }}"
                    width="48"
                    height="48"
                    loading="lazy"
                  >
                {% endif %}
                {% if block.settings.reviewer_name != blank %}
                  <span class="images-curated-reviews__reviewer-name">{{ block.settings.reviewer_name | escape }}</span>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        {% if section.blocks.size > 1 %}
          <div class="images-curated-reviews__nav">
            <button
              type="button"
              class="images-curated-reviews__nav-btn images-curated-reviews__nav-btn--prev"
              ref="prevButton"
              aria-label="Previous review"
              on:click="/handlePrev"
              disabled
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <div class="images-curated-reviews__dots">
              {% for block in section.blocks %}
                <span
                  class="images-curated-reviews__dot{% if forloop.first %} images-curated-reviews__dot--active{% endif %}"
                  aria-hidden="true"
                ></span>
              {% endfor %}
            </div>

            <button
              type="button"
              class="images-curated-reviews__nav-btn images-curated-reviews__nav-btn--next"
              ref="nextButton"
              aria-label="Next review"
              on:click="/handleNext"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        {% endif %}
      </div>
    </images-curated-reviews>
  {% endif %}
</div>

<script src="{{ 'images-curated-reviews.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .images-curated-reviews {
    margin-block-start: var(--icr-margin-block-start, 0);
    margin-block-end: var(--icr-margin-block-end, 0);
  }

  .images-curated-reviews__heading {
    margin: 0 0 24px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 500);
    font-size: 32px;
    line-height: 42px;
    letter-spacing: -0.8px;
    color: var(--color-foreground-heading);
    text-align: center;
  }

  .images-curated-reviews__wrapper {
    display: block;
    width: 100%;
    border-radius: var(--icr-card-radius, 16px);
  }

  .images-curated-reviews__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
    padding: 39px 24px 80px 24px;
  }

  .images-curated-reviews__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    width: 100%;
  }

  .images-curated-reviews__track::-webkit-scrollbar {
    display: none;
  }

  .images-curated-reviews__slide {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    min-width: 100%;
    scroll-snap-align: start;
  }

  .images-curated-reviews__image {
    display: block;
    width: 100%;
    max-width: 500px;
    height: auto;
    border-radius: var(--icr-image-radius, 8px);
    object-fit: cover;
  }

  .images-curated-reviews__stars {
    display: flex;
    justify-content: center;
    gap: 2px;
    color: #141414;
  }

  .images-curated-reviews__stars img {
    display: block;
    width: 116px;
    height: 20px;
  }

  .images-curated-reviews__star--empty {
    color: rgb(var(--color-foreground-rgb) / 0.25);
  }

  .images-curated-reviews__text {
    margin: 0;
    max-width: 622px;
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xl);
    font-weight: 500;
    line-height: 31px;
    text-align: center;
    color: #141414;
  }

  .images-curated-reviews__reviewer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .images-curated-reviews__reviewer-image {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .images-curated-reviews__reviewer-name {
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    font-weight: 500;
    line-height: 21px;
    text-align: center;
    color: #141414;
  }

  .images-curated-reviews__nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .images-curated-reviews__nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 50%;
    background: transparent;
    color: #141414;
    cursor: pointer;
    transition: opacity var(--animation-speed) ease;
    border: 1px solid #141414;
  }

  .images-curated-reviews__nav-btn--prev {
    border-color: #828282;
    color: #828282;
  }

  .images-curated-reviews__nav-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .images-curated-reviews__nav-btn:focus-visible {
    outline: 2px solid #141414;
    outline-offset: 2px;
  }

  .images-curated-reviews__dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .images-curated-reviews__dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #c9c9c9;
    transition: background-color var(--animation-speed) ease;
  }

  .images-curated-reviews__dot--active {
    background-color: #000000;
  }

  /* ---- Mobile ---- */

  @media screen and (max-width: 749px) {
    .images-curated-reviews__heading {
      font-size: 24px;
      line-height: 31px;
    }

    .images-curated-reviews__content {
      padding: 24px 16px 40px 16px;
    }

    .images-curated-reviews__text {
      font-size: var(--font-size--lg);
      line-height: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .images-curated-reviews__track {
      scroll-behavior: auto;
    }

    .images-curated-reviews__nav-btn,
    .images-curated-reviews__dot {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Images & Curated Reviews",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_corner_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Margin"
    },
    {
      "type": "range",
      "id": "margin_block_start",
      "label": "Top margin",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_block_end",
      "label": "Bottom margin",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "review-card",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "image_picker",
          "id": "stars_image",
          "label": "Stars image",
          "info": "Optional. Overrides the star rating below."
        },
        {
          "type": "range",
          "id": "star_count",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "This product is amazing! Highly recommended."
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer name",
          "default": "-Customer"
        },
        {
          "type": "image_picker",
          "id": "reviewer_image",
          "label": "Reviewer image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Images & Curated Reviews",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "review-card",
          "settings": {
            "star_count": 5,
            "review_text": "Love the colors. Creamy, moisturizing and the color stays. Especially love the lid. It's magnetic.",
            "reviewer_name": "-Nancy W"
          }
        },
        {
          "type": "review-card",
          "settings": {
            "star_count": 5,
            "review_text": "Great quality and fast shipping. I've been using this for a month and love the results! Highly recommend.",
            "reviewer_name": "-Sarah M"
          }
        },
        {
          "type": "review-card",
          "settings": {
            "star_count": 5,
            "review_text": "Exceeded my expectations. The texture is perfect and it works wonders. Will definitely buy again.",
            "reviewer_name": "-James K"
          }
        }
      ]
    }
  ]
}
{% endschema %}
