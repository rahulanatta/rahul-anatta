{% liquid
  assign heading = section.settings.heading
  assign heading_tag = section.settings.heading_tag
  assign section_width = section.settings.section_width

  case heading_tag
    when 'h1'
      assign category_tag = 'h2'
    when 'h2'
      assign category_tag = 'h3'
    when 'h3'
      assign category_tag = 'h4'
    when 'h4'
      assign category_tag = 'h5'
    when 'h5'
      assign category_tag = 'h6'
    when 'h6'
      assign category_tag = 'h6'
  endcase

  assign category_open = false
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section_width }} color-{{ section.settings.color_scheme }} spacing-style brand-directory-v2"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --bdv2-card-bg: {{ section.settings.card_background_color }};
    --bdv2-card-border: {{ section.settings.card_border_color }};
    --bdv2-card-radius: {{ section.settings.card_border_radius }}px;
    --bdv2-columns-desktop: {{ section.settings.columns_desktop }};
    --bdv2-columns-tablet: {{ section.settings.columns_tablet }};
    --bdv2-columns-mobile: {{ section.settings.columns_mobile }};
    --bdv2-card-gap: {{ section.settings.card_gap }}px;
    --bdv2-row-gap: {{ section.settings.row_gap }}px;
    --bdv2-category-gap: {{ section.settings.category_gap }}px;
  "
>
  {% if heading != blank %}
    <{{ heading_tag }} class="brand-directory-v2__title">
      {{ heading | escape }}
    </{{ heading_tag }}>
  {% endif %}

  <div class="brand-directory-v2__categories">
    {% for block in section.blocks %}
      {% if block.type == 'category-heading' %}
        {% if category_open %}
            </div>
          </div>
        {% endif %}
        <div class="brand-directory-v2__category">
          <{{ category_tag }} class="brand-directory-v2__category-title" {{ block.shopify_attributes }}>
            {{ block.settings.title | escape }}
          </{{ category_tag }}>
          <div class="brand-directory-v2__grid">
        {% assign category_open = true %}

      {% elsif block.type == 'brand-item' %}
        {% liquid
          assign has_svg = false
          assign has_image = false
          if block.settings.logo_svg != blank
            assign has_svg = true
          elsif block.settings.logo_image != blank
            assign has_image = true
          endif
          assign brand_name = block.settings.brand_name | default: 'Brand logo'
        %}

        {% if block.settings.brand_url != blank %}
          <a href="{{ block.settings.brand_url }}" class="brand-directory-v2__card" {{ block.shopify_attributes }}>
        {% else %}
          <div class="brand-directory-v2__card" {{ block.shopify_attributes }}>
        {% endif %}

          {% if has_svg %}
            <img
              src="{{ block.settings.logo_svg | asset_url }}"
              alt="{{ brand_name | escape }}"
              class="brand-directory-v2__logo"
              loading="lazy"
            >
          {% elsif has_image %}
            {{
              block.settings.logo_image
              | image_url: width: block.settings.logo_image.width
              | image_tag:
                widths: '100,200,300,400',
                sizes: '200px',
                loading: 'lazy',
                class: 'brand-directory-v2__logo',
                alt: brand_name
            }}
          {% else %}
            <div class="brand-directory-v2__placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}

        {% if block.settings.brand_url != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}

    {% if category_open %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .brand-directory-v2 {
    display: flex;
    flex-direction: column;
  }

  .brand-directory-v2__title {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 48px;
    line-height: 53px;
    letter-spacing: 0;
    color: var(--color-foreground);
    margin: 0 0 48px 0;
  }

  @media screen and (max-width: 1023px) {
    .brand-directory-v2__title {
      font-size: 32px;
      line-height: 38px;
      margin-bottom: 32px;
    }
  }

  @media screen and (max-width: 599px) {
    .brand-directory-v2__title {
      font-size: 28px;
      line-height: 34px;
      margin-bottom: 24px;
    }
  }

  .brand-directory-v2__categories {
    display: flex;
    flex-direction: column;
    gap: var(--bdv2-category-gap, 48px);
  }

  .brand-directory-v2__category {
    display: flex;
    flex-direction: column;
    gap: var(--bdv2-row-gap, 24px);
  }

  .brand-directory-v2__category-title {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: var(--font-size--2xl);
    line-height: 26px;
    letter-spacing: 0;
    color: var(--color-foreground);
    margin: 0;
  }

  .brand-directory-v2__grid {
    display: grid;
    grid-template-columns: repeat(var(--bdv2-columns-mobile, 2), 1fr);
    column-gap: var(--bdv2-card-gap, 20px);
    row-gap: var(--bdv2-row-gap, 24px);
  }

  @media screen and (min-width: 600px) and (max-width: 1023px) {
    .brand-directory-v2__grid {
      grid-template-columns: repeat(var(--bdv2-columns-tablet, 3), 1fr);
    }
  }

  @media screen and (min-width: 1024px) {
    .brand-directory-v2__grid {
      grid-template-columns: repeat(var(--bdv2-columns-desktop, 6), 1fr);
    }
  }

  .brand-directory-v2__card {
    aspect-ratio: 219 / 185;
    border-radius: var(--bdv2-card-radius, 14px);
    background-color: var(--bdv2-card-bg, #F8F8F8);
    border: 1px solid var(--bdv2-card-border, #000000);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 20px;
    text-decoration: none;
    transition: border-color var(--animation-speed, 0.125s) ease;
  }

  a.brand-directory-v2__card:hover {
    border-color: var(--color-foreground);
    opacity: 0.85;
  }

  a.brand-directory-v2__card:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .brand-directory-v2__logo {
    display: block;
    max-width: 80%;
    max-height: 60%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .brand-directory-v2__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    color: var(--color-foreground);
    opacity: 0.2;
  }

  .brand-directory-v2__placeholder svg {
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-directory-v2__card {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand directory",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Brands"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "Card options"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#F8F8F8"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns (tablet)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "category_gap",
      "label": "Category gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "category-heading",
      "name": "Category heading",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "Category"
        }
      ]
    },
    {
      "type": "brand-item",
      "name": "Brand item",
      "settings": [
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand name",
          "default": "Brand"
        },
        {
          "type": "text",
          "id": "logo_svg",
          "label": "SVG filename",
          "info": "Filename in assets/ (e.g. brand-logo.svg)"
        },
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "brand_url",
          "label": "Brand link"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Brand directory"
    }
  ]
}
{% endschema %}
