{% liquid
  assign section_width = section.settings.section_width
  assign color_scheme = section.settings.color_scheme
  assign text_color = section.settings.text_color
  assign font_size_desktop = section.settings.font_size_desktop
  assign font_size_mobile = section.settings.font_size_mobile
  assign font_weight = section.settings.font_weight
  assign letter_spacing = section.settings.letter_spacing
%}

<div
  class="section section--{{ section_width }} color-{{ color_scheme }} spacing-style about-bottom-text"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --abt-color: {{ text_color }};
    --abt-font-size: {{ font_size_desktop }}px;
    --abt-font-size-mobile: {{ font_size_mobile }}px;
    --abt-font-weight: {{ font_weight }};
    --abt-letter-spacing: {{ letter_spacing }}px;
  "
>
  {% if section.settings.heading != blank %}
    <{{ section.settings.heading_tag }} class="about-bottom-text__heading">
      {{- section.settings.heading | escape | newline_to_br -}}
    </{{ section.settings.heading_tag }}>
  {% endif %}
</div>

{% stylesheet %}
  .about-bottom-text__heading {
    font-family: var(--font-heading--family);
    font-size: var(--abt-font-size, 62px);
    font-weight: var(--abt-font-weight, 300);
    line-height: 1.2;
    letter-spacing: var(--abt-letter-spacing, 1px);
    color: var(--abt-color, #56AFD9);
    text-align: center;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .about-bottom-text__heading {
      font-size: var(--abt-font-size-mobile, 28px);
      line-height: 36px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bottom text",
  "tag": "section",
  "class": "about-bottom-text-wrapper section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built on Product Powered by People"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#56AFD9"
    },
    {
      "type": "number",
      "id": "font_size_desktop",
      "label": "Font size (desktop)",
      "default": 62
    },
    {
      "type": "number",
      "id": "font_size_mobile",
      "label": "Font size (mobile)",
      "default": 28
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "200", "label": "200 (Thin)" },
        { "value": "300", "label": "300 (Light)" },
        { "value": "400", "label": "400 (Regular)" }
      ],
      "default": "300"
    },
    {
      "type": "number",
      "id": "letter_spacing",
      "label": "Letter spacing (px)",
      "default": 1
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Bottom text"
    }
  ]
}
{% endschema %}
