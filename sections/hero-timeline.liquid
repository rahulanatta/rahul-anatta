{% liquid
  assign image_blocks = section.blocks | where: 'type', 'image-slide'
  assign timeline_blocks = section.blocks | where: 'type', 'timeline-phase'
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style hero-timeline"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --ht-desktop-gap: {{ section.settings.desktop_gap }}px;
    --ht-content-gap: {{ section.settings.content_gap }}px;
    --ht-image-radius: {{ section.settings.image_border_radius }}px;
    --ht-badge-bg: {{ section.settings.badge_background }};
  "
>
  <div class="hero-timeline__layout">

    {%- comment -%} Image Carousel {%- endcomment -%}
    <hero-timeline-carousel class="hero-timeline__carousel">
      <div class="hero-timeline__track" data-carousel-track>
        {% for block in image_blocks %}
          <div class="hero-timeline__slide" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {%- assign sizes_val = '(min-width: 750px) 40vw, 80vw' -%}
              {{
                block.settings.image
                | image_url: width: block.settings.image.width
                | image_tag:
                  sizes: sizes_val,
                  widths: '375,550,750,1100,1500',
                  loading: 'lazy',
                  class: 'hero-timeline__image',
                  alt: block.settings.image.alt
              }}
            {% else %}
              <div class="hero-timeline__placeholder">
                {{ 'image' | placeholder_svg_tag: 'hero-timeline__placeholder-svg' }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      {% if section.settings.show_arrows and image_blocks.size > 1 %}
        <div class="hero-timeline__arrows">
          <button
            type="button"
            class="hero-timeline__arrow hero-timeline__arrow--prev"
            data-carousel-prev
            aria-label="Previous slide"
            disabled
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="hero-timeline__arrow hero-timeline__arrow--next"
            data-carousel-next
            aria-label="Next slide"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </hero-timeline-carousel>

    {%- comment -%} Content: Heading + Timeline {%- endcomment -%}
    <div class="hero-timeline__content">
      {% if section.settings.heading != blank %}
        <{{ section.settings.heading_tag }} class="hero-timeline__heading">
          {{- section.settings.heading | escape -}}
        </{{ section.settings.heading_tag }}>
      {% endif %}

      {% if timeline_blocks.size > 0 %}
        <div class="hero-timeline__timeline">
          {% for block in timeline_blocks %}
            <div
              class="hero-timeline__phase{% if forloop.last %} hero-timeline__phase--last{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="hero-timeline__phase-marker">
                <span class="hero-timeline__dot"></span>
              </div>
              <div class="hero-timeline__phase-body">
                <div class="hero-timeline__phase-header">
                  {% if block.settings.badge_text != blank %}
                    <span class="hero-timeline__badge">
                      {{- block.settings.badge_text | escape -}}
                    </span>
                  {% endif %}
                  {% if block.settings.phase_title != blank %}
                    <span class="hero-timeline__phase-title">
                      {{- block.settings.phase_title | escape -}}
                    </span>
                  {% endif %}
                </div>
                {% if block.settings.description != blank %}
                  <div class="hero-timeline__phase-description rte">
                    {{ block.settings.description }}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

  </div>
</div>

<script src="{{ 'hero-timeline-carousel.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  /* ============================================================
     Hero with Timeline Section
     ============================================================ */

  .hero-timeline__layout {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* ---- Carousel ---- */

  .hero-timeline__carousel {
    position: relative;
    flex-shrink: 0;
  }

  .hero-timeline__track {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .hero-timeline__track::-webkit-scrollbar {
    display: none;
  }

  .hero-timeline__slide {
    flex: 0 0 auto;
    scroll-snap-align: start;
    overflow: hidden;
    border-radius: var(--ht-image-radius, 30px);
    min-width: 65vw;
    height: 400px;
  }

  .hero-timeline__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-timeline__placeholder {
    width: 100%;
    height: 100%;
    min-height: 300px;
    background-color: rgb(0 0 0 / 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-timeline__placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  /* Arrows */

  .hero-timeline__arrows {
    display: flex;
    gap: 8px;
    margin-top: 16px;
    justify-content: center;
  }

  .hero-timeline__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--color-border, rgb(0 0 0 / 0.1));
    background: var(--color-background, #fff);
    color: var(--color-foreground, #141414);
    cursor: pointer;
    transition: opacity 0.15s ease;
    padding: 0;
  }

  .hero-timeline__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .hero-timeline__arrow:not(:disabled):hover {
    border-color: var(--color-foreground, #141414);
  }

  .hero-timeline__arrow:focus-visible {
    outline: 2px solid var(--color-foreground, #141414);
    outline-offset: 2px;
  }

  /* ---- Content ---- */

  .hero-timeline__content {
    display: flex;
    flex-direction: column;
    gap: var(--ht-content-gap, 40px);
  }

  .hero-timeline__heading {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.3;
    color: var(--color-foreground, #141414);
  }

  /* ---- Timeline ---- */

  .hero-timeline__timeline {
    display: flex;
    flex-direction: column;
    gap: 32px;
    overflow: visible;
  }

  .hero-timeline__phase {
    display: grid;
    grid-template-columns: 17px 1fr;
    column-gap: 16px;
  }

  .hero-timeline__phase-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .hero-timeline__dot {
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background-color: var(--color-foreground, #141414);
    flex-shrink: 0;
    margin-top: 6px;
    position: relative;
    z-index: 1;
  }

  /* Connecting line between dots */
  .hero-timeline__phase:not(.hero-timeline__phase--last) .hero-timeline__phase-marker::after {
    content: '';
    position: absolute;
    top: 23px;
    bottom: -38px;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background-color: var(--color-foreground, #141414);
  }

  .hero-timeline__phase-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hero-timeline__phase-header {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .hero-timeline__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 16px;
    border-radius: 32px;
    background-color: var(--ht-badge-bg, #81AE9A);
    color: #fff;
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.3125;
    white-space: nowrap;
  }

  .hero-timeline__phase-title {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--color-foreground, #141414);
  }

  .hero-timeline__phase-description {
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-foreground, #141414);
  }

  .hero-timeline__phase-description ul {
    margin: 0;
    padding-inline-start: 1.2em;
    list-style-type: disc;
  }

  .hero-timeline__phase-description li {
    margin-bottom: 8px;
  }

  .hero-timeline__phase-description li:last-child {
    margin-bottom: 0;
  }

  /* ---- Desktop layout ---- */

  @media screen and (min-width: 750px) {
    .hero-timeline__layout {
      flex-direction: row;
      align-items: center;
      gap: var(--ht-desktop-gap, 80px);
    }

    .hero-timeline__carousel {
      flex: 1 1 55%;
      min-width: 0;
    }

    .hero-timeline__slide {
      min-width: unset;
      height: 546px;
    }

    .hero-timeline__image {
      width: auto;
      height: 100%;
    }

    .hero-timeline__content {
      flex: 1 1 45%;
      min-width: 0;
    }

    .hero-timeline__heading {
      font-size: 2rem;
      line-height: 42px;
    }
  }

  /* ---- Mobile adjustments ---- */

  @media screen and (max-width: 749px) {
    .hero-timeline__heading {
      font-size: 1.5rem;
      line-height: 1.3;
    }

    .hero-timeline__badge {
      font-size: 0.875rem;
      padding: 3px 12px;
    }

    .hero-timeline__phase-title {
      font-size: 1.125rem;
    }

    .hero-timeline__phase-description {
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-timeline__track {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero with timeline",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "30 Day Jump Start Kit"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#81AE9A"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
