{% liquid
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign timeline_blocks = section.blocks | where: 'type', 'timeline-step'
  assign heading_tag = section.settings.timeline_heading_tag | default: 'h2'
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %} --hero-timeline-aspect-ratio: {{ section.settings.image_aspect_ratio }};"
>
  {% comment %} Image Carousel {% endcomment %}
  {% if slide_blocks.size > 0 %}
    <hero-timeline-carousel
      class="hero-timeline__carousel"
      data-autoplay="{{ section.settings.autoplay }}"
      data-autoplay-speed="{{ section.settings.autoplay_speed }}"
    >
      <div class="hero-timeline__viewport">
        <div class="hero-timeline__track" ref="track">
          {% for block in slide_blocks %}
            <div
              class="hero-timeline__slide"
              ref="slides[]"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.image != blank %}
                {% liquid
                  assign sizes_val = '(min-width: 1200px) 1200px, 100vw'
                %}
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    sizes: sizes_val,
                    widths: '375,550,750,1100,1500,1780,2000',
                    loading: 'lazy',
                    class: 'hero-timeline__image',
                    alt: block.settings.image.alt
                }}
              {% else %}
                <div class="hero-timeline__placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if block.settings.overlay_heading != blank or block.settings.overlay_subheading != blank %}
                <div class="hero-timeline__overlay">
                  {% if block.settings.overlay_heading != blank %}
                    <p class="hero-timeline__overlay-heading">{{ block.settings.overlay_heading }}</p>
                  {% endif %}
                  {% if block.settings.overlay_subheading != blank %}
                    <p class="hero-timeline__overlay-subheading">{{ block.settings.overlay_subheading }}</p>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        {% if section.settings.show_arrows and slide_blocks.size > 1 %}
          <button
            type="button"
            class="hero-timeline__arrow hero-timeline__arrow--prev"
            ref="prevButton"
            aria-label="Previous slide"
            on:click="/handlePrev"
            disabled
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="hero-timeline__arrow hero-timeline__arrow--next"
            ref="nextButton"
            aria-label="Next slide"
            on:click="/handleNext"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {% endif %}
      </div>

      {% if slide_blocks.size > 1 %}
        <div class="hero-timeline__dots">
          {% for block in slide_blocks %}
            <button
              type="button"
              class="hero-timeline__dot{% if forloop.first %} hero-timeline__dot--active{% endif %}"
              ref="dots[]"
              data-index="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              on:click="/handleDotClick"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    </hero-timeline-carousel>
  {% endif %}

  {% comment %} Timeline {% endcomment %}
  {% if timeline_blocks.size > 0 %}
    <div class="hero-timeline__timeline">
      {% if section.settings.timeline_heading != blank %}
        <{{ heading_tag }} class="hero-timeline__timeline-heading">
          {{ section.settings.timeline_heading }}
        </{{ heading_tag }}>
      {% endif %}

      <div class="hero-timeline__steps">
        {% for block in timeline_blocks %}
          <div
            class="hero-timeline__step"
            {{ block.shopify_attributes }}
          >
            <div class="hero-timeline__step-indicator">
              {% if block.settings.icon != blank %}
                <div class="hero-timeline__step-icon">
                  {{
                    block.settings.icon
                    | image_url: width: 48
                    | image_tag:
                      widths: '24,48',
                      sizes: '24px',
                      loading: 'lazy',
                      alt: block.settings.title
                  }}
                </div>
              {% else %}
                <span class="hero-timeline__step-number">{{ forloop.index }}</span>
              {% endif %}
            </div>
            <div class="hero-timeline__step-content">
              {% if block.settings.title != blank %}
                <h3 class="hero-timeline__step-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="hero-timeline__step-description">{{ block.settings.description }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

<script src="{{ 'hero-timeline.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  /* Carousel */
  .hero-timeline__carousel {
    display: block;
    width: 100%;
  }

  .hero-timeline__viewport {
    position: relative;
    overflow: hidden;
    border-radius: var(--style-border-radius-sm, 8px);
  }

  .hero-timeline__track {
    display: flex;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  .hero-timeline__slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
  }

  .hero-timeline__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: var(--hero-timeline-aspect-ratio, 16 / 9);
  }

  .hero-timeline__placeholder {
    width: 100%;
    aspect-ratio: var(--hero-timeline-aspect-ratio, 16 / 9);
    background-color: rgb(var(--color-background));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;

    & svg {
      width: 100%;
      height: 100%;
    }
  }

  /* Overlay text */
  .hero-timeline__overlay {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    inset-inline-end: 0;
    padding: 24px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 100%);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero-timeline__overlay-heading {
    font-family: var(--font-heading--family);
    font-size: var(--font-size--2xl);
    font-weight: 600;
    line-height: 1.2;
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--4xl);
    }
  }

  .hero-timeline__overlay-subheading {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    font-weight: 400;
    line-height: 1.5;
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--md);
    }
  }

  /* Arrows */
  .hero-timeline__arrow {
    position: absolute;
    inset-block-start: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.85);
    color: #000000;
    cursor: pointer;
    transition: opacity 0.15s ease, background-color 0.15s ease;
    z-index: 2;
  }

  .hero-timeline__arrow--prev {
    inset-inline-start: 12px;
  }

  .hero-timeline__arrow--next {
    inset-inline-end: 12px;
  }

  .hero-timeline__arrow:hover {
    background: rgba(255, 255, 255, 1);
  }

  .hero-timeline__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .hero-timeline__arrow:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  /* Dots */
  .hero-timeline__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding-block-start: 16px;
  }

  .hero-timeline__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-foreground) / 0.3);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s ease;
  }

  .hero-timeline__dot--active {
    background: rgb(var(--color-foreground));
    border-color: rgb(var(--color-foreground));
  }

  .hero-timeline__dot:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }

  /* Timeline */
  .hero-timeline__timeline {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block-start: 48px;
  }

  .hero-timeline__timeline-heading {
    font-family: var(--font-heading--family);
    font-size: var(--font-size--2xl);
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    color: rgb(var(--color-foreground));
    text-align: center;

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--4xl);
    }
  }

  .hero-timeline__steps {
    display: flex;
    flex-direction: column;
    gap: 24px;

    @media screen and (min-width: 750px) {
      flex-direction: row;
      gap: 0;
    }
  }

  .hero-timeline__step {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 16px;
    flex: 1;
    position: relative;

    @media screen and (min-width: 750px) {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 20px;
    }
  }

  /* Connector line between steps (desktop) */
  @media screen and (min-width: 750px) {
    .hero-timeline__step:not(:last-child)::after {
      content: '';
      position: absolute;
      inset-block-start: 20px;
      inset-inline-start: calc(50% + 24px);
      width: calc(100% - 48px);
      height: 2px;
      background-color: rgb(var(--color-foreground) / 0.2);
    }
  }

  /* Connector line between steps (mobile) */
  @media screen and (max-width: 749px) {
    .hero-timeline__step:not(:last-child)::after {
      content: '';
      position: absolute;
      inset-inline-start: 19px;
      inset-block-start: 44px;
      width: 2px;
      height: calc(100% - 20px);
      background-color: rgb(var(--color-foreground) / 0.2);
    }
  }

  .hero-timeline__step-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: 50%;
    border: 2px solid rgb(var(--color-foreground));
    background: rgb(var(--color-background));
    position: relative;
    z-index: 1;
  }

  .hero-timeline__step-number {
    font-family: var(--font-heading--family);
    font-size: var(--font-size--md);
    font-weight: 600;
    line-height: 1;
    color: rgb(var(--color-foreground));
  }

  .hero-timeline__step-icon {
    width: 24px;
    height: 24px;

    & img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
  }

  .hero-timeline__step-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero-timeline__step-title {
    font-family: var(--font-heading--family);
    font-size: var(--font-size--md);
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    color: rgb(var(--color-foreground));

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--lg);
    }
  }

  .hero-timeline__step-description {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    font-weight: 400;
    line-height: 1.5;
    margin: 0;
    color: rgb(var(--color-foreground) / 0.75);

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-timeline__track {
      transition: none;
    }

    .hero-timeline__arrow,
    .hero-timeline__dot {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero with timeline",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "timeline_heading",
      "label": "Timeline heading",
      "default": "How It Works"
    },
    {
      "type": "select",
      "id": "timeline_heading_tag",
      "label": "Timeline heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "16/9", "label": "16:9" },
        { "value": "4/3", "label": "4:3" },
        { "value": "3/2", "label": "3:2" },
        { "value": "21/9", "label": "21:9" },
        { "value": "1/1", "label": "1:1" }
      ],
      "default": "16/9"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "overlay_heading",
          "label": "Overlay heading"
        },
        {
          "type": "text",
          "id": "overlay_subheading",
          "label": "Overlay subheading"
        }
      ]
    },
    {
      "type": "timeline-step",
      "name": "Timeline step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Describe this step of the process."
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero with timeline",
      "category": "custom",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "overlay_heading": "Welcome",
            "overlay_subheading": "Discover the difference"
          }
        },
        {
          "type": "slide",
          "settings": {
            "overlay_heading": "Quality Ingredients",
            "overlay_subheading": "Backed by science"
          }
        },
        {
          "type": "slide",
          "settings": {
            "overlay_heading": "Real Results",
            "overlay_subheading": "See the transformation"
          }
        },
        {
          "type": "timeline-step",
          "settings": {
            "title": "Choose Your Product",
            "description": "Browse our range and find the perfect fit for your needs."
          }
        },
        {
          "type": "timeline-step",
          "settings": {
            "title": "Follow the Routine",
            "description": "Use as directed for best results. Consistency is key."
          }
        },
        {
          "type": "timeline-step",
          "settings": {
            "title": "See the Results",
            "description": "Experience visible improvements backed by clinical research."
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
