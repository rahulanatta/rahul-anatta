{% doc %}
  Ingredient Drawer

  Renders a right-side dialog drawer for displaying ingredient details
  from the Ingredient metaobject (title, description, image). The drawer
  shell provides header + scrollable body; JS clones per-ingredient
  <template> content into the body on open.

  @example
    {% render 'ingredient-drawer' %}
{% enddoc %}

<dialog
  ref="dialog"
  class="dialog-modal dialog-drawer ingredient-drawer__dialog"
  aria-label="Ingredient details"
>
  <div class="ingredient-drawer__header">
    <span class="ingredient-drawer__title" ref="drawerTitle">Ingredient</span>
    <button
      type="button"
      class="ingredient-drawer__close"
      on:click="ingredient-drawer-component/closeDialog"
      aria-label="Close"
    >
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2L2 12" stroke="#141414" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M12 12L2 2" stroke="#141414" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
  <div class="ingredient-drawer__body">
    <div ref="drawerContent"></div>
  </div>
</dialog>
